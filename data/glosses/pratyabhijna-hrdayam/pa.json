    ],
    "1.16": [
      {"word_idx": 0, "gloss_text": "ਚਿਦਾਨੰਦ (ਚੇਤਨਾ ਦੇ ਆਨੰਦ) ਦੀ ਪ੍ਰਾਪਤੀ ਹੋਣ 'ਤੇ"},
      {"word_idx": 1, "gloss_text": "ਦੇਹ ਆਦਿ ਵਿਸ਼ਿਆਂ ਵਿੱਚ"},
