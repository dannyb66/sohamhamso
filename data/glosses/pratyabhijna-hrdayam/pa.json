      {"word_idx": 3, "gloss_text": "ਸਥਿਤੀਆਂ, ਸਿੱਧਾਂਤ"}
    ],
    "1.9": [
      {"word_idx": 0, "gloss_text": "ਚਿਤ-ਸਰੂਪ ਹੁੰਦਿਆਂ ਹੋਇਆਂ ਵੀ"},
