      {"word_idx": 4, "gloss_text": "ਤਿੰਨ-ਮਯ (ਆਣਵ/ਸ਼ਾਕਤ/ਸ਼ਾਂਭਵ ਜਾਂ ਤਿੰਨ ਮਲਾਂ ਵਾਲਾ)"},
      {"word_idx": 5, "gloss_text": "ਚਾਰ-ਆਤਮਾ (ਚੇਤਨਾ ਦੀਆਂ ਚਾਰ ਅਵਸਥਾਵਾਂ ਵਾਲਾ)"},
      {"word_idx": 6, "gloss_text": "ਸੱਤ ਪੰਜਕ"},
      {"word_idx": 7, "gloss_text": "ਜਿਸਦਾ ਆਪਣਾ ਸੁਭਾਅ ਹੈ"}
