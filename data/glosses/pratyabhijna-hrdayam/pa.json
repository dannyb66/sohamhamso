      {"word_idx": 3, "gloss_text": "ਸੰਸਾਰਿਤਵ ਹੈ — ਆਵਾਗਮਨ-ਬੱਧ ਜੀਵਨ"}
    ],
    "1.13": [
      {"word_idx": 0, "gloss_text": "ਉਸ (ਸੱਚੇ ਸਰੂਪ) ਦਾ ਪੂਰਨ ਪਰਿਜਨਾਨ ਹੋਣ 'ਤੇ"},
      {"word_idx": 1, "gloss_text": "(ਸੀਮਿਤ) ਚਿੱਤ"},
