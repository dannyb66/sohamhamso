      {"word_idx": 4, "gloss_text": "ਚੇਤਨ-ਪਦ ਉੱਤੇ ਆਰੋਹਣ ਕਾਰਨ — (ਮੁਕਤ) ਅਨੁਭਵੀ ਦੇ ਪੱਧਰ ਤੱਕ ਚੜ੍ਹਨ ਨਾਲ"},
      {"word_idx": 5, "gloss_text": "ਚਿਤਿ (ਸਰਬ-ਵਿਆਪੀ ਚੇਤਨਾ) ਬਣ ਜਾਂਦਾ ਹੈ"}
    ],
    "1.14": [
      {"word_idx": 0, "gloss_text": "ਚਿਤਿ-ਰੂਪੀ ਅੱਗ"},
      {"word_idx": 1, "gloss_text": "ਅਵਰੋਹ-ਪਦ ਵਿੱਚ (= ਬੱਧ ਅਵਸਥਾ ਵਿੱਚ)"},
