    ],
    "1.19": [
      {"word_idx": 0, "gloss_text": "ਸਮਾਧੀ ਦੇ ਸੰਸਕਾਰ ਨਾਲ ਯੁਕਤ — ਸਮਾਧੀ ਦੀ ਛਾਪ ਅਜੇ ਵੀ ਧਾਰਨ ਕਰਨ ਵਾਲੀ ਅਵਸਥਾ"},
      {"word_idx": 1, "gloss_text": "ਵਿਉਥਾਨ ਵਿੱਚ — ਬਾਹਰੀ ਕਿਰਿਆ ਵਿੱਚ ਪਰਤਣ ਸਮੇਂ"},
      {"word_idx": 2, "gloss_text": "ਵਾਰ-ਵਾਰ"},
      {"word_idx": 3, "gloss_text": "ਚਿਤ ਨਾਲ ਏਕਤਾ ਦੇ ਆਮਰਸ਼ਨ (ਅੰਤਰ-ਚਿੰਤਨ/ਪਰਾਮਰਸ਼) ਦੁਆਰਾ"},
      {"word_idx": 4, "gloss_text": "ਨਿਤ੍ਯ-ਉਦਿਤ ਸਮਾਧੀ (ਸਦਾ ਚੜ੍ਹੀ ਰਹਿਣ ਵਾਲੀ ਸਮਾਧੀ) ਦੀ ਪ੍ਰਾਪਤੀ ਹੁੰਦੀ ਹੈ"}
    ],
    "1.20": [
      {"word_idx": 0, "gloss_text": "ਉਦੋਂ, ਤਦ"},
      {"word_idx": 1, "gloss_text": "ਜਿਸਦਾ ਸਾਰ ਪ੍ਰਕਾਸ਼ ਅਤੇ ਆਨੰਦ ਹੈ"},
      {"word_idx": 2, "gloss_text": "ਮਹਾ-ਮੰਤਰ (ਅਹਮ੍) ਦੇ ਵੀਰਯ ਨਾਲ ਬਣਿਆ"},
      {"word_idx": 3, "gloss_text": "ਪੂਰਨ 'ਅਹੰਤਾ' (ਮੈਂ-ਪਣ) ਵਿੱਚ ਆਵੇਸ਼ ਦੁਆਰਾ"},
      {"word_idx": 4, "gloss_text": "ਸਦਾ ਸਾਰੀ ਸ੍ਰਿਸ਼ਟੀ ਅਤੇ ਸੰਹਾਰ ਕਰਨ ਵਾਲੇ"},
      {"word_idx": 5, "gloss_text": "ਆਪਣੇ ਹੀ ਸੰਵਿਦ੍-ਦੇਵਤਾ-ਚੱਕਰ (ਚੇਤਨਾ ਦੇ ਦੇਵਤਿਆਂ ਦੇ ਚੱਕਰ) ਦੀ ਈਸ਼ਵਰਤਾ ਦੀ ਪ੍ਰਾਪਤੀ"},
      {"word_idx": 6, "gloss_text": "ਹੁੰਦੀ ਹੈ"},
      {"word_idx": 7, "gloss_text": "ਇਤਿ ਸ਼ਿਵਮ੍ — ਇਸ ਤਰ੍ਹਾਂ ਸਰਬੱਤ ਮੰਗਲ"}
    ]
  }
}
