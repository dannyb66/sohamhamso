{
  "text_slug": "pratyabhijna-hrdayam",
  "lang": "ta",
  "translator": "sohamhamso (claude-opus-4-7)",
  "license": "CC-BY-SA",
  "ai_assisted": true,
  "status": "published",
  "verses": {
    "1.1": [
      {
        "word_idx": 0,
        "gloss_text": "சித், பேரறிவு, தனிமுதல் சைதன்யம்"
      },
      {
        "word_idx": 1,
        "gloss_text": "சுயாதீனமான, சுதந்திரமான, தன்னிச்சையான"
      },
      {
        "word_idx": 2,
        "gloss_text": "பிரபஞ்சம், அனைத்தும்"
      },
      {
        "word_idx": 3,
        "gloss_text": "சித்தி, வெளிப்பாடு, நிலைநிறுத்துதல்"
      },
      {
        "word_idx": 4,
        "gloss_text": "காரணம்"
      }
    ],
    "1.2": [
      {
        "word_idx": 0,
        "gloss_text": "தனது சுய இச்சையினால்"
      },
      {
        "word_idx": 1,
        "gloss_text": "தனது சுய திரையின் மீது (சுயத்தின் சுவரில்)"
      },
      {
        "word_idx": 2,
        "gloss_text": "பிரபஞ்சத்தை"
      },
      {
        "word_idx": 3,
        "gloss_text": "விரித்து வெளிப்படுத்துகிறாள் (திறந்து விரிக்கிறாள்)"
      }
    ],
    "1.3": [
      {
        "word_idx": 0,
        "gloss_text": "அது (பிரபஞ்சம்)"
      },
      {
        "word_idx": 1,
        "gloss_text": "பலவகை, பல்வேறானது"
      },
      {
        "word_idx": 2,
        "gloss_text": "ஒத்த, இணையான"
      },
      {
        "word_idx": 3,
        "gloss_text": "க்ராஹ்யம், அறியப்படுபொருள் (விஷயம்)"
      },
      {
        "word_idx": 4,
        "gloss_text": "க்ராஹகன், அறிபவன் (கர்த்தா)"
      },
      {
        "word_idx": 5,
        "gloss_text": "பேதத்தினால், வேறுபாட்டினால்"
      }
    ],
    "1.4": [
      {
        "word_idx": 0,
        "gloss_text": "சித்தின் சங்கோசத்தை (சுருக்கத்தை) இயல்பாகக் கொண்டவன்"
      },
      {
        "word_idx": 1,
        "gloss_text": "சேதனன், அனுபவிப்போன், ஜீவன்"
      },
      {
        "word_idx": 2,
        "gloss_text": "ஆனாலும், கூட"
      },
      {
        "word_idx": 3,
        "gloss_text": "சுருங்கிய, குறுகிய"
      },
      {
        "word_idx": 4,
        "gloss_text": "பிரபஞ்சத்தை உள்ளடக்கியவன், பிரபஞ்ச மயமானவன்"
      }
    ],
    "1.5": [
      {
        "word_idx": 0,
        "gloss_text": "சித்தே, பேரறிவே"
      },
      {
        "word_idx": 1,
        "gloss_text": "தானே, மட்டுமே (வலியுறுத்தும் இடைச்சொல்)"
      },
      {
        "word_idx": 2,
        "gloss_text": "சேதன நிலையிலிருந்து (சுதந்திர அனுபவிப்போனின் நிலையிலிருந்து)"
      },
      {
        "word_idx": 3,
        "gloss_text": "இறங்கியதாய், கீழ்ப்பட்டதாய்"
      },
      {
        "word_idx": 4,
        "gloss_text": "அறியப்படுபொருளால் சுருக்கம் பெறுவதாய்"
      },
      {
        "word_idx": 5,
        "gloss_text": "சித்தம் (மனம்) ஆகின்றது"
      }
    ],
    "1.6": [
      {
        "word_idx": 0,
        "gloss_text": "அதனால் (சித்தத்தால்) ஆனவன்"
      },
      {
        "word_idx": 1,
        "gloss_text": "மாயையால் கட்டுண்ட அனுபவிப்போன் (மாயாப்ரமாதா)"
      }
    ],
    "1.7": [
      {
        "word_idx": 0,
        "gloss_text": "அவன்"
      },
      {
        "word_idx": 1,
        "gloss_text": "மேலும்"
      },
      {
        "word_idx": 2,
        "gloss_text": "ஒருவன் (தத்துவத்தில்)"
      },
      {
        "word_idx": 3,
        "gloss_text": "இரு வடிவம் கொண்டவன் (சிவ-சக்தி)"
      },
      {
        "word_idx": 4,
        "gloss_text": "மூன்றாக இயன்றவன் (ஆணவ/சாக்த/சாம்பவ அல்லது மூன்று மலங்கள்)"
      },
      {
        "word_idx": 5,
        "gloss_text": "நான்கு ஆத்மா உடையவன் (உணர்வின் நான்கு நிலைகள்)"
      },
      {
        "word_idx": 6,
        "gloss_text": "ஏழு பஞ்சகங்கள்"
      },
      {
        "word_idx": 7,
        "gloss_text": "சுய இயல்பு கொண்டவன்"
      }
    ],
    "1.8": [
      {
        "word_idx": 0,
        "gloss_text": "அதன் (ஒரே சித்தின்) பாத்திரங்கள், நிலைகள்"
      },
      {
        "word_idx": 1,
        "gloss_text": "அனைத்து"
      },
      {
        "word_idx": 2,
        "gloss_text": "தர்சனம், தத்துவக் கொள்கை"
      },
      {
        "word_idx": 3,
        "gloss_text": "நிலைப்பாடுகள், ஸ்திதிகள்"
      }
    ],
    "1.9": [
      {
        "word_idx": 0,
        "gloss_text": "சித்தின் தன்மையுள்ளவனாக இருந்தாலும்"
      },
      {
        "word_idx": 1,
        "gloss_text": "தனது சக்திகளின் சங்கோசத்தினால் (சுருக்கத்தினால்)"
      },
      {
        "word_idx": 2,
        "gloss_text": "மலங்களால் மூடப்பட்டவன்"
      },
      {
        "word_idx": 3,
        "gloss_text": "சம்சாரி, பிறவித் தளையில் உழல்பவன் ஆகின்றான்"
      }
    ],
    "1.10": [
      {
        "word_idx": 0,
        "gloss_text": "அவ்வாறிருந்தும்"
      },
      {
        "word_idx": 1,
        "gloss_text": "அவனை (சிவனை)ப் போலவே"
      },
      {
        "word_idx": 2,
        "gloss_text": "ஐந்து செயல்கள் (சிருஷ்டி, ஸ்திதி, ஸம்ஹாரம், திரோதானம், அனுக்ரஹம்)"
      },
      {
        "word_idx": 3,
        "gloss_text": "செய்கிறான்"
      }
    ],
    "1.11": [
      {
        "word_idx": 0,
        "gloss_text": "ஆபாசனம், வெளிப்படுத்துதல் (= சிருஷ்டி, தோற்றுவித்தல்)"
      },
      {
        "word_idx": 1,
        "gloss_text": "ரக்தி, ருசித்தல் (= ஸ்திதி, நிலைநிறுத்தல்)"
      },
      {
        "word_idx": 2,
        "gloss_text": "விமர்சனம், எண்ணிப் பற்றுதல் (= ஸம்ஹாரம், திரும்ப எடுத்தல்)"
      },
      {
        "word_idx": 3,
        "gloss_text": "விதையாய் நிலைநிறுத்துதல் (= திரோதானம், மறைத்தல்)"
      },
      {
        "word_idx": 4,
        "gloss_text": "கரைத்தல் (= அனுக்ரஹம், அருள்) — இவற்றினால்"
      },
      {
        "word_idx": 5,
        "gloss_text": "அந்த ஐந்து செயல்கள் (நிறைவேற்றப்படுகின்றன)"
      }
    ],
    "1.12": [
      {
        "word_idx": 0,
        "gloss_text": "அதை (உண்மை இயல்பை) அறியாத நிலையில்"
      },
      {
        "word_idx": 1,
        "gloss_text": "தனது சொந்த சக்திகளால்"
      },
      {
        "word_idx": 2,
        "gloss_text": "முற்றிலும் மயக்கப்பட்ட நிலை"
      },
      {
        "word_idx": 3,
        "gloss_text": "சம்சாரித்தன்மை, பிறவி-மீளி வாழ்க்கை"
      }
    ],
    "1.13": [
      {
        "word_idx": 0,
        "gloss_text": "அதை முழுமையாக அறியும்போது"
      },
      {
        "word_idx": 1,
        "gloss_text": "(வரம்புள்ள) சித்தமே, மனமே"
      },
      {
        "word_idx": 2,
        "gloss_text": "தானே (வலியுறுத்தும் இடைச்சொல்)"
      },
      {
        "word_idx": 3,
        "gloss_text": "உள்முகமாகும் தன்மையால்"
      },
      {
        "word_idx": 4,
        "gloss_text": "சேதன நிலைக்கு (சுதந்திர அனுபவிப்போனின் நிலைக்கு) ஏறுவதனால்"
      },
      {
        "word_idx": 5,
        "gloss_text": "சித் (பேரறிவு) ஆகிறது"
      }
    ],
    "1.14": [
      {
        "word_idx": 0,
        "gloss_text": "சித் என்னும் அக்னி (சைதன்ய நெருப்பு)"
      },
      {
        "word_idx": 1,
        "gloss_text": "இறக்க நிலையில் (கட்டுண்ட நிலையில்)"
      },
      {
        "word_idx": 2,
        "gloss_text": "மறைந்திருந்தாலும்"
      },
      {
        "word_idx": 3,
        "gloss_text": "கூட"
      },
      {
        "word_idx": 4,
        "gloss_text": "ஓரளவு, பகுதியளவு"
      },
      {
        "word_idx": 5,
        "gloss_text": "அறியப்படுபொருள்கள் என்னும் எரிபொருள்"
      },
      {
        "word_idx": 6,
        "gloss_text": "எரிக்கிறது, சுட்டெரிக்கிறது"
      }
    ],
    "1.15": [
      {
        "word_idx": 0,
        "gloss_text": "(சித்தின்) பலத்தை அடைந்தபோது"
      },
      {
        "word_idx": 1,
        "gloss_text": "பிரபஞ்சத்தை"
      },
      {
        "word_idx": 2,
        "gloss_text": "தன்வயமாக, தனது சொந்த ஆத்மாவாக"
      },
      {
        "word_idx": 3,
        "gloss_text": "ஆக்குகிறது"
      }
    ],
    "1.16": [
      {
        "word_idx": 0,
        "gloss_text": "சித்-ஆனந்தத்தை அடைந்தபோது"
      },
      {
        "word_idx": 1,
        "gloss_text": "உடல் முதலானவற்றில்"
      },
      {
        "word_idx": 2,
        "gloss_text": "பொருளாக உணரப்படும்போது"
      },
      {
        "word_idx": 3,
        "gloss_text": "கூட"
      },
      {
        "word_idx": 4,
        "gloss_text": "சித்துடன் ஒன்றேதான் என்ற உறுதியான உணர்வு"
      },
      {
        "word_idx": 5,
        "gloss_text": "ஜீவன்முக்தி, உயிருடன் இருக்கையில் கிடைக்கும் விடுதலை"
      }
    ],
    "1.17": [
      {
        "word_idx": 0,
        "gloss_text": "மத்தியின் (மைய நாடியின்) விகாசத்தினால், விரிவினால்"
      },
      {
        "word_idx": 1,
        "gloss_text": "சித்-ஆனந்தத்தின் (பேரறிவின் பேரின்பத்தின்) லாபம், அடைதல்"
      }
    ],
    "1.18": [
      {
        "word_idx": 0,
        "gloss_text": "விகல்பங்களின் (எண்ண-ஓட்டங்களின்) க்ஷயம் (கரைதல்)"
      },
      {
        "word_idx": 1,
        "gloss_text": "சக்திகளின் சங்கோசம்-விகாசம் (சுருக்கம்-விரிவு)"
      },
      {
        "word_idx": 2,
        "gloss_text": "வாஹத்தை அறுத்தல் (ப்ராண-அபான ஓட்டத்தை அறுத்தல்)"
      },
      {
        "word_idx": 3,
        "gloss_text": "முதலான"
      },
      {
        "word_idx": 4,
        "gloss_text": "ஆதி-அந்தக் கோடிகளை உற்று நோக்குதல் (இரு முனைகளையும் கவனித்தல்)"
      },
      {
        "word_idx": 5,
        "gloss_text": "இவை முதலியவை"
      },
      {
        "word_idx": 6,
        "gloss_text": "இங்கு (இந்த உபதேசத்தில்)"
      },
      {
        "word_idx": 7,
        "gloss_text": "உபாயங்கள், வழிமுறைகள்"
      }
    ],
    "1.19": [
      {
        "word_idx": 0,
        "gloss_text": "சமாதியின் ஸம்ஸ்காரம் (பதிவு) தொடரும் நிலையில்"
      },
      {
        "word_idx": 1,
        "gloss_text": "வ்யுத்தான நிலையில் (வெளி-வினைகளுக்குத் திரும்பும்போது)"
      },
      {
        "word_idx": 2,
        "gloss_text": "மீண்டும் மீண்டும்"
      },
      {
        "word_idx": 3,
        "gloss_text": "சித்துடன் ஒன்றுபட்ட ஆமர்சனத்தினால் (உணர்வுப்பற்றினால்)"
      },
      {
        "word_idx": 4,
        "gloss_text": "எப்போதும் உதித்திருக்கும் சமாதியின் லாபம்"
      }
    ],
    "1.20": [
      {
        "word_idx": 0,
        "gloss_text": "அப்போது"
      },
      {
        "word_idx": 1,
        "gloss_text": "ப்ரகாசம்-ஆனந்தம் சாரமாகக் கொண்ட"
      },
      {
        "word_idx": 2,
        "gloss_text": "மஹாமந்த்ரத்தின் (அஹம்) வீரியத்தை இயல்பாகக் கொண்ட"
      },
      {
        "word_idx": 3,
        "gloss_text": "பூரண அஹந்தாவில் (முழு 'நான்'-உணர்வில்) நுழைவதனால்"
      },
      {
        "word_idx": 4,
        "gloss_text": "எப்போதும் அனைத்து ஸ்ருஷ்டி-ஸம்ஹாரத்தையும் செய்யும்"
      },
      {
        "word_idx": 5,
        "gloss_text": "தனது சொந்த ஸம்வித்-தேவதைகளின் சக்கரத்திற்கு ஈஸ்வரத்துவம் என்னும் பேறு"
      },
      {
        "word_idx": 6,
        "gloss_text": "ஆகின்றது"
      },
      {
        "word_idx": 7,
        "gloss_text": "இவ்வாறு, சிவம் (மங்களம்)"
      }
    ]
  }
}
