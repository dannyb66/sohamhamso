    "1.8": [
      {
        "word_idx": 0,
        "gloss_text": "തത്-ഭൂമികാഃ — ആ (ഏക ചിതിയുടെ) ഭൂമികകൾ, പങ്കുകൾ"
      },
      {
        "word_idx": 1,
        "gloss_text": "സർവ — സകലം, എല്ലാം"
      },
      {
        "word_idx": 2,
        "gloss_text": "ദർശന — തത്ത്വദർശനം, സിദ്ധാന്തവ്യവസ്ഥ"
      },
      {
        "word_idx": 3,
        "gloss_text": "സ്ഥിതയഃ — സ്ഥിതികൾ, നിലപാടുകൾ"
