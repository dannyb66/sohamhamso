    "1.1": [
      {
        "word_idx": 0,
        "gloss_text": "ചിതി — പരമബോധം, ശുദ്ധ ചൈതന്യം"
      },
      {
        "word_idx": 1,
        "gloss_text": "സ്വതന്ത്ര — സ്വാധീന, സ്വയം ആശ്രയിച്ച, സ്വാതന്ത്ര്യമുള്ള"
      },
      {
        "word_idx": 2,
        "gloss_text": "വിശ്വ — പ്രപഞ്ചം, സർവം"
      },
      {
        "word_idx": 3,
        "gloss_text": "സിദ്ധി — സാധനം, പ്രകടനം, സ്ഥാപനം"
      },
      {
        "word_idx": 4,
        "gloss_text": "ഹേതു — കാരണം"
      }
    ],
    "1.2": [
      {
        "word_idx": 0,
        "gloss_text": "സ്വ-ഇച്ഛയാ — സ്വന്തം ഇച്ഛയാൽ"
      },
      {
        "word_idx": 1,
        "gloss_text": "സ്വ-ഭിത്തൗ — സ്വന്തം ഭിത്തിയിൽ (ആത്മപടത്തിൽ)"
      },
      {
        "word_idx": 2,
        "gloss_text": "വിശ്വം — പ്രപഞ്ചത്തെ"
      },
      {
        "word_idx": 3,
        "gloss_text": "ഉന്മീലയതി — വിടർത്തുന്നു, പ്രകടമാക്കുന്നു (അക്ഷരാർഥം: 'തുറന്നു കാട്ടുന്നു')"
      }
    ],
    "1.3": [
      {
        "word_idx": 0,
        "gloss_text": "തത് — ആ (പ്രപഞ്ചം)"
      },
      {
        "word_idx": 1,
        "gloss_text": "നാനാ — അനേകവിധം, വൈവിധ്യപൂർണം"
      },
      {
        "word_idx": 2,
        "gloss_text": "അനുരൂപ — അനുയോജ്യമായ, അനുരൂപമായ"
      },
      {
        "word_idx": 3,
        "gloss_text": "ഗ്രാഹ്യ — ഗ്രഹിക്കപ്പെടേണ്ടത് (വിഷയം)"
      },
      {
        "word_idx": 4,
        "gloss_text": "ഗ്രാഹക — ഗ്രഹിക്കുന്നവൻ (വിഷയി)"
      },
      {
        "word_idx": 5,
        "gloss_text": "ഭേദാത് — ഭേദംമൂലം, വ്യത്യാസംമൂലം"
      }
    ],
    "1.4": [
      {
        "word_idx": 0,
        "gloss_text": "ചിതി-സങ്കോച-ആത്മാ — ചിതിയുടെ സങ്കോചം സ്വരൂപമായവൻ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ചേതനഃ — ചേതനൻ, അനുഭവിക്കുന്നവൻ, ജീവൻ"
      },
      {
        "word_idx": 2,
        "gloss_text": "അപി — പോലും, കൂടി"
      },
      {
        "word_idx": 3,
        "gloss_text": "സങ്കുചിത — സങ്കുചിതമായ, ചുരുങ്ങിയ"
      },
      {
        "word_idx": 4,
        "gloss_text": "വിശ്വ-മയഃ — വിശ്വസ്വരൂപൻ, വിശ്വാത്മകൻ"
      }
