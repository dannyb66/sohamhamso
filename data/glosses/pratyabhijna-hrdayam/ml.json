      {
        "word_idx": 4,
        "gloss_text": "ചേത്യ-സങ്കോചിനീ — ജ്ഞേയവിഷയത്താൽ സ്വയം സങ്കോചിക്കുന്നവൾ"
      },
      {
        "word_idx": 5,
        "gloss_text": "ചിത്തം — ചിത്തം (വ്യക്തിമനസ്സ്) എന്നു വിളിക്കപ്പെടുന്നു"
      }
    ],
    "1.6": [
      {
        "word_idx": 0,
        "gloss_text": "തത്-മയഃ — അതുകൊണ്ടു നിർമിതൻ (ചിത്തമയൻ)"
      },
      {
        "word_idx": 1,
        "gloss_text": "മായാ-പ്രമാതാ — മായാബദ്ധ പ്രമാതാ (മായയാൽ ബന്ധിതനായ അനുഭവിക്കുന്നവൻ)"
      }
    ],
    "1.7": [
      {
        "word_idx": 0,
        "gloss_text": "സഃ — അവൻ (പ്രമാതാ, അനുഭവിക്കുന്നവൻ)"
      },
      {
        "word_idx": 1,
        "gloss_text": "ച — ഉം"
      },
      {
        "word_idx": 2,
        "gloss_text": "ഏകഃ — ഒരുവൻ (സ്വരൂപത്തിൽ)"
