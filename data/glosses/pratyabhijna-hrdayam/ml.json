    "1.12": [
      {
        "word_idx": 0,
        "gloss_text": "തത്-അപരിജ്ഞാനേ — ആ (യഥാർഥ സ്വരൂപത്തിന്റെ) അപരിജ്ഞാനത്തിൽ"
