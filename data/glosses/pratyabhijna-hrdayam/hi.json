  "verses": {
    "1.1": [
      {
        "word_idx": 0,
        "gloss_text": "चिति — चैतन्य, परम बोध-शक्ति"
      },
      {
        "word_idx": 1,
        "gloss_text": "स्वतन्त्र, स्वाधीन, स्वायत्त"
      },
      {
        "word_idx": 2,
        "gloss_text": "विश्व, समस्त (समासगत स्तम्भ)"
      },
      {
        "word_idx": 3,
        "gloss_text": "सिद्धि — अभिव्यक्ति, स्थापना (समासगत स्तम्भ)"
      },
      {
        "word_idx": 4,
        "gloss_text": "हेतु — कारण"
      }
    ],
    "1.2": [
      {
        "word_idx": 0,
        "gloss_text": "अपनी इच्छा से"
      },
      {
        "word_idx": 1,
        "gloss_text": "अपनी ही भित्ति (आत्म-रूप पट) पर"
      },
      {
        "word_idx": 2,
        "gloss_text": "विश्व को"
      },
      {
        "word_idx": 3,
        "gloss_text": "उन्मीलित करती है, प्रकट करती है (शाब्दिक — 'खोलती है')"
      }
    ],
    "1.3": [
      {
        "word_idx": 0,
        "gloss_text": "वह (विश्व)"
      },
      {
        "word_idx": 1,
        "gloss_text": "नाना, विविध"
      },
      {
        "word_idx": 2,
        "gloss_text": "अनुरूप, परस्पर अनुकूल"
      },
      {
        "word_idx": 3,
        "gloss_text": "ग्राह्य — ज्ञेय विषय"
      },
      {
        "word_idx": 4,
        "gloss_text": "ग्राहक — ज्ञाता विषयी"
      },
      {
        "word_idx": 5,
        "gloss_text": "भेद के कारण"
      }
    ],
    "1.4": [
      {
        "word_idx": 0,
        "gloss_text": "जिसका स्वरूप चिति का संकोच है"
      },
      {
        "word_idx": 1,
        "gloss_text": "चेतन — जीव, अनुभोक्ता"
      },
      {
        "word_idx": 2,
        "gloss_text": "भी, तथापि"
      },
      {
        "word_idx": 3,
        "gloss_text": "संकुचित, सीमित"
      },
      {
        "word_idx": 4,
        "gloss_text": "विश्वमय — विश्व-स्वरूप, विश्व से अभिन्न"
      }
    ],
    "1.5": [
      {
        "word_idx": 0,
        "gloss_text": "चिति स्वयं"
      },
      {
        "word_idx": 1,
        "gloss_text": "ही, मात्र"
      },
      {
        "word_idx": 2,
        "gloss_text": "(स्वतन्त्र) चेतन-पद से"
      },
      {
        "word_idx": 3,
        "gloss_text": "अवरूढ़, नीचे उतरी हुई"
      },
      {
        "word_idx": 4,
        "gloss_text": "ज्ञेय (विषय) से संकुचित होती हुई"
      },
      {
        "word_idx": 5,
        "gloss_text": "चित्त — व्यक्तिगत मन कहलाती है"
      }
    ],
    "1.6": [
      {
        "word_idx": 0,
        "gloss_text": "उस (चित्त) से बना हुआ"
      },
      {
        "word_idx": 1,
        "gloss_text": "माया-प्रमाता — मायाबद्ध अनुभोक्ता (जीव)"
      }
    ],
    "1.7": [
      {
        "word_idx": 0,
        "gloss_text": "वह (प्रमाता)"
      },
      {
        "word_idx": 1,
        "gloss_text": "और"
      },
      {
        "word_idx": 2,
        "gloss_text": "एक (तत्त्व में)"
      },
      {
        "word_idx": 3,
        "gloss_text": "द्विरूप — दो रूप वाला (शिव-शक्ति)"
      },
      {
        "word_idx": 4,
        "gloss_text": "त्रिमय — तीन से युक्त (आणव/शाक्त/शाम्भव अथवा तीन मल)"
      },
      {
        "word_idx": 5,
        "gloss_text": "चतुरात्मा — चार स्वरूप वाला (चार अवस्थाएँ)"
      },
      {
        "word_idx": 6,
        "gloss_text": "सप्त-पंचक — सात पञ्चक"
      },
      {
        "word_idx": 7,
        "gloss_text": "स्वभाव वाला है"
      }
    ],
    "1.8": [
      {
        "word_idx": 0,
        "gloss_text": "उसी (एक चिति) की भूमिकाएँ / स्तर"
      },
      {
        "word_idx": 1,
        "gloss_text": "समस्त"
      },
      {
        "word_idx": 2,
        "gloss_text": "दर्शन — दार्शनिक मत, सिद्धान्त"
      },
      {
        "word_idx": 3,
        "gloss_text": "स्थितियाँ — स्थापित दृष्टिकोण"
      }
    ],
    "1.9": [
      {
        "word_idx": 0,
        "gloss_text": "यद्यपि चित्-स्वरूप है"
      },
      {
        "word_idx": 1,
        "gloss_text": "अपनी शक्तियों के संकोच के कारण"
      },
      {
        "word_idx": 2,
        "gloss_text": "मलों से आवृत, अशुद्धियों से ढका हुआ"
      },
      {
        "word_idx": 3,
        "gloss_text": "संसारी — संसार में परिभ्रमण करने वाला जीव"
      }
    ],
    "1.10": [
      {
        "word_idx": 0,
        "gloss_text": "फिर भी, तथापि"
      },
      {
        "word_idx": 1,
        "gloss_text": "उस (शिव) के समान"
      },
      {
        "word_idx": 2,
        "gloss_text": "पाँच कृत्य (सृष्टि, स्थिति, संहार, तिरोधान, अनुग्रह)"
      },
      {
        "word_idx": 3,
        "gloss_text": "करता है"
      }
    ],
    "1.11": [
      {
        "word_idx": 0,
        "gloss_text": "आभासन — प्रकटीकरण (= सृष्टि)"
      },
      {
        "word_idx": 1,
        "gloss_text": "रक्ति — आस्वादन (= स्थिति)"
      },
      {
        "word_idx": 2,
        "gloss_text": "विमर्शन — विमर्श-रूप ग्रहण (= संहार)"
      },
      {
        "word_idx": 3,
        "gloss_text": "बीजावस्थापन — बीज-रूप में स्थापन (= तिरोधान)"
      },
      {
        "word_idx": 4,
        "gloss_text": "विलापन — विलय (= अनुग्रह) — इनसे"
      },
      {
        "word_idx": 5,
        "gloss_text": "वे पाँच कृत्य (सम्पन्न होते हैं)"
      }
    ],
    "1.12": [
      {
        "word_idx": 0,
        "gloss_text": "उस (स्वस्वरूप) का परिज्ञान न होने पर"
      },
      {
        "word_idx": 1,
        "gloss_text": "अपनी ही शक्तियों के द्वारा"
      },
      {
        "word_idx": 2,
        "gloss_text": "व्यामोहित अवस्था — पूर्णतः मोहग्रस्त होने की स्थिति"
      },
      {
        "word_idx": 3,
        "gloss_text": "संसारित्व — संसार में बद्ध रहने का स्वरूप"
      }
    ],
    "1.13": [
      {
        "word_idx": 0,
        "gloss_text": "उस (स्वस्वरूप) का पूर्ण परिज्ञान होने पर"
      },
      {
        "word_idx": 1,
        "gloss_text": "चित्त (सीमित मन)"
      },
      {
        "word_idx": 2,
        "gloss_text": "ही, स्वयं"
      },
      {
        "word_idx": 3,
        "gloss_text": "अन्तर्मुख होकर"
      },
      {
        "word_idx": 4,
        "gloss_text": "(स्वतन्त्र) चेतन-पद पर आरोहण करने से"
      },
      {
        "word_idx": 5,
        "gloss_text": "चिति (परम चैतन्य) बन जाता है"
      }
    ],
    "1.14": [
      {
        "word_idx": 0,
        "gloss_text": "चिति-रूप अग्नि"
      },
      {
        "word_idx": 1,
        "gloss_text": "अवरोह-दशा में (बद्ध अवस्था में)"
      },
      {
        "word_idx": 2,
        "gloss_text": "आच्छन्न, ढकी हुई होकर भी"
      },
      {
        "word_idx": 3,
        "gloss_text": "भी, तथापि"
      },
      {
        "word_idx": 4,
        "gloss_text": "आंशिक रूप से"
      },
      {
        "word_idx": 5,
        "gloss_text": "ज्ञेय-रूपी ईंधन को"
      },
      {
        "word_idx": 6,
        "gloss_text": "जलाती है, भस्म करती है"
      }
    ],
    "1.15": [
      {
        "word_idx": 0,
        "gloss_text": "(चिति के) बल की प्राप्ति होने पर"
      },
      {
        "word_idx": 1,
        "gloss_text": "विश्व को"
      },
      {
        "word_idx": 2,
        "gloss_text": "आत्म-रूप, स्वयं के अनुरूप"
      },
      {
        "word_idx": 3,
        "gloss_text": "कर लेती है"
      }
    ],
    "1.16": [
      {
        "word_idx": 0,
        "gloss_text": "चित्-आनन्द की प्राप्ति होने पर"
      },
      {
        "word_idx": 1,
        "gloss_text": "देह आदि (विषयों) में"
      },
      {
        "word_idx": 2,
        "gloss_text": "विषय-रूप में अनुभूत होते हुए भी"
      },
      {
        "word_idx": 3,
        "gloss_text": "भी, यद्यपि"
      },
      {
        "word_idx": 4,
        "gloss_text": "चित् के साथ ऐक्य-प्रतिपत्ति की दृढ़ता"
      },
      {
        "word_idx": 5,
        "gloss_text": "जीवन्मुक्ति — जीते-जी मुक्ति"
      }
    ],
    "1.17": [
      {
        "word_idx": 0,
        "gloss_text": "मध्य (केन्द्र / मध्य नाड़ी) के विकास से"
      },
      {
        "word_idx": 1,
        "gloss_text": "चित्-आनन्द की प्राप्ति होती है"
      }
    ],
    "1.18": [
      {
        "word_idx": 0,
        "gloss_text": "विकल्पों का क्षय — विचार-वृत्तियों का विलय"
      },
      {
        "word_idx": 1,
        "gloss_text": "शक्तियों का संकोच और विकास"
      },
      {
        "word_idx": 2,
        "gloss_text": "वाह-छेद — (प्राण-अपान के) प्रवाह का छेदन"
      },
      {
        "word_idx": 3,
        "gloss_text": "आदि — इत्यादि"
      },
      {
        "word_idx": 4,
        "gloss_text": "अन्त-कोटि-निभालन — आदि-अन्त दोनों कोटियों का सावधान अवलोकन"
      },
      {
        "word_idx": 5,
        "gloss_text": "आदि — इत्यादि (ये तथा अन्य समान)"
      },
      {
        "word_idx": 6,
        "gloss_text": "यहाँ (इस उपदेश में)"
      },
      {
        "word_idx": 7,
        "gloss_text": "उपाय — साधन"
      }
    ],
    "1.19": [
      {
        "word_idx": 0,
        "gloss_text": "समाधि के संस्कार से युक्त दशा में"
      },
      {
        "word_idx": 1,
        "gloss_text": "व्युत्थान में — समाधि से उठकर बाहरी क्रिया में आने पर"
      },
      {
        "word_idx": 2,
        "gloss_text": "बार-बार"
      },
      {
        "word_idx": 3,
        "gloss_text": "चित् के साथ ऐक्य के आमर्शन (विमर्श) से"
      },
      {
        "word_idx": 4,
        "gloss_text": "नित्योदित समाधि — सदा उदित रहने वाली समाधि की प्राप्ति"
      }
    ],
    "1.20": [
      {
        "word_idx": 0,
        "gloss_text": "तब"
      },
      {
        "word_idx": 1,
        "gloss_text": "जिसका सार प्रकाश और आनन्द है"
      },
      {
        "word_idx": 2,
        "gloss_text": "महामन्त्र (अहम्) के वीर्य से युक्त"
      },
      {
        "word_idx": 3,
        "gloss_text": "पूर्ण अहन्ता में आवेश (प्रवेश) से"
      },
      {
        "word_idx": 4,
        "gloss_text": "सदा समस्त सृष्टि और संहार करने वाले"
      },
      {
        "word_idx": 5,
        "gloss_text": "अपने ही संविद्-देवता-चक्र की ईश्वरता (स्वामित्व) की प्राप्ति"
      },
      {
        "word_idx": 6,
        "gloss_text": "होती है"
      },
      {
        "word_idx": 7,
        "gloss_text": "इति शिवम् — इस प्रकार सर्वत्र मंगल हो"
      }
    ]
  }
}
