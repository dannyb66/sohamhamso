  "verses": {
    "1.1": [
      {"word_idx": 0, "gloss_text": "ஸ்ரீதேவி, தேவி, பூஜ்யமான தேவி"},
      {"word_idx": 1, "gloss_text": "கூறினாள், சொன்னாள்"},
      {"word_idx": 2, "gloss_text": "அநுத்தரம் (மேலெதுவுமற்றது, அதற்கு மேல் எதுவுமில்லாத பரம்பொருள்)"},
      {"word_idx": 3, "gloss_text": "எவ்வாறு, எந்த விதத்தில்"},
      {"word_idx": 4, "gloss_text": "தேவனே (பைரவனே)"},
      {"word_idx": 5, "gloss_text": "தானாகவே, இயல்பாக, தன்னிச்சையாக"},
      {"word_idx": 6, "gloss_text": "கௌலிக சித்தியை அருளும் (குலத்திற்குரிய ஆற்றலை வழங்கும்)"},
      {"word_idx": 7, "gloss_text": "எதனால்"},
      {"word_idx": 8, "gloss_text": "வெறும் அறிதலினால், அறிந்தமாத்திரத்தில்"},
      {"word_idx": 9, "gloss_text": "கேசரியுடன் சமநிலை (வானில் சஞ்சரிக்கும் சக்தி/உணர்வு நிலையுடன் ஒப்புமை)"},
      {"word_idx": 10, "gloss_text": "அடைவான், செல்வான்"}
    ],
    "1.2": [
      {"word_idx": 0, "gloss_text": "இதை"},
      {"word_idx": 1, "gloss_text": "ரகசியம், மறை-உபதேசம்"},
      {"word_idx": 2, "gloss_text": "மஹாரகசியம், பெரும் மறை"},
      {"word_idx": 3, "gloss_text": "கூறுவாயாக, அறிவிப்பாயாக (எனக்கு)"},
      {"word_idx": 4, "gloss_text": "எனக்கு, என்னுடைய"},
      {"word_idx": 5, "gloss_text": "பிரபுவே, தலைவனே"},
      {"word_idx": 6, "gloss_text": "இதயத்தில் வீற்றிருக்கும்"},
      {"word_idx": 7, "gloss_text": "ஆனால், திண்ணமாக"},
      {"word_idx": 8, "gloss_text": "எவள், யாவள்"},
      {"word_idx": 9, "gloss_text": "சக்தி, ஆற்றல்"},
      {"word_idx": 10, "gloss_text": "கௌலினி (குலத்தின் சக்தி)"},
      {"word_idx": 11, "gloss_text": "குலநாயகி, குலத்தின் தலைவி"}
    ],
    "1.3": [
      {"word_idx": 0, "gloss_text": "அவளை, அந்த (சக்தியை)"},
      {"word_idx": 1, "gloss_text": "எனக்கு"},
      {"word_idx": 2, "gloss_text": "கூறுவாயாக, அறிவிப்பாயாக"},
      {"word_idx": 3, "gloss_text": "தேவேசனே, தேவர்களின் தலைவனே"},
      {"word_idx": 4, "gloss_text": "எதனால்"},
      {"word_idx": 5, "gloss_text": "நிறைவு, த்ருப்தி"},
      {"word_idx": 6, "gloss_text": "நான் அடைகிறேன், செல்கிறேன்"},
      {"word_idx": 7, "gloss_text": "நான்"},
      {"word_idx": 8, "gloss_text": "ஸ்ரீபைரவன், பூஜ்யமான பைரவன்"},
      {"word_idx": 9, "gloss_text": "கூறினான், சொன்னான்"},
      {"word_idx": 10, "gloss_text": "கேள், செவிமடு"},
      {"word_idx": 11, "gloss_text": "தேவியே"},
      {"word_idx": 12, "gloss_text": "மிகவும் பாக்கியசாலியே, பேறுபெற்றவளே"},
      {"word_idx": 13, "gloss_text": "உத்தரத்தையும் (மேலானதையும்) கூட"},
      {"word_idx": 14, "gloss_text": "அநுத்தரம் (உத்தரத்தைக் கடந்து நிற்கும் பரம்பொருள்)"}
    ],
    "1.4": [
      {"word_idx": 0, "gloss_text": "கூறுகிறேன், அறிவிக்கிறேன்"},
      {"word_idx": 1, "gloss_text": "இல்லை, அல்ல"},
      {"word_idx": 2, "gloss_text": "ஐயம், சந்தேகம்"},
      {"word_idx": 3, "gloss_text": "உடனே, உடனடியாக"},
      {"word_idx": 4, "gloss_text": "கௌலிக சித்தியை அருளும்"},
      {"word_idx": 5, "gloss_text": "கௌலிக (குலத்திற்குரிய)"},
      {"word_idx": 6, "gloss_text": "இந்த"},
      {"word_idx": 7, "gloss_text": "முறை, சடங்கு, விதி"},
      {"word_idx": 8, "gloss_text": "தேவியே"},
      {"word_idx": 9, "gloss_text": "என்னுடைய"},
      {"word_idx": 10, "gloss_text": "இதயவெளியில் (ஹ்ருத்-வ்யோமத்தில்)"},
      {"word_idx": 11, "gloss_text": "நிலைபெற்றுள்ளது, அமைந்துள்ளது"}
    ],
    "1.5": [
      {"word_idx": 0, "gloss_text": "இனி, அப்போது (மங்கல தொடக்கம்)"},
      {"word_idx": 1, "gloss_text": "ஆதியான, முதன்மையான"},
      {"word_idx": 2, "gloss_text": "திதிகள் (சந்திர நாட்கள், இங்கே உயிரெழுத்துக்கள்)"},
      {"word_idx": 3, "gloss_text": "அனைத்தும்"},
      {"word_idx": 4, "gloss_text": "ஸ்வரங்கள் (உயிரெழுத்துக்கள்)"},
      {"word_idx": 5, "gloss_text": "பிந்துவில் முடிபவை (அநுஸ்வாரம்/புள்ளி)"},
      {"word_idx": 6, "gloss_text": "அவற்றின் முடிவில்"},
      {"word_idx": 7, "gloss_text": "காலயோகத்தினால் (காலத்தின் சேர்க்கையால்)"},
      {"word_idx": 8, "gloss_text": "சோமனும் சூரியனும் (இறுதி இரண்டு — ம் மற்றும் ஃ)"},
      {"word_idx": 9, "gloss_text": "அறிவிக்கப்படுகின்றன, செப்பப்படுகின்றன"}
    ],
    "1.6": [
      {"word_idx": 0, "gloss_text": "பிருதிவீ (மண்) முதலானவை"},
      {"word_idx": 1, "gloss_text": "தத்துவங்கள், கூறுபொருள்கள்"},
      {"word_idx": 2, "gloss_text": "புருஷனில் முடிபவை"},
      {"word_idx": 3, "gloss_text": "ஐந்து (வர்க்கங்களில்)"},
      {"word_idx": 4, "gloss_text": "வரிசையாக, முறையே"},
      {"word_idx": 5, "gloss_text": "க-முதலான (வகுப்புகளில்)"},
      {"word_idx": 6, "gloss_text": "வர்க்கங்களில் (மெய்யெழுத்து வகுப்புகளில்)"},
      {"word_idx": 7, "gloss_text": "ம-காரத்தில் முடிபவற்றில்"},
      {"word_idx": 8, "gloss_text": "நற்விரதம் பூண்டவளே (தேவியே)"}
    ],
    "1.7": [
      {"word_idx": 0, "gloss_text": "வாயு, அக்னி, ஜலம், இந்திரன் ஆகியவற்றின் (நான்கு தாரணை மூலகங்கள்)"},
      {"word_idx": 1, "gloss_text": "தாரணைகளின் (செறிவுநிலைகளின்)"},
      {"word_idx": 2, "gloss_text": "நான்கின் கூட்டம், சதுஷ்டயம்"},
      {"word_idx": 3, "gloss_text": "அதற்கு மேலே"},
      {"word_idx": 4, "gloss_text": "ச-முதலான என அறியப்படும் (ஊஷ்மாக்கள்/சிபிலன்கள்)"},
      {"word_idx": 5, "gloss_text": "முன், முன்னணியில், முதன்மையாக"},
      {"word_idx": 6, "gloss_text": "ப்ரஹ்மபஞ்சகம் (ப்ரஹ்மத்தின் ஐந்து — ச ஷ ஸ ஹ க்ஷ)"}
    ],
    "1.8": [
      {"word_idx": 0, "gloss_text": "வேரற்றது (அ-காரம் முதலான 'வேரற்ற' உயிரெழுத்தில் தொடங்கி)"},
      {"word_idx": 1, "gloss_text": "அதே வரிசையுடையது (அ … க்ஷ)"},
      {"word_idx": 2, "gloss_text": "அறியத்தக்கது"},
      {"word_idx": 3, "gloss_text": "க்ஷ-வில் முடிவது"},
      {"word_idx": 4, "gloss_text": "ஸ்ருஷ்டி, உருவாக்கம் (எழுத்துக்களின் வரிசை அண்ட எழுச்சியாக)"},
      {"word_idx": 5, "gloss_text": "எடுத்துரைக்கப்பட்டது, விளக்கப்பட்டது"},
      {"word_idx": 6, "gloss_text": "அனைத்தின்"},
      {"word_idx": 7, "gloss_text": "மேலும் திண்ணமாக (ச + ஏவ)"},
      {"word_idx": 8, "gloss_text": "மந்திரங்களின்"},
      {"word_idx": 9, "gloss_text": "வித்தைகளின் (பெண்பால் மந்திரங்கள்/ஞான-வடிவங்கள்)"},
      {"word_idx": 10, "gloss_text": "மற்றும்"},
      {"word_idx": 11, "gloss_text": "புகழுடையவளே"}
    ],
    "1.9": [
      {"word_idx": 0, "gloss_text": "இது"},
      {"word_idx": 1, "gloss_text": "யோனி, மூலகாரணம், கருப்பை"},
      {"word_idx": 2, "gloss_text": "முழுமையாக அறிவிக்கப்படுகிறது"},
      {"word_idx": 3, "gloss_text": "அனைத்து தந்திரங்களிலும்"},
      {"word_idx": 4, "gloss_text": "எப்போதும்"},
      {"word_idx": 5, "gloss_text": "பதினான்காவதுடன் (ஔ உயிரெழுத்துடன்) கூடிய"},
      {"word_idx": 6, "gloss_text": "பத்ரையே, மங்களகரமானவளே"},
      {"word_idx": 7, "gloss_text": "திதிகளின் தலைவனின் முடிவுடன் (விசர்க்கம் ஃ) இணைந்த"},
      {"word_idx": 8, "gloss_text": "மூன்றாவது (மூன்றாவது வித்து-அக்ஷரம்/ப்ரஹ்மம்)"},
      {"word_idx": 9, "gloss_text": "ப்ரஹ்மம் (இங்கே புனித அக்ஷரம்/பீஜம்)"},
      {"word_idx": 10, "gloss_text": "அழகிய இடையுடையவளே"},
      {"word_idx": 11, "gloss_text": "இதயம் (சாரம், பீஜம் ஸௌஃ)"},
      {"word_idx": 12, "gloss_text": "பைரவனின் சொந்த சுயரூபத்தின் (பைரவ இயல்புடையவனின்)"}
    ],
    "1.10": [
      {"word_idx": 0, "gloss_text": "இதை"},
      {"word_idx": 1, "gloss_text": "மனிதன் (இங்கே 'ஒருவராலும் இல்லை' என்னும் பொருள்)"},
      {"word_idx": 2, "gloss_text": "யோகினியின் மகன் (யோகினியால் பிறந்தவன்)"},
      {"word_idx": 3, "gloss_text": "மனிதன் (இங்கே 'ஒருவராலும் இல்லை' என்னும் பொருள்)"},
      {"word_idx": 4, "gloss_text": "ருத்திரன்"},
      {"word_idx": 5, "gloss_text": "அடைகிறான், பெறுகிறான்"},
      {"word_idx": 6, "gloss_text": "தெளிவாக, வெளிப்படையாக"},
      {"word_idx": 7, "gloss_text": "இதயம்"},
      {"word_idx": 8, "gloss_text": "தேவாதிதேவனின் (தேவர்களின் தேவனின்)"},
      {"word_idx": 9, "gloss_text": "உடனே, உடனடியாக"},
      {"word_idx": 10, "gloss_text": "யோகத்தையும் முக்தியையும் அருளும் (யோகம் மற்றும் மோக்ஷம்)"}
    ],
    "1.11": [
      {"word_idx": 0, "gloss_text": "இதன் உச்சாரணை (இந்த பீஜத்தின் உச்சாரம்)"},
      {"word_idx": 1, "gloss_text": "செய்யப்பட்டால், நிகழ்த்தப்பட்டால்"},
      {"word_idx": 2, "gloss_text": "சரியாக, முறையாக"},
      {"word_idx": 3, "gloss_text": "மந்திரங்களும் முத்திரைகளும் கொண்ட கூட்டம்"},
      {"word_idx": 4, "gloss_text": "பெரிய, மஹத்தான"},
      {"word_idx": 5, "gloss_text": "உடனே, உடனடியாக"},
      {"word_idx": 6, "gloss_text": "எதிர்முகமாக நிற்கும் நிலை (நேருக்கு நேர் வருதல்)"},
      {"word_idx": 7, "gloss_text": "வந்து சேர்கிறது, அடைகிறது"},
      {"word_idx": 8, "gloss_text": "தன் சொந்த உடலில் ஆவேசம் (உட்புகுதல்) நிகழும் இலக்கணத்துடன்"}
    ],
    "1.12": [
      {"word_idx": 0, "gloss_text": "ஒரு கணம், ஒரு முஹூர்த்தம்"},
      {"word_idx": 1, "gloss_text": "சிந்திக்கிறான், மனத்தில் தாங்குகிறான்"},
      {"word_idx": 2, "gloss_text": "எவன், எவ்வொருவன்"},
      {"word_idx": 3, "gloss_text": "ஆனால், திண்ணமாக"},
      {"word_idx": 4, "gloss_text": "சேர்க்கைப்புள்ளியில் (சும்பகம், சந்திப்பு இடம்)"},
      {"word_idx": 5, "gloss_text": "நாபியில் முத்திரையிடப்பட்டவன் (நாபி-முத்திரையுடன்)"},
      {"word_idx": 6, "gloss_text": "அவன்"},
      {"word_idx": 7, "gloss_text": "கட்டிக்கொள்கிறான், பிணைத்துக்கொள்கிறான்"},
      {"word_idx": 8, "gloss_text": "அப்போது"},
      {"word_idx": 9, "gloss_text": "உடலை (வடிவத்தை)"},
      {"word_idx": 10, "gloss_text": "மந்திரங்களும் முத்திரைகளும் கொண்ட கூட்டமாக"},
      {"word_idx": 11, "gloss_text": "மனிதன், ஆள்"}
    ],
    "1.13": [
      {"word_idx": 0, "gloss_text": "கடந்த, வரவிருக்கும் காரியங்களை (அதீத-அநாகதம்)"},
      {"word_idx": 1, "gloss_text": "கேட்கப்பட்டவன், வினவப்பட்டவன்"},
      {"word_idx": 2, "gloss_text": "அவன், அந்த ஒருவன்"},
      {"word_idx": 3, "gloss_text": "கூறுகிறான், அறிவிக்கிறான்"},
      {"word_idx": 4, "gloss_text": "கூட, மேலும்"},
      {"word_idx": 5, "gloss_text": "ஒரு ப்ரஹரத்திற்குள் (ஜாமம், பகலின் கால் பகுதி)"},
      {"word_idx": 6, "gloss_text": "எது, எதுவோ"},
      {"word_idx": 7, "gloss_text": "விரும்பப்பட்டது, கருதப்பட்டது"},
      {"word_idx": 8, "gloss_text": "தேவதையின் வடிவம்"},
      {"word_idx": 9, "gloss_text": "உச்சரித்தபடி, ஒலித்தபடி"}
    ],
    "1.14": [
