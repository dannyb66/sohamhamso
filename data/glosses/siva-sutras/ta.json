{
  "text_slug": "siva-sutras",
  "lang": "ta",
  "translator": "sohamhamso (claude-opus-4-7)",
  "license": "CC-BY-SA",
  "ai_assisted": true,
  "status": "published",
  "verses": {
    "1.1": [
      {
        "word_idx": 0,
        "gloss_text": "தூய சைதன்யம், உணர்வு"
      },
      {
        "word_idx": 1,
        "gloss_text": "ஆத்மா, உண்மை இயல்பு"
      }
    ],
    "1.2": [
      {
        "word_idx": 0,
        "gloss_text": "(வரம்புபட்ட, இருமைப்பட்ட) அறிவு"
      },
      {
        "word_idx": 1,
        "gloss_text": "பந்தம், கட்டு"
      }
    ],
    "1.3": [
      {
        "word_idx": 0,
        "gloss_text": "மூலத் தொகுதி (மாயை — நிகழ்வுகளின் கருவறை)"
      },
      {
        "word_idx": 1,
        "gloss_text": "கலைகளால் (வரம்புப்படுத்தும் செயற்படிகளால்) ஆன உடல்"
      }
    ],
    "1.4": [
      {
        "word_idx": 0,
        "gloss_text": "(வரம்புபட்ட) அறிவின் அடித்தளம்"
      },
      {
        "word_idx": 1,
        "gloss_text": "மாத்ருகா — புரியப்படாத தாய், எழுத்துக்களின் தாய்மாதிரி"
      }
    ],
    "1.5": [
      {
        "word_idx": 0,
        "gloss_text": "திடீர் எழுச்சி/வெளிப்பாடு (விழிப்புணர்வின்)"
      },
      {
        "word_idx": 1,
        "gloss_text": "பைரவன், பரம சிவன்"
      }
    ],
    "1.6": [
      {
        "word_idx": 0,
        "gloss_text": "(அறிவாற்றல்) சக்திகளின் சக்கரத்துடனான இணைப்பில்"
      },
      {
        "word_idx": 1,
        "gloss_text": "பிரபஞ்சத்தின் (தனித்ததாகக் காணப்படுவதன்) கரைப்பு"
      }
    ],
    "1.7": [
      {
        "word_idx": 0,
        "gloss_text": "விழிப்பு, கனவு, ஆழ்ந்த உறக்கம் ஆகியவற்றின் வேறுபாட்டில்"
      },
      {
        "word_idx": 1,
        "gloss_text": "துரியத்தின் ஆனந்த விரிவின் எழுச்சி"
      }
    ],
    "1.8": [
      {
        "word_idx": 0,
        "gloss_text": "(அனுபவ) அறிவு"
      },
      {
        "word_idx": 1,
        "gloss_text": "விழிப்பு நிலை"
      }
    ],
    "1.9": [
      {
        "word_idx": 0,
        "gloss_text": "கனவு நிலை"
      },
      {
        "word_idx": 1,
        "gloss_text": "விகல்பங்கள், மனக் கற்பனைகள்"
      }
    ],
    "1.10": [
      {
        "word_idx": 0,
        "gloss_text": "விவேகமின்மை, பாகுபாட்டின்மை"
      },
      {
        "word_idx": 1,
        "gloss_text": "மாயையின் ஆழ்ந்த உறக்கம் (மாயையால் தூண்டப்பட்ட மயக்கம்)"
      }
    ],
    "1.11": [
      {
        "word_idx": 0,
        "gloss_text": "(விழிப்பு, கனவு, உறக்கம்) மூவகையை அனுபவிப்பவன்"
      },
      {
        "word_idx": 1,
        "gloss_text": "வீரர்களின் (புலன்களின்) தலைவன், இந்திரியங்களின் ஆண்டவன்"
      }
    ],
    "1.12": [
      {
        "word_idx": 0,
        "gloss_text": "வியப்பு, ஆச்சரியம்"
      },
      {
        "word_idx": 1,
        "gloss_text": "யோகத்தின் நிலைகள்"
      }
    ],
    "1.13": [
      {
        "word_idx": 0,
        "gloss_text": "இச்சா சக்தி, விருப்ப ஆற்றல்"
      },
      {
        "word_idx": 1,
        "gloss_text": "உமை (தேவி; இங்கு பரம விருப்பம்)"
      },
      {
        "word_idx": 2,
        "gloss_text": "கன்னி (மாறாதவள், இடைநிலை நோக்கங்களற்றவள்)"
      }
    ],
    "1.14": [
      {
        "word_idx": 0,
        "gloss_text": "காணப்படும் (புலனாகும்) அனைத்தும்"
      },
      {
        "word_idx": 1,
        "gloss_text": "(அவனது) உடல்"
      }
    ],
    "1.15": [
      {
        "word_idx": 0,
        "gloss_text": "இதயத்தில் (உணர்வின் மையத்தில்)"
      },
      {
        "word_idx": 1,
        "gloss_text": "சித்தத்தின் ஒன்றிணைப்பு/ஒருநிலைப்படுத்தலால்"
      },
      {
        "word_idx": 2,
        "gloss_text": "காணப்படுவதின் மறைவின் தரிசனம்"
      }
    ],
    "1.16": [
      {
        "word_idx": 0,
        "gloss_text": "தூய தத்துவத்துடனான (தொடர்ச்சியான) இணைப்பால்"
      },
      {
        "word_idx": 1,
        "gloss_text": "அல்லது (மாற்றாக)"
      },
      {
        "word_idx": 2,
        "gloss_text": "பசு (கட்டப்பட்ட ஜீவன்) நிலையிலிருந்து விடுவிக்கும் சக்தி"
      }
    ],
    "1.17": [
      {
        "word_idx": 0,
        "gloss_text": "(திட) அறிவு, பிரதிபலிப்பு நிச்சயம்"
      },
      {
        "word_idx": 1,
        "gloss_text": "ஆத்ம ஞானம்"
      }
    ],
    "1.18": [
      {
        "word_idx": 0,
        "gloss_text": "உலகைக் (காண்பதின்) ஆனந்தம்"
      },
      {
        "word_idx": 1,
        "gloss_text": "சமாதியின் சுகம்"
      }
    ],
    "1.19": [
      {
        "word_idx": 0,
        "gloss_text": "(தெய்வீக) சக்தியுடனான இணைப்பில்"
      },
      {
        "word_idx": 1,
        "gloss_text": "(விரும்பிய) உடலின் உற்பத்தி"
      }
    ],
    "1.20": [
      {
        "word_idx": 0,
        "gloss_text": "(பஞ்சபூதங்களை அவற்றின் சாரத்துடன்) இணைத்தல்"
      },
      {
        "word_idx": 1,
        "gloss_text": "(நோய் முதலியவற்றிலிருந்து) பூதங்களைப் பிரித்தல்"
      },
      {
        "word_idx": 2,
        "gloss_text": "உலகின் (பகுதிகளின்) ஒன்றுசேர்த்தல் (= சித்திகள்)"
      }
    ],
    "1.21": [
      {
        "word_idx": 0,
        "gloss_text": "சுத்த வித்யையின் (தூய ஞானத்தின்) உதயத்தால்"
      },
      {
        "word_idx": 1,
        "gloss_text": "(சக்திகளின்) சக்கரத்தின் மீதான ஆதிக்கம் கிட்டுதல்"
      }
    ],
    "1.22": [
      {
        "word_idx": 0,
        "gloss_text": "மஹா ஹ்ரதத்துடன் (பரம உணர்வின் பெருந் தடாகம்) தொடர்ச்சியான இணைப்பால்"
      },
      {
        "word_idx": 1,
        "gloss_text": "மந்திர வீரியத்தின் அனுபவம்"
      }
    ],
    "2.1": [
      {
        "word_idx": 0,
        "gloss_text": "(பரம உண்மையை நோக்கிய) சித்தம்"
      },
      {
        "word_idx": 1,
        "gloss_text": "மந்திரம்"
      }
    ],
    "2.2": [
      {
        "word_idx": 0,
        "gloss_text": "தன்னிச்சையான, தீவிர முயற்சி (ஆத்மாவை நோக்கி)"
      },
      {
        "word_idx": 1,
        "gloss_text": "சாதகன், (இலக்கை) நிறைவேற்றுபவர்"
      }
    ],
    "2.3": [
      {
        "word_idx": 0,
        "gloss_text": "(தூய) ஞானமே உடலாகக் கொண்ட இருப்பு"
      },
      {
        "word_idx": 1,
        "gloss_text": "மந்திரத்தின் ரகசியம்"
      }
    ],
    "2.4": [
      {
        "word_idx": 0,
        "gloss_text": "(மாயையின்) கருவறையில்"
      },
      {
        "word_idx": 1,
        "gloss_text": "சித்தத்தின் விரிவு (தாழ் ஆனந்தத்தில்)"
      },
      {
        "word_idx": 2,
        "gloss_text": "வேறுபடாத (தாழ்) ஞானத்தின் கனவே"
      }
    ],
    "2.5": [
      {
        "word_idx": 0,
        "gloss_text": "(தூய) ஞானம் எழும்போது"
      },
      {
        "word_idx": 1,
        "gloss_text": "தன்னிச்சையான, இயல்பான"
      },
      {
        "word_idx": 2,
        "gloss_text": "கேசரி (உணர்வின் வெளியில் இயக்கம்)"
      },
      {
        "word_idx": 3,
        "gloss_text": "சிவ நிலை"
      }
    ],
    "2.6": [
      {
        "word_idx": 0,
        "gloss_text": "குரு"
      },
      {
        "word_idx": 1,
        "gloss_text": "உபாயம், வழிமுறை"
      }
    ],
    "2.7": [
      {
        "word_idx": 0,
        "gloss_text": "மாத்ருகா சக்கரம் (எழுத்துத் தேவியின் சக்கரம்)"
      },
      {
        "word_idx": 1,
        "gloss_text": "முழு விழிப்புணர்வு (உண்டாகிறது)"
      }
    ],
    "2.8": [
      {
        "word_idx": 0,
        "gloss_text": "உடல் (ஸ்தூல, சூட்சும, காரண)"
      },
      {
        "word_idx": 1,
        "gloss_text": "ஹவிஸ், ஆகுதி (உணர்வின் தீயில் சமர்ப்பிக்கப்படுவது)"
      }
    ],
    "2.9": [
      {
        "word_idx": 0,
        "gloss_text": "(வரம்புபட்ட, இருமை) அறிவு"
      },
      {
        "word_idx": 1,
        "gloss_text": "உணவு (உணர்வால் உண்ணப்படுவது)"
      }
    ],
    "2.10": [
      {
        "word_idx": 0,
        "gloss_text": "(தூய) ஞானம் விலகும்போது"
      },
      {
        "word_idx": 1,
        "gloss_text": "அந்த (விலகலிலிருந்து) எழும் கனவின் தரிசனம்"
      }
    ],
    "3.1": [
      {
        "word_idx": 0,
        "gloss_text": "(தனிப்பட்ட) ஆத்மா"
      },
      {
        "word_idx": 1,
        "gloss_text": "(என்பது) சித்தம் (பொருட்களில் ஈடுபட்ட மனம்)"
      }
    ],
    "3.2": [
      {
        "word_idx": 0,
        "gloss_text": "(வரம்புபட்ட) அறிவு"
      },
      {
        "word_idx": 1,
        "gloss_text": "பந்தம்"
      }
    ],
    "3.3": [
      {
        "word_idx": 0,
        "gloss_text": "கலை முதலான"
      },
      {
        "word_idx": 1,
        "gloss_text": "தத்துவங்களின்"
      },
      {
        "word_idx": 2,
        "gloss_text": "விவேகமின்மை"
      },
      {
        "word_idx": 3,
        "gloss_text": "(என்பது) மாயை"
      }
    ],
    "3.4": [
      {
        "word_idx": 0,
        "gloss_text": "உடலில் (சூட்சும மற்றும் ஸ்தூல)"
      },
      {
        "word_idx": 1,
        "gloss_text": "கரைப்பு (உண்டாகட்டும்)"
      },
      {
        "word_idx": 2,
        "gloss_text": "(வரம்புப்படுத்தும்) கலைகளின்"
      }
    ],
    "3.5": [
      {
        "word_idx": 0,
        "gloss_text": "(உயிர்) நாடிகளின் கரைப்பு"
      },
      {
        "word_idx": 1,
        "gloss_text": "பூதங்களின் மீதான வெற்றி"
      },
      {
        "word_idx": 2,
        "gloss_text": "பூதங்களிலிருந்து தனிமை/தூய்மை"
      },
      {
        "word_idx": 3,
        "gloss_text": "மற்றும் பூதங்களிலிருந்து பிரிவு"
      }
    ],
    "3.6": [
      {
        "word_idx": 0,
        "gloss_text": "மோஹத்தின் (மாயையின்) திரையால்"
      },
      {
        "word_idx": 1,
        "gloss_text": "(வெளித்தோற்ற) சித்தி (உண்டாகிறது)"
      }
    ],
    "3.7": [
      {
        "word_idx": 0,
        "gloss_text": "மோஹத்தை வென்றதன் மூலம்"
      },
      {
        "word_idx": 1,
        "gloss_text": "(உணர்வின்) எல்லையற்ற விரிவினால்"
      },
      {
        "word_idx": 2,
        "gloss_text": "இயல்பான ஞானத்தின் வெற்றி/ஆதிக்கம்"
      }
    ],
    "3.8": [
      {
        "word_idx": 0,
        "gloss_text": "(யோகியின்) விழிப்பு"
      },
      {
        "word_idx": 1,
        "gloss_text": "(என்பது) இரண்டாவது கதிர் (பொருட்களை ஒளியூட்டுவது)"
      }
    ],
    "3.9": [
      {
        "word_idx": 0,
        "gloss_text": "நடனக்காரன்"
      },
      {
        "word_idx": 1,
        "gloss_text": "ஆத்மா"
      }
    ],
    "3.10": [
      {
        "word_idx": 0,
        "gloss_text": "அரங்கம்"
      },
      {
        "word_idx": 1,
        "gloss_text": "உள் ஆத்மா (சூட்சும உடல்)"
      }
    ],
    "3.11": [
      {
        "word_idx": 0,
        "gloss_text": "(என்பது) பார்வையாளர்கள்"
      },
      {
        "word_idx": 1,
        "gloss_text": "புலன்கள்"
      }
    ],
    "3.12": [
      {
        "word_idx": 0,
        "gloss_text": "(ஒளிபெற்ற) புத்தியின் வலிமையால்"
      },
      {
        "word_idx": 1,
        "gloss_text": "(தனது உண்மை) இருப்பின் வெளிப்பாடு"
      }
    ],
    "3.13": [
      {
        "word_idx": 0,
        "gloss_text": "(என்பது) சித்திக்கப்பட்டது"
      },
      {
        "word_idx": 1,
        "gloss_text": "ஸ்வதந்திர (சுதந்திர) நிலை"
      }
    ],
    "3.14": [
      {
        "word_idx": 0,
        "gloss_text": "எவ்வாறு"
      },
      {
        "word_idx": 1,
        "gloss_text": "அங்கே (தனது உடலில்)"
      },
      {
        "word_idx": 2,
        "gloss_text": "அவ்வாறே"
      },
      {
        "word_idx": 3,
        "gloss_text": "மற்ற இடத்திலும் (வேறு எந்த உடலிலும்)"
      }
    ],
    "3.15": [
      {
        "word_idx": 0,
        "gloss_text": "பீஜத்தின் மீது கவனம்/ஒருநிலைப்படுதல் (அனைத்தின் மூலமாகிய பரம சக்தி)"
      }
    ],
    "3.16": [
      {
        "word_idx": 0,
        "gloss_text": "(உண்மை) ஆசனத்தில் நிலைபெற்றவன் (சக்தி தங்குமிடமாக)"
      },
      {
        "word_idx": 1,
        "gloss_text": "சுகமாக, ஆனந்தத்துடன்"
      },
      {
        "word_idx": 2,
        "gloss_text": "(பரம உணர்வின்) ஏரியில்"
      },
      {
        "word_idx": 3,
        "gloss_text": "ஆழ்ந்து மூழ்குகிறான்"
      }
    ],
    "3.17": [
      {
        "word_idx": 0,
        "gloss_text": "தனது (உணர்வின்) அளவிற்கு ஏற்ப சிருஷ்டி"
      },
      {
        "word_idx": 1,
        "gloss_text": "உண்டாக்குகிறான்"
      }
    ],
    "3.18": [
      {
        "word_idx": 0,
        "gloss_text": "(தூய) ஞானம் அழியாதபோது"
      },
      {
        "word_idx": 1,
        "gloss_text": "(மேலும்) பிறப்பின் அழிவு"
      }
    ],
    "3.19": [
      {
        "word_idx": 0,
        "gloss_text": "க முதலான மெய்யெழுத்து வகுப்புகளில்"
      },
      {
        "word_idx": 1,
        "gloss_text": "மாஹேஸ்வரி முதலான (சக்திகள்)"
      },
      {
        "word_idx": 2,
        "gloss_text": "(என்பவர்கள்) பசுவின் (கட்டப்பட்ட ஜீவனின்) தாய்மார்கள்"
      }
    ],
    "3.20": [
      {
        "word_idx": 0,
        "gloss_text": "மூன்று (நிலைகளில்: விழிப்பு, கனவு, ஆழ்ந்த உறக்கம்)"
      },
      {
        "word_idx": 1,
        "gloss_text": "நான்காவது (துரியம்)"
      },
      {
        "word_idx": 2,
        "gloss_text": "எண்ணெய் போல்"
      },
      {
        "word_idx": 3,
        "gloss_text": "ஊற்றப்பட/ஊடுருவப்பட வேண்டியது"
      }
    ],
    "3.21": [
      {
        "word_idx": 0,
        "gloss_text": "ஆழ்ந்தவன் (தனது ஆத்மாவில்)"
      },
      {
        "word_idx": 1,
        "gloss_text": "தனது (தூய்மைப்பட்ட) சித்தத்தால்"
      },
      {
        "word_idx": 2,
        "gloss_text": "(இதயத்தில்) நுழையட்டும்"
      }
    ],
    "3.22": [
      {
        "word_idx": 0,
        "gloss_text": "பிராணன் (மெதுவாக, சமமாக) ஓடும்போது"
      },
      {
        "word_idx": 1,
        "gloss_text": "சம தர்சனம் (அனைத்தின் மீதான சம பார்வை)"
      }
    ],
    "3.23": [
      {
        "word_idx": 0,
        "gloss_text": "நடு நிலையில் (துரியத்திற்கும் மற்றொரு நிலைக்கும் இடையில்)"
      },
      {
        "word_idx": 1,
        "gloss_text": "தாழ்ந்த (நிலையின்) உற்பத்தி"
      }
    ],
    "3.24": [
      {
        "word_idx": 0,
        "gloss_text": "(தனது) பொருள்-அனுபவ அளவீடுகளின் கருத்துடன் இணைப்பில்"
      },
      {
        "word_idx": 1,
        "gloss_text": "இழந்த (துரிய நிலையின்)"
      },
      {
        "word_idx": 2,
        "gloss_text": "மறு எழுச்சி"
      }
    ],
    "3.25": [
      {
        "word_idx": 0,
        "gloss_text": "சிவனுக்குச் சமமான"
      },
      {
        "word_idx": 1,
        "gloss_text": "(அவன்) ஆகிறான்"
      }
    ],
    "3.26": [
      {
        "word_idx": 0,
        "gloss_text": "உடலின் பராமரிப்பு/நடவடிக்கை"
      },
      {
        "word_idx": 1,
        "gloss_text": "(என்பது அவனது) விரதம்"
      }
    ],
    "3.27": [
      {
        "word_idx": 0,
        "gloss_text": "பேச்சு (யோகியின் சொல்)"
      },
      {
        "word_idx": 1,
        "gloss_text": "ஜபமாகிறது (மந்திர பாராயணம்)"
      }
    ],
    "3.28": [
      {
        "word_idx": 0,
        "gloss_text": "(அவனது) தானம் (பிறருக்குக் கொடுப்பது)"
      },
      {
        "word_idx": 1,
        "gloss_text": "ஆத்ம ஞானம்"
      }
    ],
    "3.29": [
      {
        "word_idx": 0,
        "gloss_text": "எவன்"
      },
      {
        "word_idx": 1,
        "gloss_text": "(புலன்) கூட்டத்தைப் பாதுகாப்பதில் நிலைபெற்றவன் (புலன்களின் தலைவன்)"
      },
      {
        "word_idx": 2,
        "gloss_text": "(ஆத்ம) ஞானத்திற்குக் காரணம்"
      },
      {
        "word_idx": 3,
        "gloss_text": "மற்றும்"
      }
    ],
    "3.30": [
      {
        "word_idx": 0,
        "gloss_text": "தனது சக்திகளின் விரிவு/குவிப்பு"
      },
      {
        "word_idx": 1,
        "gloss_text": "அவனுக்கு"
      },
      {
        "word_idx": 2,
        "gloss_text": "(என்பது) பிரபஞ்சம்"
      }
    ],
    "3.31": [
      {
        "word_idx": 0,
        "gloss_text": "(அதன்) நிலையும் கரைப்பும் (இரண்டும், அவனது சக்தி விரிவே)"
      }
    ],
    "3.32": [
      {
        "word_idx": 0,
        "gloss_text": "அந்த (வெளிப்பாடு/கரைப்பு) நடக்கும்போதும்"
      },
      {
        "word_idx": 1,
        "gloss_text": "கூட"
      },
      {
        "word_idx": 2,
        "gloss_text": "(அவனது உண்மை இயல்பின்) இழப்பு இல்லை"
      },
      {
        "word_idx": 3,
        "gloss_text": "(தூய) அறிபவனாக இருப்பதால்"
      }
    ],
    "3.33": [
      {
        "word_idx": 0,
        "gloss_text": "சுகம்-துக்கங்களின்"
      },
      {
        "word_idx": 1,
        "gloss_text": "(அவற்றை) வெளியில் உள்ளதாகக் கருதுதல்"
      }
    ],
    "3.34": [
      {
        "word_idx": 0,
        "gloss_text": "அவற்றிலிருந்து விடுபட்டவன்"
      },
      {
        "word_idx": 1,
        "gloss_text": "உண்மையில்"
      },
      {
        "word_idx": 2,
        "gloss_text": "(அவன்) கேவலி (தனித்த, பிரித்த ஒருவன்)"
      }
    ],
    "3.35": [
      {
        "word_idx": 0,
        "gloss_text": "மோஹத்துடன் ஒன்றியவன்"
      },
      {
        "word_idx": 1,
        "gloss_text": "ஆனால்"
      },
      {
        "word_idx": 2,
        "gloss_text": "(அவன்) கர்மத்திற்கும் (அதன் பலன்களுக்கும்) கட்டுப்பட்ட ஆத்மா"
      }
    ],
    "3.36": [
      {
        "word_idx": 0,
        "gloss_text": "வேறுபாடு அகற்றப்படும்போது"
      },
      {
        "word_idx": 1,
        "gloss_text": "(எழுகிறது) மற்றொரு சிருஷ்டியை உண்டாக்கும் ஆற்றல்"
      }
    ],
    "3.37": [
      {
        "word_idx": 0,
        "gloss_text": "செயற்படுத்தும் சக்தி/கரண சக்தி"
      },
      {
        "word_idx": 1,
        "gloss_text": "தன்னிலிருந்தே"
      },
      {
        "word_idx": 2,
        "gloss_text": "(நேரடி) அனுபவத்திலிருந்து"
      }
    ],
    "3.38": [
      {
        "word_idx": 0,
        "gloss_text": "மூன்று நிலைகளும் (விழிப்பு, கனவு, உறக்கம்) தொடர்ந்து வருபவையும் முதன்மையான (துரியத்தால்) உயிர்ப்பிக்கப்படுகின்றன"
      }
    ],
    "3.39": [
      {
        "word_idx": 0,
        "gloss_text": "(ஒருநிலைப்பட்ட) சித்தத்தின் நிலையில் போலவே"
      },
      {
        "word_idx": 1,
        "gloss_text": "உடல், புலன்கள், வெளிப் (பொருட்களில்)"
      }
    ],
    "3.40": [
      {
        "word_idx": 0,
        "gloss_text": "ஆசை/ஏக்கத்திலிருந்து"
      },
      {
        "word_idx": 1,
        "gloss_text": "வெளி நோக்கிய இயக்கம்"
      },
      {
        "word_idx": 2,
        "gloss_text": "(சம்சாரத்தால்) இழுத்துச் செல்லப்படுபவனின், மயங்கிய ஆத்மாவின்"
      }
    ],
    "3.41": [
      {
        "word_idx": 0,
        "gloss_text": "அதில் (ஆத்மாவில்) நிலையாக நிலைபெற்ற அறிவுடையவனின்"
      },
      {
        "word_idx": 1,
        "gloss_text": "அந்த (ஆசையின்) அழிவால்"
      },
      {
        "word_idx": 2,
        "gloss_text": "(வரம்புபட்ட) ஜீவ நிலையின் அழிவு"
      }
    ],
    "3.42": [
      {
        "word_idx": 0,
        "gloss_text": "பூதங்களை (மட்டும்) வெளி உடையாகக் கொண்டவன்"
      },
      {
        "word_idx": 1,
        "gloss_text": "அப்போது"
      },
      {
        "word_idx": 2,
        "gloss_text": "விடுபட்டவன்"
      },
      {
        "word_idx": 3,
        "gloss_text": "அதன்பின்"
      },
      {
        "word_idx": 4,
        "gloss_text": "இறைவனுக்குச் சமம்"
      },
      {
        "word_idx": 5,
        "gloss_text": "பரமன்"
      }
    ],
    "3.43": [
      {
        "word_idx": 0,
        "gloss_text": "இயல்பான, உள்ளார்ந்த"
      },
      {
        "word_idx": 1,
        "gloss_text": "(என்பது) பிராணனுடனான தொடர்பு"
      }
    ],
    "3.44": [
      {
        "word_idx": 0,
        "gloss_text": "மூக்கின் உள்-நடுவில் சம்யமத்தால் (சுவாசத்தின் மையம்)"
      },
      {
        "word_idx": 1,
        "gloss_text": "இங்கு என்ன (தேவை)"
      },
      {
        "word_idx": 2,
        "gloss_text": "இடா, பிங்கலா, சுஷும்னா நாடிகளில் (கவலை கொள்ள)"
      }
    ],
    "3.45": [
      {
        "word_idx": 0,
        "gloss_text": "மீண்டும் மீண்டும்"
      },
      {
        "word_idx": 1,
        "gloss_text": "இருக்கட்டும்"
      },
      {
        "word_idx": 2,
        "gloss_text": "பிரதிமீலனம் (உள் மற்றும் வெளி நோக்கி பார்வையைத் திருப்புதல், எங்கும் சிவனை அறிதல்)"
      }
    ]
  }
}
