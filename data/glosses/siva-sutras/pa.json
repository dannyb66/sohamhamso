  "verses": {
    "1.1": [
      {
        "word_idx": 0,
        "gloss_text": "ਸ਼ੁੱਧ ਚੇਤਨਾ, ਚੈਤਨਯ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਆਤਮਾ, ਅਸਲੀ ਸਰੂਪ"
      }
    ],
    "1.2": [
      {
        "word_idx": 0,
        "gloss_text": "(ਸੀਮਿਤ, ਦਵੈਤਮਈ) ਗਿਆਨ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਬੰਧਨ"
      }
    ],
    "1.3": [
      {
        "word_idx": 0,
        "gloss_text": "ਸ਼੍ਰੇਣੀਆਂ ਦਾ ਮੂਲ-ਸਮੂਹ (ਮਾਇਆ ਪ੍ਰਪੰਚ ਦੀ ਕੁੱਖ ਵਜੋਂ)"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਕਲਾਵਾਂ (ਸੀਮਿਤ ਕਾਰਜ-ਫੇਜ਼ਾਂ) ਨਾਲ ਬਣਿਆ ਸਰੀਰ"
      }
    ],
    "1.4": [
      {
        "word_idx": 0,
        "gloss_text": "(ਸੀਮਿਤ) ਗਿਆਨ ਦਾ ਆਧਾਰ/ਅਧਿਸ਼ਠਾਨ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਮਾਤ੍ਰਿਕਾ — (ਅਣ-ਸਮਝੀ) ਅੱਖਰ-ਮਾਤਾ, ਧੁਨੀਆਂ ਦੀ ਮਾਤ੍ਰਿਕਾ"
      }
    ],
    "1.5": [
      {
        "word_idx": 0,
        "gloss_text": "(ਚੇਤਨਾ ਦਾ) ਅਚਾਨਕ ਉਦੈ/ਉਛਾਲ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਭੈਰਵ, ਪਰਮ ਸ਼ਿਵ"
      }
    ],
    "1.6": [
      {
        "word_idx": 0,
        "gloss_text": "(ਚੇਤਨਾ ਦੀਆਂ) ਸ਼ਕਤੀਆਂ ਦੇ ਚੱਕਰ ਨਾਲ ਮਿਲਾਪ ਹੋਣ ਉੱਤੇ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਵਿਸ਼ਵ (ਵੱਖਰੇ ਵਜੋਂ) ਦਾ ਲੈ/ਸੰਹਾਰ"
      }
    ],
    "1.7": [
      {
        "word_idx": 0,
        "gloss_text": "ਜਾਗ੍ਰਤ, ਸੁਪਨ ਅਤੇ ਸੁਸ਼ੁਪਤੀ ਦੇ ਭੇਦ ਵਿਚ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਤੁਰੀਆ ਦੇ ਆਨੰਦ-ਵਿਸਤਾਰ ਦਾ ਉਪਜਣਾ"
      }
    ],
    "1.8": [
      {
        "word_idx": 0,
        "gloss_text": "(ਅਨੁਭਵਾਤਮਿਕ) ਗਿਆਨ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਜਾਗ੍ਰਤ-ਅਵਸਥਾ"
      }
    ],
    "1.9": [
      {
        "word_idx": 0,
        "gloss_text": "ਸੁਪਨ-ਅਵਸਥਾ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਮਾਨਸਿਕ ਕਲਪਨਾਵਾਂ, ਵਿਕਲਪ"
      }
    ],
    "1.10": [
      {
        "word_idx": 0,
        "gloss_text": "ਅਵਿਵੇਕ, ਨਿਖੇੜੇ ਦੀ ਘਾਟ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਮਾਇਆ ਦੀ ਸੁਸ਼ੁਪਤੀ (ਮਾਇਆ-ਜਨਿਤ ਅਚੇਤਨਾ)"
      }
    ],
    "1.11": [
      {
        "word_idx": 0,
        "gloss_text": "(ਜਾਗ੍ਰਤ-ਸੁਪਨ-ਸੁਸ਼ੁਪਤੀ) ਤਿੰਨਾਂ ਦਾ ਭੋਗੀ"
      },
      {
        "word_idx": 1,
        "gloss_text": "(ਇੰਦਰੀ-)ਵੀਰਾਂ ਦਾ ਈਸ਼ਵਰ, ਇੰਦਰੀਆਂ ਦਾ ਸੁਆਮੀ"
      }
    ],
    "1.12": [
      {
        "word_idx": 0,
        "gloss_text": "ਵਿਸਮਯ, ਅਚੰਭਾ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਯੋਗ ਦੀਆਂ ਭੂਮੀਆਂ/ਪੜਾਅ"
      }
    ],
    "1.13": [
      {
        "word_idx": 0,
        "gloss_text": "ਇੱਛਾ-ਸ਼ਕਤੀ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਉਮਾ (ਦੇਵੀ; ਇੱਥੇ ਪਰਮ ਸੰਕਲਪ)"
      },
      {
        "word_idx": 2,
        "gloss_text": "ਕੁਆਰੀ ਕੰਨਿਆ (ਅਮਿਸ਼੍ਰਿਤ, ਗੌਣ ਉਦੇਸ਼ਾਂ ਤੋਂ ਮੁਕਤ)"
      }
    ],
    "1.14": [
      {
        "word_idx": 0,
        "gloss_text": "(ਸਾਰਾ) ਦ੍ਰਿਸ਼ਟਮਾਨ/ਪ੍ਰਤੀਤ-ਯੋਗ"
      },
      {
        "word_idx": 1,
        "gloss_text": "(ਉਸਦਾ) ਸਰੀਰ"
      }
    ],
    "1.15": [
      {
        "word_idx": 0,
        "gloss_text": "ਹਿਰਦੇ ਵਿਚ (ਚੇਤਨਾ ਦਾ ਕੇਂਦਰ)"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਚਿੱਤ ਦੇ ਮਿਲਾਪ/ਇਕਾਗਰਤਾ ਨਾਲ"
      },
      {
        "word_idx": 2,
        "gloss_text": "ਦ੍ਰਿਸ਼ਟਮਾਨ ਦੇ ਲੋਪ ਦਾ ਦਰਸ਼ਨ"
      }
    ],
    "1.16": [
      {
        "word_idx": 0,
        "gloss_text": "ਸ਼ੁੱਧ ਤੱਤ ਨਾਲ (ਨਿਰੰਤਰ) ਮਿਲਾਪ ਤੋਂ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਜਾਂ (ਬਦਲਵੇਂ ਤੌਰ ਉੱਤੇ)"
      },
      {
        "word_idx": 2,
        "gloss_text": "ਪਸ਼ੂ-ਭਾਵ (ਬੱਝੇ ਜੀਵ) ਤੋਂ ਮੁਕਤ ਕਰਨ ਵਾਲੀ ਸ਼ਕਤੀ"
      }
    ],
    "1.17": [
      {
        "word_idx": 0,
        "gloss_text": "(ਦ੍ਰਿੜ੍ਹ) ਪ੍ਰਤਯਭਿਜ੍ਞਾ-ਸੂਚਕ ਜਾਣਕਾਰੀ, ਚਿੰਤਨਾਤਮਕ ਨਿਸ਼ਚਯ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਆਤਮ-ਗਿਆਨ"
      }
    ],
    "1.18": [
      {
        "word_idx": 0,
        "gloss_text": "ਸੰਸਾਰ (ਨੂੰ ਦੇਖਣ) ਦਾ ਆਨੰਦ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਸਮਾਧੀ ਦਾ ਸੁਖ"
      }
    ],
    "1.19": [
      {
        "word_idx": 0,
        "gloss_text": "(ਦਿਵਯ) ਸ਼ਕਤੀ ਨਾਲ ਮਿਲਾਪ ਉੱਤੇ"
      },
      {
        "word_idx": 1,
        "gloss_text": "(ਮਨ-ਚਾਹੇ) ਸਰੀਰ ਦੀ ਉਤਪੱਤੀ"
      }
    ],
    "1.20": [
      {
        "word_idx": 0,
        "gloss_text": "ਭੂਤਾਂ ਨੂੰ (ਉਨ੍ਹਾਂ ਦੇ ਤੱਤ ਨਾਲ) ਜੋੜਨਾ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਭੂਤਾਂ ਨੂੰ (ਰੋਗ ਆਦਿ ਤੋਂ) ਵੱਖ ਕਰਨਾ"
      },
      {
        "word_idx": 2,
        "gloss_text": "ਅਤੇ ਵਿਸ਼ਵ (ਦੇ ਭਾਗਾਂ) ਨੂੰ ਜੋੜਨਾ (= ਸਿੱਧੀਆਂ)"
      }
    ],
    "1.21": [
      {
        "word_idx": 0,
        "gloss_text": "ਸ਼ੁੱਧ-ਵਿਦਿਆ ਦੇ ਉਦੈ ਤੋਂ"
      },
      {
        "word_idx": 1,
        "gloss_text": "(ਸ਼ਕਤੀਆਂ ਦੇ) ਚੱਕਰ ਉੱਤੇ ਈਸ਼ਵਰਤਾ ਦੀ ਪ੍ਰਾਪਤੀ"
      }
    ],
    "1.22": [
      {
        "word_idx": 0,
        "gloss_text": "ਮਹਾ-ਹ੍ਰਦ (ਪਰਮ ਚੇਤਨਾ ਦੀ ਮਹਾਨ ਝੀਲ) ਨਾਲ ਨਿਰੰਤਰ ਮਿਲਾਪ ਤੋਂ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਮੰਤਰ ਦੀ ਵੀਰਜ-ਸ਼ਕਤੀ ਦਾ ਅਨੁਭਵ"
      }
    ],
    "2.1": [
      {
        "word_idx": 0,
        "gloss_text": "ਚਿੱਤ (ਪਰਮ ਅਸਲੀਅਤ ਵੱਲ ਮੁੜਿਆ)"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਮੰਤਰ"
      }
    ],
    "2.2": [
      {
        "word_idx": 0,
        "gloss_text": "ਸੁਤੈ-ਸੁਭਾਅ, ਤੀਬਰ ਯਤਨ (ਆਤਮਾ ਵੱਲ)"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਸਾਧਕ, ਉਹ ਜੋ (ਲਕਸ਼) ਨੂੰ ਸਿੱਧ ਕਰਦਾ ਹੈ"
      }
    ],
    "2.3": [
      {
        "word_idx": 0,
        "gloss_text": "ਉਹ ਹਸਤੀ ਜਿਸਦਾ ਸਰੀਰ (ਸ਼ੁੱਧ) ਵਿਦਿਆ ਹੈ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਮੰਤਰ ਦਾ ਰਹੱਸ"
      }
    ],
    "2.4": [
      {
        "word_idx": 0,
        "gloss_text": "(ਮਾਇਆ ਦੀ) ਕੁੱਖ ਵਿਚ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਚਿੱਤ ਦਾ ਵਿਕਾਸ (ਨੀਚੇ ਆਨੰਦ ਵਿਚ)"
      },
      {
        "word_idx": 2,
        "gloss_text": "(ਕੇਵਲ) ਅਵਿਸ਼ਿਸ਼ਟ (ਨੀਚ) ਵਿਦਿਆ ਦਾ ਸੁਪਨਾ ਹੈ"
      }
    ],
    "2.5": [
      {
        "word_idx": 0,
        "gloss_text": "(ਸ਼ੁੱਧ) ਵਿਦਿਆ ਦੇ ਉਦੈ ਉੱਤੇ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਸੁਤੈ-ਸੁਭਾਅ, ਸਹਿਜ"
      },
      {
        "word_idx": 2,
        "gloss_text": "ਖੇਚਰੀ (ਚੇਤਨਾ ਦੇ ਆਕਾਸ਼ ਵਿਚ ਚਾਲ)"
      },
      {
        "word_idx": 3,
        "gloss_text": "ਸ਼ਿਵ ਦੀ ਅਵਸਥਾ"
      }
    ],
    "2.6": [
      {
        "word_idx": 0,
        "gloss_text": "ਗੁਰੂ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਉਪਾਯ, ਸਾਧਨ"
      }
    ],
    "2.7": [
      {
        "word_idx": 0,
        "gloss_text": "ਮਾਤ੍ਰਿਕਾ ਦਾ ਚੱਕਰ (ਅੱਖਰ-ਦੇਵੀ)"
      },
      {
        "word_idx": 1,
        "gloss_text": "(ਆਉਂਦਾ ਹੈ) ਪੂਰਨ ਬੋਧ"
      }
    ],
    "2.8": [
      {
        "word_idx": 0,
        "gloss_text": "ਸਰੀਰ (ਸਥੂਲ, ਸੂਖਮ, ਕਾਰਣ)"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਹਵਿ (ਚੇਤਨਾ ਦੀ ਅੱਗ ਵਿਚ ਪਾਈ ਆਹੁਤੀ)"
      }
    ],
    "2.9": [
      {
        "word_idx": 0,
        "gloss_text": "(ਸੀਮਿਤ, ਦਵੈਤਮਈ) ਗਿਆਨ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਅੰਨ (ਚੇਤਨਾ ਦੁਆਰਾ ਖਾਧਾ ਜਾਣ ਵਾਲਾ)"
      }
    ],
    "2.10": [
      {
        "word_idx": 0,
        "gloss_text": "(ਸ਼ੁੱਧ) ਵਿਦਿਆ ਦੇ ਸੰਹਾਰ ਉੱਤੇ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਉਸ (ਸੰਹਾਰ) ਤੋਂ ਉੱਠੇ ਸੁਪਨੇ ਦਾ ਦਰਸ਼ਨ"
      }
    ],
    "3.1": [
      {
        "word_idx": 0,
        "gloss_text": "(ਵਿਅਕਤੀਗਤ) ਆਤਮਾ"
      },
      {
        "word_idx": 1,
        "gloss_text": "(ਹੈ) ਚਿੱਤ (ਪਦਾਰਥਾਂ ਨਾਲ ਜੁੜਿਆ)"
      }
    ],
    "3.2": [
      {
        "word_idx": 0,
        "gloss_text": "(ਸੀਮਿਤ) ਗਿਆਨ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਬੰਧਨ"
      }
    ],
    "3.3": [
      {
        "word_idx": 0,
        "gloss_text": "ਕਲਾ ਆਦਿ ਤੱਤਾਂ ਦਾ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਸਿਧਾਂਤਾਂ/ਤੱਤਾਂ ਦਾ"
      },
      {
        "word_idx": 2,
        "gloss_text": "ਅਣ-ਨਿਖੇੜਾ, ਅਵਿਵੇਕ"
      },
      {
        "word_idx": 3,
        "gloss_text": "(ਹੈ) ਮਾਇਆ"
      }
    ],
    "3.4": [
      {
        "word_idx": 0,
        "gloss_text": "ਸਰੀਰ ਵਿਚ (ਸੂਖਮ ਅਤੇ ਸਥੂਲ)"
      },
      {
        "word_idx": 1,
        "gloss_text": "(ਹੋਵੇ) ਸੰਹਾਰ/ਲੈ"
      },
      {
        "word_idx": 2,
        "gloss_text": "ਕਲਾਵਾਂ/ਸੀਮਾ-ਸਿਧਾਂਤਾਂ ਦਾ"
      }
    ],
    "3.5": [
      {
        "word_idx": 0,
        "gloss_text": "(ਪ੍ਰਾਣ-)ਨਾੜੀਆਂ ਦਾ ਸੰਹਾਰ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਭੂਤਾਂ ਉੱਤੇ ਜੈ"
      },
      {
        "word_idx": 2,
        "gloss_text": "ਭੂਤਾਂ ਤੋਂ ਕੈਵਲਯ/ਨਿਰਲੇਪਤਾ"
      },
      {
        "word_idx": 3,
        "gloss_text": "ਅਤੇ ਭੂਤਾਂ ਤੋਂ ਪ੍ਰਿਥਕਤਾ"
      }
    ],
    "3.6": [
      {
        "word_idx": 0,
        "gloss_text": "ਮੋਹ ਦੇ ਪਰਦੇ ਤੋਂ"
      },
      {
        "word_idx": 1,
        "gloss_text": "(ਆਉਂਦੀ ਹੈ ਪ੍ਰਤੀਤ ਹੋਣ ਵਾਲੀ) ਸਿੱਧੀ"
      }
    ],
    "3.7": [
      {
        "word_idx": 0,
        "gloss_text": "ਮੋਹ ਉੱਤੇ ਜੈ ਤੋਂ"
      },
      {
        "word_idx": 1,
        "gloss_text": "(ਚੇਤਨਾ ਦੇ) ਅਨੰਤ ਵਿਸਤਾਰ ਤੋਂ"
      },
      {
        "word_idx": 2,
        "gloss_text": "ਸਹਿਜ-ਵਿਦਿਆ (ਅੰਤਰੀਵ ਗਿਆਨ) ਉੱਤੇ ਜੈ"
      }
    ],
    "3.8": [
      {
        "word_idx": 0,
        "gloss_text": "(ਯੋਗੀ ਦੀ) ਜਾਗ੍ਰਤ-ਅਵਸਥਾ"
      },
      {
        "word_idx": 1,
        "gloss_text": "(ਹੈ) ਦੂਜੀ ਕਿਰਨ (ਪਦਾਰਥਾਂ ਨੂੰ ਪ੍ਰਕਾਸ਼ਿਤ ਕਰਨ ਵਾਲੀ)"
      }
    ],
    "3.9": [
      {
        "word_idx": 0,
        "gloss_text": "ਨਚਾਰ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਆਤਮਾ"
      }
    ],
    "3.10": [
      {
        "word_idx": 0,
        "gloss_text": "ਰੰਗ-ਮੰਚ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਅੰਤਰ-ਆਤਮਾ (ਸੂਖਮ ਸਰੀਰ)"
      }
    ],
    "3.11": [
      {
        "word_idx": 0,
        "gloss_text": "(ਹਨ) ਦਰਸ਼ਕ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਇੰਦਰੀਆਂ"
      }
    ],
    "3.12": [
      {
        "word_idx": 0,
        "gloss_text": "(ਪ੍ਰਕਾਸ਼ਿਤ) ਬੁੱਧੀ ਦੇ ਬਲ ਨਾਲ"
      },
      {
        "word_idx": 1,
        "gloss_text": "(ਆਪਣੀ ਅਸਲੀ) ਹੋਂਦ ਦੀ ਸਿੱਧੀ"
      }
    ],
    "3.13": [
      {
        "word_idx": 0,
        "gloss_text": "(ਹੈ) ਸਿੱਧ"
      },
      {
        "word_idx": 1,
        "gloss_text": "(ਪੂਰਨ) ਸੁਤੰਤਰਤਾ ਦੀ ਅਵਸਥਾ"
      }
    ],
    "3.14": [
      {
        "word_idx": 0,
        "gloss_text": "ਜਿਵੇਂ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ਉੱਥੇ (ਆਪਣੇ ਸਰੀਰ ਵਿਚ)"
      },
      {
        "word_idx": 2,
        "gloss_text": "ਉਸੇ ਤਰ੍ਹਾਂ"
      },
