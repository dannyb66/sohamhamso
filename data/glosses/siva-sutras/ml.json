  "verses": {
    "1.1": [
      {
        "word_idx": 0,
        "gloss_text": "ശുദ്ധബോധം, ചൈതന്യം"
      },
      {
        "word_idx": 1,
        "gloss_text": "ആത്മാവ്, യഥാർത്ഥ സ്വരൂപം"
      }
    ],
    "1.2": [
      {
        "word_idx": 0,
        "gloss_text": "(പരിമിതവും ദ്വൈതാത്മകവുമായ) ജ്ഞാനം"
      },
      {
        "word_idx": 1,
        "gloss_text": "ബന്ധനം"
      }
    ],
    "1.3": [
      {
        "word_idx": 0,
        "gloss_text": "തത്ത്വങ്ങളുടെ ഉത്ഭവസ്ഥാനസമൂഹം (പ്രപഞ്ചപ്രസവിനിയായ മായ)"
      },
      {
        "word_idx": 1,
        "gloss_text": "കലകളാൽ (പ്രവർത്തനത്തിന്റെ പരിമിതഘട്ടങ്ങളാൽ) നിർമ്മിത ശരീരം"
      }
    ],
    "1.4": [
      {
        "word_idx": 0,
        "gloss_text": "(പരിമിത) ജ്ഞാനത്തിന്റെ അധിഷ്ഠാനം/ആധാരം"
      },
      {
        "word_idx": 1,
        "gloss_text": "(അജ്ഞാതയായ) മാതാവ് — വർണ്ണ/അക്ഷരമാതൃക"
      }
    ],
    "1.5": [
      {
        "word_idx": 0,
        "gloss_text": "ബോധത്തിന്റെ അകസ്മാത്തായ ഉദയം/ഉത്ഥാനം"
      },
      {
        "word_idx": 1,
        "gloss_text": "ഭൈരവൻ, പരമശിവൻ"
      }
    ],
    "1.6": [
      {
        "word_idx": 0,
        "gloss_text": "ശക്തിചക്രവുമായുള്ള ഏകീഭാവത്തിൽ"
      },
      {
        "word_idx": 1,
        "gloss_text": "(വസ്തുരൂപമായ) വിശ്വത്തിന്റെ ലയം"
      }
    ],
    "1.7": [
      {
        "word_idx": 0,
        "gloss_text": "ജാഗ്രത്-സ്വപ്ന-സുഷുപ്തി ഭേദത്തിൽ"
      },
      {
        "word_idx": 1,
        "gloss_text": "തുര്യത്തിന്റെ ആനന്ദത്തിന്റെ/വികാസത്തിന്റെ ഉദയം"
      }
    ],
    "1.8": [
      {
        "word_idx": 0,
        "gloss_text": "(ലൗകിക/അനുഭവ) ജ്ഞാനം"
      },
      {
        "word_idx": 1,
        "gloss_text": "ജാഗ്രദവസ്ഥ"
      }
    ],
    "1.9": [
      {
        "word_idx": 0,
        "gloss_text": "സ്വപ്നാവസ്ഥ"
      },
      {
        "word_idx": 1,
        "gloss_text": "വികല്പങ്ങൾ, മാനസിക സങ്കല്പങ്ങൾ"
      }
    ],
    "1.10": [
      {
        "word_idx": 0,
        "gloss_text": "അവിവേകം, വിവേചനരാഹിത്യം"
      },
      {
        "word_idx": 1,
        "gloss_text": "മായയുടെ സുഷുപ്തി (മായാജന്യമായ ബോധശൂന്യത)"
      }
    ],
    "1.11": [
      {
        "word_idx": 0,
        "gloss_text": "ത്രയത്തിന്റെ (ജാഗ്രത്-സ്വപ്ന-സുഷുപ്തി) ഭോക്താവ്"
      },
      {
        "word_idx": 1,
        "gloss_text": "(ഇന്ദ്രിയ)വീരന്മാരുടെ ഈശൻ, ഇന്ദ്രിയങ്ങളുടെ പ്രഭു"
      }
    ],
    "1.12": [
      {
        "word_idx": 0,
        "gloss_text": "വിസ്മയം, അദ്ഭുതം"
      },
      {
        "word_idx": 1,
        "gloss_text": "യോഗത്തിന്റെ ഭൂമികകൾ"
      }
    ],
    "1.13": [
      {
        "word_idx": 0,
        "gloss_text": "ഇച്ഛാശക്തി"
      },
      {
        "word_idx": 1,
        "gloss_text": "ഉമ (ദേവി; ഇവിടെ പരമമായ ഇച്ഛ)"
      },
      {
        "word_idx": 2,
        "gloss_text": "കുമാരി, കന്യക (അനന്യാശ്രയ, ഗൗണലക്ഷ്യങ്ങളിൽ നിന്ന് മുക്ത)"
      }
    ],
    "1.14": [
      {
        "word_idx": 0,
        "gloss_text": "(സകല) ദൃശ്യം/ഗ്രാഹ്യം"
      },
      {
        "word_idx": 1,
        "gloss_text": "(അവന്റെ) ശരീരം"
      }
    ],
    "1.15": [
      {
        "word_idx": 0,
        "gloss_text": "ഹൃദയത്തിൽ (ബോധത്തിന്റെ കേന്ദ്രത്തിൽ)"
      },
      {
        "word_idx": 1,
        "gloss_text": "ചിത്തത്തിന്റെ ഏകീകരണത്താൽ/ഏകാഗ്രതയാൽ"
      },
      {
        "word_idx": 2,
        "gloss_text": "ദൃശ്യത്തിന്റെ തിരോഭാവദർശനം"
      }
    ],
    "1.16": [
      {
        "word_idx": 0,
        "gloss_text": "ശുദ്ധതത്ത്വവുമായുള്ള (നിരന്തര) സന്ധാനത്താൽ"
      },
      {
        "word_idx": 1,
        "gloss_text": "അല്ലെങ്കിൽ"
      },
      {
        "word_idx": 2,
        "gloss_text": "പശുഭാവത്തിൽ (ബദ്ധജീവ-അവസ്ഥയിൽ) നിന്ന് മോചിപ്പിക്കുന്ന ശക്തി"
      }
    ],
    "1.17": [
      {
        "word_idx": 0,
        "gloss_text": "(ദൃഢമായ) വിതർക്കം, പ്രത്യഭിജ്ഞാജ്ഞാനം, പ്രതിഫലനനിശ്ചയം"
      },
      {
        "word_idx": 1,
        "gloss_text": "ആത്മജ്ഞാനം"
      }
    ],
    "1.18": [
      {
        "word_idx": 0,
        "gloss_text": "ലോകത്തിന്റെ (ദർശനത്തിന്റെ) ആനന്ദം"
      },
      {
        "word_idx": 1,
        "gloss_text": "സമാധിയുടെ സുഖം"
      }
    ],
    "1.19": [
      {
        "word_idx": 0,
        "gloss_text": "(ദിവ്യ) ശക്തിയുമായുള്ള സന്ധാനത്തിൽ"
      },
      {
        "word_idx": 1,
        "gloss_text": "(ഇച്ഛാനുസരണമുള്ള) ശരീരത്തിന്റെ ഉത്പത്തി"
      }
    ],
    "1.20": [
      {
        "word_idx": 0,
        "gloss_text": "ഭൂതങ്ങളെ (അവയുടെ സത്തയോട്) സന്ധാനം ചെയ്യൽ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ഭൂതങ്ങളെ (രോഗാദികളിൽ നിന്ന്) വേർപെടുത്തൽ"
      },
      {
        "word_idx": 2,
        "gloss_text": "വിശ്വത്തിന്റെ (അംശങ്ങളുടെ) സന്ധാനങ്ങൾ (=സിദ്ധികൾ)"
      }
    ],
    "1.21": [
      {
        "word_idx": 0,
        "gloss_text": "ശുദ്ധവിദ്യയുടെ ഉദയത്താൽ"
      },
      {
        "word_idx": 1,
        "gloss_text": "(ശക്തി)ചക്രത്തിന്റെ ഈശത്വസിദ്ധി"
      }
    ],
    "1.22": [
      {
        "word_idx": 0,
        "gloss_text": "മഹാഹ്രദത്തിലെ (പരമബോധസമുദ്രത്തിലെ) നിരന്തരാനുസന്ധാനത്താൽ"
      },
      {
        "word_idx": 1,
        "gloss_text": "മന്ത്രവീര്യത്തിന്റെ അനുഭവം"
      }
    ],
    "2.1": [
      {
        "word_idx": 0,
        "gloss_text": "ചിത്തം (പരമതത്ത്വാഭിമുഖമായത്)"
      },
      {
        "word_idx": 1,
        "gloss_text": "മന്ത്രം"
      }
    ],
    "2.2": [
      {
        "word_idx": 0,
        "gloss_text": "സ്വാഭാവികമായ, തീവ്രമായ പ്രയത്നം (ആത്മാഭിമുഖം)"
      },
      {
        "word_idx": 1,
        "gloss_text": "സാധകൻ, ലക്ഷ്യപ്രാപകം"
      }
    ],
    "2.3": [
      {
        "word_idx": 0,
        "gloss_text": "(ശുദ്ധ) ജ്ഞാനം ശരീരമായ സത്ത"
      },
      {
        "word_idx": 1,
        "gloss_text": "മന്ത്രരഹസ്യം"
      }
    ],
    "2.4": [
      {
        "word_idx": 0,
        "gloss_text": "(മായയുടെ) ഗർഭത്തിൽ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ചിത്തവികാസം (നികൃഷ്ടാനന്ദത്തിലെ)"
      },
      {
        "word_idx": 2,
        "gloss_text": "അവിശിഷ്ടവിദ്യയുടെ (നികൃഷ്ടവും അവ്യക്തവുമായ ജ്ഞാനത്തിന്റെ) സ്വപ്നം മാത്രം"
      }
    ],
    "2.5": [
      {
        "word_idx": 0,
        "gloss_text": "(ശുദ്ധ) വിദ്യ ഉദിക്കുമ്പോൾ"
      },
      {
        "word_idx": 1,
        "gloss_text": "സ്വാഭാവികമായ, നൈസർഗ്ഗികമായ"
      },
      {
        "word_idx": 2,
        "gloss_text": "ഖേചരി (ബോധാകാശത്തിലെ ചലനം)"
      },
      {
        "word_idx": 3,
        "gloss_text": "ശിവാവസ്ഥ"
      }
    ],
    "2.6": [
      {
        "word_idx": 0,
        "gloss_text": "ഗുരു"
      },
      {
        "word_idx": 1,
        "gloss_text": "ഉപായം"
      }
    ],
    "2.7": [
      {
        "word_idx": 0,
        "gloss_text": "മാതൃകാചക്രം (വർണ്ണദേവിയുടെ ചക്രം)"
      },
      {
        "word_idx": 1,
        "gloss_text": "സമ്യക്ബോധം, പൂർണ്ണാവബോധനം"
      }
    ],
    "2.8": [
      {
        "word_idx": 0,
        "gloss_text": "ശരീരം (സ്ഥൂല, സൂക്ഷ്മ, കാരണ)"
      },
      {
        "word_idx": 1,
        "gloss_text": "ഹവിസ്സ് (ബോധാഗ്നിയിലെ ഹോമദ്രവ്യം)"
      }
    ],
    "2.9": [
      {
        "word_idx": 0,
        "gloss_text": "(പരിമിത, ദ്വൈത) ജ്ഞാനം"
      },
      {
        "word_idx": 1,
        "gloss_text": "അന്നം (ബോധത്താൽ ഭുജിക്കപ്പെടുന്നത്)"
      }
    ],
    "2.10": [
      {
        "word_idx": 0,
        "gloss_text": "(ശുദ്ധ)വിദ്യയുടെ സംഹാരത്തിൽ"
      },
      {
        "word_idx": 1,
        "gloss_text": "അതിൽ നിന്നുയിർക്കൊള്ളുന്ന സ്വപ്നദർശനം"
      }
    ],
    "3.1": [
      {
        "word_idx": 0,
        "gloss_text": "(വ്യക്തിഗത) ആത്മാവ്"
      },
      {
        "word_idx": 1,
        "gloss_text": "ചിത്തം (വിഷയങ്ങളിൽ വ്യാപൃതം)"
      }
    ],
    "3.2": [
      {
        "word_idx": 0,
        "gloss_text": "(പരിമിത) ജ്ഞാനം"
      },
      {
        "word_idx": 1,
        "gloss_text": "ബന്ധനം"
      }
    ],
    "3.3": [
      {
        "word_idx": 0,
        "gloss_text": "കല തുടങ്ങിയ"
      },
      {
        "word_idx": 1,
        "gloss_text": "തത്ത്വങ്ങളെക്കുറിച്ച്"
      },
      {
        "word_idx": 2,
        "gloss_text": "അവിവേകം"
      },
      {
        "word_idx": 3,
        "gloss_text": "(ആകുന്നു) മായ"
      }
    ],
    "3.4": [
      {
        "word_idx": 0,
        "gloss_text": "ശരീരത്തിൽ (സൂക്ഷ്മവും സ്ഥൂലവുമായതിൽ)"
      },
      {
        "word_idx": 1,
        "gloss_text": "(ഉണ്ടാകട്ടെ) സംഹാരം"
      },
      {
        "word_idx": 2,
        "gloss_text": "കലകളുടെ (പരിമിതാംശങ്ങളുടെ)"
      }
    ],
    "3.5": [
      {
        "word_idx": 0,
        "gloss_text": "നാഡികളുടെ സംഹാരം"
      },
      {
        "word_idx": 1,
        "gloss_text": "ഭൂതങ്ങളുടെ ജയം"
      },
      {
        "word_idx": 2,
        "gloss_text": "ഭൂതങ്ങളിൽ നിന്നുള്ള കൈവല്യം/ശുദ്ധി"
      },
      {
        "word_idx": 3,
        "gloss_text": "ഭൂതങ്ങളിൽ നിന്നുള്ള പൃഥക്ത്വം"
      }
    ],
    "3.6": [
      {
        "word_idx": 0,
        "gloss_text": "മോഹാവരണത്തിൽ നിന്ന്"
      },
      {
        "word_idx": 1,
        "gloss_text": "(ദൃശ്യമാത്ര) സിദ്ധി"
      }
    ],
    "3.7": [
      {
        "word_idx": 0,
        "gloss_text": "മോഹജയത്താൽ"
      },
      {
        "word_idx": 1,
        "gloss_text": "(ബോധത്തിന്റെ) അനന്തമായ വികാസത്താൽ"
      },
      {
        "word_idx": 2,
        "gloss_text": "സഹജവിദ്യയുടെ ജയം/സ്വാധീനം"
      }
    ],
    "3.8": [
      {
        "word_idx": 0,
        "gloss_text": "(യോഗിയുടെ) ജാഗ്രദവസ്ഥ"
      },
      {
        "word_idx": 1,
        "gloss_text": "രണ്ടാം കിരണം (വസ്തുക്കളെ പ്രകാശിപ്പിക്കുന്നത്)"
      }
    ],
    "3.9": [
      {
        "word_idx": 0,
        "gloss_text": "നർത്തകൻ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ആത്മാവ്"
      }
    ],
    "3.10": [
      {
        "word_idx": 0,
        "gloss_text": "രംഗഭൂമി"
      },
      {
        "word_idx": 1,
        "gloss_text": "അന്തരാത്മാവ് (സൂക്ഷ്മശരീരം)"
      }
    ],
    "3.11": [
      {
        "word_idx": 0,
        "gloss_text": "പ്രേക്ഷകർ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ഇന്ദ്രിയങ്ങൾ"
      }
    ],
    "3.12": [
      {
        "word_idx": 0,
        "gloss_text": "(പ്രബുദ്ധ) ധിയുടെ വശത്താൽ"
      },
      {
        "word_idx": 1,
        "gloss_text": "സത്ത്വസിദ്ധി (യഥാർത്ഥ സത്തയുടെ ആവിഷ്കാരം)"
      }
    ],
    "3.13": [
      {
