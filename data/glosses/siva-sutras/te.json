  "verses": {
    "1.1": [
      {
        "word_idx": 0,
        "gloss_text": "శుద్ధ చైతన్యము, చేతనత్వము"
      },
      {
        "word_idx": 1,
        "gloss_text": "ఆత్మా, నిజస్వరూపము"
      }
    ],
    "1.2": [
      {
        "word_idx": 0,
        "gloss_text": "(పరిమిత, ద్వైత) జ్ఞానము"
      },
      {
        "word_idx": 1,
        "gloss_text": "బంధనము"
      }
    ],
    "1.3": [
      {
        "word_idx": 0,
        "gloss_text": "మూలవర్గము (మాయ, విషయములకు గర్భస్థానము)"
      },
      {
        "word_idx": 1,
        "gloss_text": "కలల (పరిమిత క్రియాంశముల)తో కూడిన శరీరము"
      }
    ],
    "1.4": [
      {
        "word_idx": 0,
        "gloss_text": "(పరిమిత) జ్ఞానమునకు ఆధారము/అధిష్ఠానము"
      },
      {
        "word_idx": 1,
        "gloss_text": "(అవగాహన లేని) మాతృక — వర్ణముల మాతృక"
      }
    ],
    "1.5": [
      {
        "word_idx": 0,
        "gloss_text": "ఆకస్మిక ఉద్యమము/ఉత్థానము (చైతన్యము యొక్క)"
      },
      {
        "word_idx": 1,
        "gloss_text": "భైరవుడు, పరమ శివుడు"
      }
    ],
    "1.6": [
      {
        "word_idx": 0,
        "gloss_text": "శక్తి చక్రముతో సంధానమునందు"
      },
      {
        "word_idx": 1,
        "gloss_text": "విశ్వము (పృథక్‌గా) లయము"
      }
    ],
    "1.7": [
      {
        "word_idx": 0,
        "gloss_text": "జాగ్రత్, స్వప్న, సుషుప్తి భేదములలో"
      },
      {
        "word_idx": 1,
        "gloss_text": "తుర్యావస్థ ఆనందము/విస్తరణ ఉదయము"
      }
    ],
    "1.8": [
      {
        "word_idx": 0,
        "gloss_text": "(లౌకిక) జ్ఞానము"
      },
      {
        "word_idx": 1,
        "gloss_text": "జాగ్రదవస్థ"
      }
    ],
    "1.9": [
      {
        "word_idx": 0,
        "gloss_text": "స్వప్నావస్థ"
      },
      {
        "word_idx": 1,
        "gloss_text": "వికల్పములు, మానసిక కల్పనలు"
      }
    ],
    "1.10": [
      {
        "word_idx": 0,
        "gloss_text": "అవివేకము, విచక్షణ లేమి"
      },
      {
        "word_idx": 1,
        "gloss_text": "మాయా సుషుప్తి (భ్రాంతి జనిత నిద్రావస్థ)"
      }
    ],
    "1.11": [
      {
        "word_idx": 0,
        "gloss_text": "త్రయము (జాగ్రత్, స్వప్న, సుషుప్తి)కి భోక్త"
      },
      {
        "word_idx": 1,
        "gloss_text": "వీరేశుడు, ఇంద్రియ వీరులకు ప్రభువు"
      }
    ],
    "1.12": [
      {
        "word_idx": 0,
        "gloss_text": "విస్మయము, ఆశ్చర్యము"
      },
      {
        "word_idx": 1,
        "gloss_text": "యోగభూమికలు, యోగదశలు"
      }
    ],
    "1.13": [
      {
        "word_idx": 0,
        "gloss_text": "ఇచ్ఛాశక్తి (సంకల్ప శక్తి)"
      },
      {
        "word_idx": 1,
        "gloss_text": "ఉమ (దేవి, పరమ సంకల్పము)"
      },
      {
        "word_idx": 2,
        "gloss_text": "కుమారి, నిర్మల కన్యక"
      }
    ],
    "1.14": [
      {
        "word_idx": 0,
        "gloss_text": "దృశ్యము, చూడబడేదంతయూ"
      },
      {
        "word_idx": 1,
        "gloss_text": "(అతని) శరీరము"
      }
    ],
    "1.15": [
      {
        "word_idx": 0,
        "gloss_text": "హృదయములో (చైతన్య కేంద్రములో)"
      },
      {
        "word_idx": 1,
        "gloss_text": "చిత్త సంఘటనమువలన, మనస్సు ఏకాగ్రతవలన"
      },
      {
        "word_idx": 2,
        "gloss_text": "దృశ్యము నిద్రించినట్లుగా దర్శనము"
      }
    ],
    "1.16": [
      {
        "word_idx": 0,
        "gloss_text": "శుద్ధ తత్త్వముతో సంధానము వలన"
      },
      {
        "word_idx": 1,
        "gloss_text": "లేదా"
      },
      {
        "word_idx": 2,
        "gloss_text": "పశు భావము నుండి విముక్తి కలిగించు శక్తి"
      }
    ],
    "1.17": [
      {
        "word_idx": 0,
        "gloss_text": "(దృఢ) వితర్కము, నిశ్చయ ప్రతిభ"
      },
      {
        "word_idx": 1,
        "gloss_text": "ఆత్మజ్ఞానము"
      }
    ],
    "1.18": [
      {
        "word_idx": 0,
        "gloss_text": "లోకానందము (ప్రపంచ దర్శన ఆనందము)"
      },
      {
        "word_idx": 1,
        "gloss_text": "సమాధి సుఖము"
      }
    ],
    "1.19": [
      {
        "word_idx": 0,
        "gloss_text": "శక్తితో సంధానమునందు"
      },
      {
        "word_idx": 1,
        "gloss_text": "(కావలసిన) శరీరోత్పత్తి"
      }
    ],
    "1.20": [
      {
        "word_idx": 0,
        "gloss_text": "భూతములను (వాటి సారముతో) సంధానము"
      },
      {
        "word_idx": 1,
        "gloss_text": "భూతముల నుండి (వ్యాధి మొదలగు వాటి నుండి) పృథక్త్వము"
      },
      {
        "word_idx": 2,
        "gloss_text": "విశ్వ సంఘట్టములు (= సిద్ధులు)"
      }
    ],
    "1.21": [
      {
        "word_idx": 0,
        "gloss_text": "శుద్ధ విద్య ఉదయము నుండి"
      },
      {
        "word_idx": 1,
        "gloss_text": "చక్రేశత్వ సిద్ధి (శక్తుల చక్రముపై ఆధిపత్యము)"
      }
    ],
    "1.22": [
      {
        "word_idx": 0,
        "gloss_text": "మహాహ్రదము (పరమ చైతన్య మహా సరస్సు)తో నిరంతర అనుసంధానము నుండి"
      },
      {
        "word_idx": 1,
        "gloss_text": "మంత్ర వీర్య అనుభవము"
      }
    ],
    "2.1": [
      {
        "word_idx": 0,
        "gloss_text": "చిత్తము (పరమ సత్యమునందు లగ్నమైనది)"
      },
      {
        "word_idx": 1,
        "gloss_text": "మంత్రము"
      }
    ],
    "2.2": [
      {
        "word_idx": 0,
        "gloss_text": "ప్రయత్నము, ఆత్మ యెడల తీవ్ర సహజ ప్రయాస"
      },
      {
        "word_idx": 1,
        "gloss_text": "సాధకుడు, లక్ష్యమును సాధించునది"
      }
    ],
    "2.3": [
      {
        "word_idx": 0,
        "gloss_text": "(శుద్ధ) జ్ఞానమే శరీరముగా గల సత్త"
      },
      {
        "word_idx": 1,
        "gloss_text": "మంత్ర రహస్యము"
      }
    ],
    "2.4": [
      {
        "word_idx": 0,
        "gloss_text": "(మాయా) గర్భములో"
      },
      {
        "word_idx": 1,
        "gloss_text": "చిత్త వికాసము (హీన ఆనందములో)"
      },
      {
        "word_idx": 2,
        "gloss_text": "అవిశిష్ట (హీన, అస్పష్ట) విద్యా స్వప్నము"
      }
    ],
    "2.5": [
      {
        "word_idx": 0,
        "gloss_text": "(శుద్ధ) విద్య ఉదయించినపుడు"
      },
      {
        "word_idx": 1,
        "gloss_text": "స్వాభావికము, సహజము"
      },
      {
        "word_idx": 2,
        "gloss_text": "ఖేచరి (శుద్ధ చైతన్యాకాశములో సంచారము)"
      },
      {
        "word_idx": 3,
        "gloss_text": "శివావస్థ"
      }
    ],
    "2.6": [
      {
        "word_idx": 0,
        "gloss_text": "గురువు"
      },
      {
        "word_idx": 1,
        "gloss_text": "ఉపాయము"
      }
    ],
    "2.7": [
      {
        "word_idx": 0,
        "gloss_text": "మాతృకా చక్రము (వర్ణదేవి చక్రము)"
      },
      {
        "word_idx": 1,
        "gloss_text": "(లభించును) పూర్ణ జాగృతి, సంబోధము"
      }
    ],
    "2.8": [
      {
        "word_idx": 0,
        "gloss_text": "శరీరము (స్థూల, సూక్ష్మ, కారణ)"
      },
      {
        "word_idx": 1,
        "gloss_text": "హవిస్సు (చైతన్యాగ్నిలో అర్పణ)"
      }
    ],
    "2.9": [
      {
        "word_idx": 0,
        "gloss_text": "(పరిమిత, ద్వైత) జ్ఞానము"
      },
      {
        "word_idx": 1,
        "gloss_text": "అన్నము (చైతన్యమునకు ఆహారము)"
      }
    ],
    "2.10": [
      {
        "word_idx": 0,
        "gloss_text": "విద్య (శుద్ధ జ్ఞానము) ఉపసంహరించబడినపుడు"
      },
      {
        "word_idx": 1,
        "gloss_text": "దానివలన పుట్టిన స్వప్న దర్శనము"
      }
    ],
    "3.1": [
      {
        "word_idx": 0,
        "gloss_text": "(వ్యక్తి) ఆత్మ"
      },
      {
        "word_idx": 1,
        "gloss_text": "చిత్తము (విషయములతో నిమగ్నమైనది)"
      }
    ],
    "3.2": [
      {
        "word_idx": 0,
        "gloss_text": "(పరిమిత) జ్ఞానము"
      },
      {
        "word_idx": 1,
        "gloss_text": "బంధనము"
      }
    ],
    "3.3": [
      {
        "word_idx": 0,
        "gloss_text": "కల మొదలగు తత్త్వములయందు"
      },
      {
        "word_idx": 1,
        "gloss_text": "తత్త్వములకు సంబంధించి"
      },
      {
        "word_idx": 2,
        "gloss_text": "అవివేకము"
      },
      {
        "word_idx": 3,
        "gloss_text": "మాయ"
      }
    ],
    "3.4": [
      {
        "word_idx": 0,
        "gloss_text": "శరీరమునందు (సూక్ష్మ, స్థూల)"
      },
      {
        "word_idx": 1,
        "gloss_text": "సంహారము (లయము)"
      },
      {
        "word_idx": 2,
        "gloss_text": "కలల (అంశముల, పరిమిత భాగముల) యొక్క"
      }
    ],
    "3.5": [
      {
        "word_idx": 0,
        "gloss_text": "(ప్రాణ) నాడుల సంహారము"
      },
      {
        "word_idx": 1,
        "gloss_text": "భూతముల జయము"
      },
      {
        "word_idx": 2,
        "gloss_text": "భూతముల నుండి కైవల్యము/శుద్ధి"
      },
      {
        "word_idx": 3,
        "gloss_text": "భూతముల నుండి పృథక్త్వము"
      }
    ],
    "3.6": [
      {
        "word_idx": 0,
        "gloss_text": "మోహ ఆవరణము వలన"
      },
      {
        "word_idx": 1,
        "gloss_text": "(భ్రాంతిమయ) సిద్ధి"
      }
    ],
    "3.7": [
      {
        "word_idx": 0,
        "gloss_text": "మోహ జయము వలన"
      },
      {
        "word_idx": 1,
        "gloss_text": "అనంత విస్తారము (చైతన్యము యొక్క) వలన"
      },
      {
        "word_idx": 2,
        "gloss_text": "సహజ విద్యా జయము"
      }
    ],
    "3.8": [
      {
        "word_idx": 0,
        "gloss_text": "(యోగి యొక్క) జాగ్రత్"
      },
      {
        "word_idx": 1,
        "gloss_text": "ద్వితీయ కిరణము (విషయములను ప్రకాశింపజేయునది)"
      }
    ],
    "3.9": [
      {
        "word_idx": 0,
        "gloss_text": "నర్తకుడు"
      },
      {
        "word_idx": 1,
        "gloss_text": "ఆత్మా"
      }
    ],
    "3.10": [
      {
        "word_idx": 0,
        "gloss_text": "రంగము (వేదిక)"
      },
      {
        "word_idx": 1,
        "gloss_text": "అంతరాత్మ (సూక్ష్మ శరీరము)"
      }
    ],
    "3.11": [
      {
        "word_idx": 0,
        "gloss_text": "ప్రేక్షకులు"
      },
      {
        "word_idx": 1,
        "gloss_text": "ఇంద్రియములు"
      }
    ],
    "3.12": [
      {
        "word_idx": 0,
        "gloss_text": "(ప్రకాశిత) ధీశక్తి (బుద్ధి) వలన"
      },
      {
        "word_idx": 1,
        "gloss_text": "సత్త్వ సిద్ధి (నిజస్వరూప ప్రకటనము)"
      }
    ],
    "3.13": [
      {
        "word_idx": 0,
        "gloss_text": "సిద్ధించును"
      },
      {
        "word_idx": 1,
        "gloss_text": "స్వతంత్ర భావము (పరిపూర్ణ స్వాతంత్ర్యావస్థ)"
      }
    ],
    "3.14": [
      {
        "word_idx": 0,
        "gloss_text": "ఎట్లో"
      },
      {
        "word_idx": 1,
        "gloss_text": "అక్కడ (తన శరీరములో)"
      },
      {
        "word_idx": 2,
        "gloss_text": "అట్లే"
      },
      {
        "word_idx": 3,
        "gloss_text": "ఇతరత్రా (ఇతర శరీరములలో)"
      }
    ],
    "3.15": [
      {
        "word_idx": 0,
        "gloss_text": "బీజమునందు (పరమ శక్తి అను సర్వ మూలమునందు) అవధానము"
      }
    ],
    "3.16": [
      {
        "word_idx": 0,
        "gloss_text": "ఆసనమునందు స్థితుడై (శక్తి అను విశ్రాంతి స్థానమునందు)"
      },
      {
        "word_idx": 1,
        "gloss_text": "సుఖముగా, ఆనందముతో"
      },
      {
        "word_idx": 2,
        "gloss_text": "హ్రదములో (పరమ చైతన్య సరస్సులో)"
      },
      {
        "word_idx": 3,
        "gloss_text": "నిమజ్జనమగును"
      }
    ],
    "3.17": [
      {
        "word_idx": 0,
