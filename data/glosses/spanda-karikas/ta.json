  "verses": {
    "1.1": [
      {"word_idx": 0, "gloss_text": "எவருடைய"},
      {"word_idx": 1, "gloss_text": "(கண்களைத்) திறப்பினாலும் மூடுதலினாலும்"},
      {"word_idx": 2, "gloss_text": "உலகின்"},
      {"word_idx": 3, "gloss_text": "அழிவும் தோற்றமும்"},
      {"word_idx": 4, "gloss_text": "சக்தி-சக்கரத்தின் வைபவத்திற்கு மூலம்"},
      {"word_idx": 5, "gloss_text": "சங்கரரை (சிவன், நலம் அளிப்பவர்)"},
      {"word_idx": 6, "gloss_text": "நாம் போற்றுகிறோம்"}
    ],
    "1.2": [
      {"word_idx": 0, "gloss_text": "எவரிடத்தில்"},
      {"word_idx": 1, "gloss_text": "நிலைபெற்றுள்ளது"},
      {"word_idx": 2, "gloss_text": "இவையனைத்தும்"},
      {"word_idx": 3, "gloss_text": "காரியம், செய்யப்பட வேண்டியது"},
      {"word_idx": 4, "gloss_text": "எவரிடமிருந்து"},
      {"word_idx": 5, "gloss_text": "மேலும் (அனைத்தும்) வெளிப்பட்டுள்ளது"},
      {"word_idx": 6, "gloss_text": "அவருக்கு"},
      {"word_idx": 7, "gloss_text": "மறைக்கப்படாத ஸ்வரூபம் இருப்பதனால்"},
      {"word_idx": 8, "gloss_text": "தடை எதுவும் இல்லை"},
      {"word_idx": 9, "gloss_text": "எங்கும்"}
    ],
    "1.3": [
      {"word_idx": 0, "gloss_text": "விழிப்பு முதலான நிலைகளின் வேறுபாட்டில்"},
      {"word_idx": 1, "gloss_text": "அதனின்று வேறுபடாமலே"},
      {"word_idx": 2, "gloss_text": "பரவிச் செல்கிறது (என்றாலும்)"},
      {"word_idx": 3, "gloss_text": "விலகுகிறது (இல்லை)"},
      {"word_idx": 4, "gloss_text": "தனது ஸ்வபாவத்திலிருந்து"},
      {"word_idx": 5, "gloss_text": "உணர்பவன்/அனுபவிப்பவனாக"}
    ],
    "1.4": [
      {"word_idx": 0, "gloss_text": "‘நான் இன்பமுள்ளவன்’"},
      {"word_idx": 1, "gloss_text": "துன்பமுள்ளவன்"},
      {"word_idx": 2, "gloss_text": "பற்றுகொண்டவன்"},
      {"word_idx": 3, "gloss_text": "உணர்வுகள் (சம்விதுகள்)"},
      {"word_idx": 4, "gloss_text": "இன்பம் முதலிய நிலைகளில் இழையாக ஓடுவதில்"},
      {"word_idx": 5, "gloss_text": "வேறொன்றில் (வேறு ஆதாரத்தில்)"},
      {"word_idx": 6, "gloss_text": "தெளிவாக"}
    ],
    "1.5": [
      {"word_idx": 0, "gloss_text": "துன்பம்"},
      {"word_idx": 1, "gloss_text": "இன்பம்"},
      {"word_idx": 2, "gloss_text": "அறியப்படுபொருள்"},
      {"word_idx": 3, "gloss_text": "அறிபவன்"},
      {"word_idx": 4, "gloss_text": "மூட நிலை / உணர்வற்ற நிலை"},
      {"word_idx": 5, "gloss_text": "பரம உண்மையில்"}
    ],
    "1.6": [
      {"word_idx": 0, "gloss_text": "புலன்-கருவிகளின் கூட்டம்"},
      {"word_idx": 1, "gloss_text": "உணர்வற்றது"},
      {"word_idx": 2, "gloss_text": "உணர்வுடையதைப் போல"},
      {"word_idx": 3, "gloss_text": "உள்ளக சக்கரத்துடன் (அந்தக்கரணத்துடன்)"},
      {"word_idx": 4, "gloss_text": "செயல்படுதல், நிலைபேறு, மீளுதல்"}
    ],
    "1.7": [
      {"word_idx": 0, "gloss_text": "[draft] அதற்காகிய முயற்சியால்"},
      {"word_idx": 1, "gloss_text": "[draft] ஆராயத்தக்கது"},
      {"word_idx": 2, "gloss_text": "[draft] தத்துவம் / உண்மை"},
      {"word_idx": 3, "gloss_text": "[draft] சுதந்திரம்"},
      {"word_idx": 4, "gloss_text": "[draft] செயற்கையற்ற, இயற்கையான"}
    ],
    "1.8": [
      {"word_idx": 0, "gloss_text": "ஆசையின் தூண்டுதலின்"},
      {"word_idx": 1, "gloss_text": "தூண்டுபவனாக"},
      {"word_idx": 2, "gloss_text": "ஆத்மபலத்தின் தொடுகையினால்"},
      {"word_idx": 3, "gloss_text": "மனிதன்"},
      {"word_idx": 4, "gloss_text": "அதற்கு சமமானவன்"}
    ],
    "1.9": [
      {"word_idx": 0, "gloss_text": "இயற்கையான மலினம்"},
      {"word_idx": 1, "gloss_text": "இயலாதவனின்"},
      {"word_idx": 2, "gloss_text": "செய்யத்தக்க செயல்களில்"},
      {"word_idx": 3, "gloss_text": "ஆசை கொண்டவனின்"},
      {"word_idx": 4, "gloss_text": "கலக்கம்"},
      {"word_idx": 5, "gloss_text": "கரையக்கூடும்"},
      {"word_idx": 6, "gloss_text": "பரம பதம் / உயர்ந்த நிலை"}
    ],
    "1.10": [
      {"word_idx": 0, "gloss_text": "செயற்கையற்ற, இயற்கையான"},
      {"word_idx": 1, "gloss_text": "தர்மம் / இயல்பு"},
      {"word_idx": 2, "gloss_text": "சர்வஞ்ஞத்துவம் மற்றும் சர்வகர்த்ருத்வத்தால் வரையறுக்கப்பட்டது"},
      {"word_idx": 3, "gloss_text": "விரும்பப்பட்டது"},
      {"word_idx": 4, "gloss_text": "அறிகிறான்"},
      {"word_idx": 5, "gloss_text": "செய்கிறான்"}
    ],
    "1.11": [
      {"word_idx": 0, "gloss_text": "அதிஷ்டாதாவாகிய (ஆட்சிபுரியும்) நிலையில்"},
      {"word_idx": 1, "gloss_text": "ஸ்வபாவத்தை"},
      {"word_idx": 2, "gloss_text": "தரிசிக்கின்றவன்"},
      {"word_idx": 3, "gloss_text": "வியப்புடன் புன்னகைப்பவன்"},
      {"word_idx": 4, "gloss_text": "கொடிய பாதை (சம்சாரம்)"}
    ],
    "1.12": [
      {"word_idx": 0, "gloss_text": "[draft] இல்லாமை / சூன்யம்"},
      {"word_idx": 1, "gloss_text": "[draft] தியான-பொருள் ஆதலை"},
      {"word_idx": 2, "gloss_text": "[draft] மூடமற்ற நிலை (விழிப்புணர்வு)"},
      {"word_idx": 3, "gloss_text": "[draft] பின்வரும் சிந்தனையின் தொடுகையினால்"},
      {"word_idx": 4, "gloss_text": "[draft] துணிபு / நிச்சயம்"}
    ],
    "1.13": [
      {"word_idx": 0, "gloss_text": "[draft] செயற்கையானது / கட்டப்பட்டது"},
      {"word_idx": 1, "gloss_text": "[draft] அறியத்தக்கது"},
      {"word_idx": 2, "gloss_text": "[draft] ஆழ்ந்த உறக்க நிலையைப் போல"},
      {"word_idx": 3, "gloss_text": "[draft] நினைவின் பொருளாகுந் தன்மை"},
      {"word_idx": 4, "gloss_text": "[draft] அந்தத் தத்துவம்"}
    ],
    "1.14": [
      {"word_idx": 0, "gloss_text": "இரு நிலைகள்"},
      {"word_idx": 1, "gloss_text": "காரியம் மற்றும் கர்த்ருத்வம் எனப்பெயரிட்டது"},
      {"word_idx": 2, "gloss_text": "காரியநிலை"},
      {"word_idx": 3, "gloss_text": "அழியக்கூடியது"},
      {"word_idx": 4, "gloss_text": "கர்த்ருத்வம்"},
      {"word_idx": 5, "gloss_text": "அழியாதது"}
    ],
    "1.15": [
      {"word_idx": 0, "gloss_text": "காரியங்கள் நோக்கியது"},
      {"word_idx": 1, "gloss_text": "முயற்சி"},
      {"word_idx": 2, "gloss_text": "அடங்குகிறது / நிறுத்தப்படுகிறது"},
      {"word_idx": 3, "gloss_text": "அழிக்கப்பட்டவன்"},
      {"word_idx": 4, "gloss_text": "அறிவில்லாதவன்"}
    ],
    "1.16": [
      {"word_idx": 0, "gloss_text": "உள்நோக்கியது"},
      {"word_idx": 1, "gloss_text": "பாவம் / உண்மை"},
      {"word_idx": 2, "gloss_text": "சர்வஞ்ஞத்துவ குணத்திற்கு இடம்"},
      {"word_idx": 3, "gloss_text": "உணர்வின் அடங்குதல்"},
      {"word_idx": 4, "gloss_text": "உணராதவன் (மற்றொரு ஜீவன்)"}
    ],
    "1.17": [
      {"word_idx": 0, "gloss_text": "உணர்பவன்"},
      {"word_idx": 1, "gloss_text": "மூன்று நிலைகளிலும் தவறாதவனின்"},
      {"word_idx": 2, "gloss_text": "நன்கு விழித்தவனுக்கு"},
      {"word_idx": 3, "gloss_text": "அந்த (நிலையின்) ஆரம்பத்திலும் முடிவிலும்"},
      {"word_idx": 4, "gloss_text": "மற்றவனுக்கு"}
    ],
    "1.18": [
      {"word_idx": 0, "gloss_text": "ஞானம்-ஞேயம் என்ற ரூபம் கொண்டதனால்"},
      {"word_idx": 1, "gloss_text": "பரம சக்தியுடன்"},
      {"word_idx": 2, "gloss_text": "இரு நிலைகளில் (விழிப்பு-கனவு)"},
      {"word_idx": 3, "gloss_text": "வியாபகன்"},
      {"word_idx": 4, "gloss_text": "சித்மாத்திரம் / சித்து மட்டுமாக"}
    ],
    "1.19": [
      {"word_idx": 0, "gloss_text": "குணங்கள் முதலிய ஸ்பந்த-நீரோட்டங்கள்"},
      {"word_idx": 1, "gloss_text": "பொது ஸ்பந்தத்தை ஆதாரமாகக் கொள்வதனால்"},
      {"word_idx": 2, "gloss_text": "தம் இருப்பைப் பெற்றவை"},
      {"word_idx": 3, "gloss_text": "அறிபவனின் (ஞானியின்)"},
      {"word_idx": 4, "gloss_text": "தடையற்றவை"}
    ],
    "1.20": [
      {"word_idx": 0, "gloss_text": "விழித்திராத அறிவுடையோர்"},
      {"word_idx": 1, "gloss_text": "தம் உண்மை-நிலையை மறைக்க முற்படுபவை"},
      {"word_idx": 2, "gloss_text": "தள்ளுகின்றன"},
      {"word_idx": 3, "gloss_text": "கடப்பதற்கு கடினமான"},
      {"word_idx": 4, "gloss_text": "சம்சாரப் பாதையில்"}
    ],
    "1.21": [
      {"word_idx": 0, "gloss_text": "எப்போதும் முயற்சித்தவன்"},
      {"word_idx": 1, "gloss_text": "ஸ்பந்த தத்துவத்தை வேறுபடுத்தி அறிவதற்காக"},
      {"word_idx": 2, "gloss_text": "விழிப்பு நிலையிலேயே"},
      {"word_idx": 3, "gloss_text": "தனது உண்மை நிலையை"},
      {"word_idx": 4, "gloss_text": "விரைவில்"},
      {"word_idx": 5, "gloss_text": "அடைகிறான்"}
    ],
    "1.22": [
      {"word_idx": 0, "gloss_text": "மிகவும் கோபமுற்றவன்"},
      {"word_idx": 1, "gloss_text": "மிகவும் மகிழ்ந்தவன்"},
      {"word_idx": 2, "gloss_text": "‘நான் என்ன செய்வேன்?’"},
      {"word_idx": 3, "gloss_text": "சிந்திப்பவன்"},
      {"word_idx": 4, "gloss_text": "ஓடுபவன்"},
      {"word_idx": 5, "gloss_text": "எந்த நிலையை (அடைகிறான்)"},
      {"word_idx": 6, "gloss_text": "நிலைபெற்றுள்ளது"}
    ],
    "1.23": [
      {"word_idx": 0, "gloss_text": "[draft] பற்றிக்கொண்டு"},
      {"word_idx": 1, "gloss_text": "[draft] (அவன்) சொல்லப்போகிறான்"},
      {"word_idx": 2, "gloss_text": "[draft] கட்டாயம்"},
      {"word_idx": 3, "gloss_text": "[draft] செய்வேன்"},
      {"word_idx": 4, "gloss_text": "[draft] உறுதிகொண்டு"},
      {"word_idx": 5, "gloss_text": "[draft] நிற்கிறான்"}
    ],
    "1.24": [
      {"word_idx": 0, "gloss_text": "அந்த (நிலையை) ஆதாரமாகக் கொண்டு"},
      {"word_idx": 1, "gloss_text": "மேல்நோக்கிய பாதையால்"},
      {"word_idx": 2, "gloss_text": "சந்திர-சூரியர் (இடா-பிங்களா / பிராண-அபானம்)"},
      {"word_idx": 3, "gloss_text": "சுஷும்னை வழியில்"},
      {"word_idx": 4, "gloss_text": "அஸ்தமனம் அடைந்தவை (அடங்கின)"},
      {"word_idx": 5, "gloss_text": "பிரம்மாண்டத்தின் எல்லை"}
    ],
    "1.25": [
      {"word_idx": 0, "gloss_text": "மகா-ஆகாயத்தில் (சித்-ஆகாயத்தில்)"},
      {"word_idx": 1, "gloss_text": "சந்திர-சூரியர் கரைந்த இடத்தில்"},
      {"word_idx": 2, "gloss_text": "ஆழ்ந்த உறக்க நிலையைப் போல"},
      {"word_idx": 3, "gloss_text": "அறியாதவன்"},
      {"word_idx": 4, "gloss_text": "விழித்தவன்"},
      {"word_idx": 5, "gloss_text": "மறைப்பற்றவன்"}
    ],
    "2.1": [
      {"word_idx": 0, "gloss_text": "அந்தச் சக்தியைப் பற்றிக்கொண்டு"},
      {"word_idx": 1, "gloss_text": "மந்திரங்கள்"},
      {"word_idx": 2, "gloss_text": "சர்வஞ்ஞ பலத்துடன் கூடியவை"},
      {"word_idx": 3, "gloss_text": "தம் தொழிலுக்காக"},
      {"word_idx": 4, "gloss_text": "புலன்-கருவிகள் போல"}
    ],
    "2.2": [
      {"word_idx": 0, "gloss_text": "முற்றாக அடங்குகின்றன"},
      {"word_idx": 1, "gloss_text": "சாந்த ரூபம் கொண்டவை"},
      {"word_idx": 2, "gloss_text": "களங்கமற்றவை"},
      {"word_idx": 3, "gloss_text": "ஆராதிப்பவனின் சித்தத்துடன்"},
      {"word_idx": 4, "gloss_text": "சிவத்தன்மையை உடையவை"}
    ],
    "2.3": [
      {"word_idx": 0, "gloss_text": "சர்வத்தையும் (தன்னுள்) கொண்டது"},
      {"word_idx": 1, "gloss_text": "ஜீவன் / தனி ஆத்மா"},
      {"word_idx": 2, "gloss_text": "அனைத்துப் பொருள்களும் (அதிலிருந்து) உருவாகின்றன என்பதனால்"},
      {"word_idx": 3, "gloss_text": "அதைப் பற்றிய உணர்வின் ரூபத்தினால்"},
      {"word_idx": 4, "gloss_text": "ஒன்றென உணர்வதின் அறிதலினால்"}
    ],
    "2.4": [
      {"word_idx": 0, "gloss_text": "சொற்களின், பொருள்களின் சிந்தனைகளில்"},
      {"word_idx": 1, "gloss_text": "நிலை"},
