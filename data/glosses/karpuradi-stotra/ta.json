      {"word_idx": 8, "gloss_text": "எனில்"},
      {"word_idx": 9, "gloss_text": "ஜபிக்கிறான்"},
      {"word_idx": 10, "gloss_text": "ஒரு மனிதன்"},
      {"word_idx": 11, "gloss_text": "ஒரு முறை"},
      {"word_idx": 12, "gloss_text": "எப்போதேனும்"},
      {"word_idx": 13, "gloss_text": "வென்று"},
