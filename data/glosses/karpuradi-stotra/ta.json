    "1.1": [
      {"word_idx": 0, "gloss_text": "கர்ப்பூரம் — 'க' எழுத்து (காளீ மந்திரத்தின் முதல் எழுத்து)"},
      {"word_idx": 1, "gloss_text": "நடு மற்றும் இறுதி உயிரெழுத்துகள் (அ, ஊ) நீக்கப்பெற்றது"},
      {"word_idx": 2, "gloss_text": "பிறைச்சந்திரனோடும் (அனுஸ்வாரம்/சந்திரபிந்து) இடதுகண்ணோடும் (ஈ-காரம்) கூடியது — க்ரீம்"},
      {"word_idx": 3, "gloss_text": "பீஜம், மந்திரத்தின் விதைஎழுத்து"},
      {"word_idx": 4, "gloss_text": "உனது"},
      {"word_idx": 5, "gloss_text": "தாயே"},
      {"word_idx": 6, "gloss_text": "இது"},
      {"word_idx": 7, "gloss_text": "திரிபுரத்தை அழித்தவனின் (சிவனின்) பத்தினியே"},
      {"word_idx": 8, "gloss_text": "மூன்று முறை செய்யப்பட்டது"},
      {"word_idx": 9, "gloss_text": "எவர்கள்"},
      {"word_idx": 10, "gloss_text": "ஜபிக்கின்றனர் (மௌனமாக)"},
      {"word_idx": 11, "gloss_text": "அவர்களுக்கு"},
      {"word_idx": 12, "gloss_text": "உரைநடை இலக்கியங்கள்"},
      {"word_idx": 13, "gloss_text": "செய்யுள் இலக்கியங்கள்"},
      {"word_idx": 14, "gloss_text": "மற்றும்"},
      {"word_idx": 15, "gloss_text": "வாயின் குகையிலிருந்து"},
      {"word_idx": 16, "gloss_text": "வெளிப்படுகின்றன, பெருகுகின்றன"},
      {"word_idx": 17, "gloss_text": "திண்ணமாக"},
      {"word_idx": 18, "gloss_text": "வாக்குகள், சொற்கள்"},
      {"word_idx": 19, "gloss_text": "சுதந்திரமாக, தம் இச்சைப்படி"},
      {"word_idx": 20, "gloss_text": "இருண்ட மழைமேகத்தின் காந்தியோடு ஒளிர்பவளே"},
      {"word_idx": 21, "gloss_text": "சர்வசித்தி, அனைத்து சித்திகள்"},
      {"word_idx": 22, "gloss_text": "அடைந்தவர்களுக்கு"}
    ],
    "1.2": [
      {"word_idx": 0, "gloss_text": "ஈசானன் — 'ஹ' எழுத்தின் குறியீடு"},
      {"word_idx": 1, "gloss_text": "பிறைச்சந்திரனோடும் இடதுசெவியோடும் (ஊ-காரம்) கூடியது — ஹூம்"},
      {"word_idx": 2, "gloss_text": "பீஜம், விதைஎழுத்து"},
      {"word_idx": 3, "gloss_text": "மற்றொன்று, அடுத்தது"},
