      {"word_idx": 13, "gloss_text": "கொல்லுகிறார்கள்"},
      {"word_idx": 14, "gloss_text": "அவர்கள்"},
      {"word_idx": 15, "gloss_text": "மற்றும்"},
      {"word_idx": 16, "gloss_text": "மூவுலகையும்"},
      {"word_idx": 17, "gloss_text": "கூட"},
