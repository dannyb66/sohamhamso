      {"word_idx": 21, "gloss_text": "வாயின் இரு ஓரங்களிலிருந்தும் இரட்டை இரத்த நீரோட்டத்தைப் பெற்ற முகத்தினளே"},
      {"word_idx": 22, "gloss_text": "தக்ஷிணை (தென்முகக் காளி) ஆனவளே"},
      {"word_idx": 23, "gloss_text": "மூவெழுத்து (மந்திரம்)"},
      {"word_idx": 24, "gloss_text": "என்று (மேற்கோள் முடிவுக் குறி)"}
    ],
