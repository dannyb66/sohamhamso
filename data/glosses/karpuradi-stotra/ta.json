      {"word_idx": 15, "gloss_text": "செல்வம்"},
      {"word_idx": 16, "gloss_text": "மேலும்"},
      {"word_idx": 17, "gloss_text": "மற்றும்"},
      {"word_idx": 18, "gloss_text": "நீண்டகாலம்"},
      {"word_idx": 19, "gloss_text": "மயக்கிக்கொண்டே"},
      {"word_idx": 20, "gloss_text": "தாமரைக்கண்ணியர் கூட்டம்"},
      {"word_idx": 21, "gloss_text": "அர்த்தச்சந்திரனை சூடியவளே"},
      {"word_idx": 22, "gloss_text": "மேற்கொள்கிறான், ஆற்றல் பெறுகிறான்"},
      {"word_idx": 23, "gloss_text": "அவன்"},
      {"word_idx": 24, "gloss_text": "பேய்க்குழந்தைகளின் மண்டையோடுகளைக் காதணியாக/சிகையணியாகக் கொண்டவளே"}
    ],
    "1.3": [
      {"word_idx": 0, "gloss_text": "ஈசன் — 'ஹ' எழுத்தின் குறியீடு"},
      {"word_idx": 1, "gloss_text": "வைஸ்வானரத்தில் (அக்னியில்) நிலைத்தவன் — 'ர' எழுத்தோடு கூடியது"},
