{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/SohamhamsoCorpusFaqDocument",
  "definitions": {
    "LangMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "hi": { "type": "string", "minLength": 1 },
        "mr": { "type": "string", "minLength": 1 },
        "bn": { "type": "string", "minLength": 1 },
        "as": { "type": "string", "minLength": 1 },
        "gu": { "type": "string", "minLength": 1 },
        "pa": { "type": "string", "minLength": 1 },
        "kn": { "type": "string", "minLength": 1 },
        "ml": { "type": "string", "minLength": 1 },
        "or": { "type": "string", "minLength": 1 },
        "ta": { "type": "string", "minLength": 1 },
        "te": { "type": "string", "minLength": 1 }
      }
    },
    "FaqEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer"],
      "properties": {
        "question": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "$ref": "#/definitions/LangMap" }
          ]
        },
        "answer": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "$ref": "#/definitions/LangMap" }
          ]
        }
      }
    },
    "SohamhamsoCorpusFaqDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["faqs"],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1,
          "default": 1
        },
        "faqs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/FaqEntry" }
        }
      }
    }
  }
}
