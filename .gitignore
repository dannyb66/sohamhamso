# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
.astro/
.output/
.vercel/
.netlify/
.wrangler/
build/

# Local databases
# db/sohamhamso.db is a build cache, not a source of truth (plan item A6):
# data/corpus/*.yaml + db/schema.sql (+ db/migrations/) are the sources.
# Every build path (`bun run build`, `seo:build`, CI, CF Pages) runs
# `bun run db:ensure`, which reconstructs the DB via db:init + ingest when
# the file is absent. Do NOT re-add a `!db/sohamhamso.db` exception.
db/*.db
db/*.db-journal
db/*.sqlite
db/*.sqlite-journal
db/*.db-wal
db/*.db-shm

# YouTube pipeline runtime state (R2-synced, never committed). Already covered
# by `db/*.db` above, but listed explicitly so no one adds a
# `!db/youtube-state.db` exception by mistake.
db/youtube-state.db
db/youtube-state.db-*

# OG verse text precache — build output of scripts/seo-build-og-cache.ts.
# Regenerated on every `seo:build` from db/sohamhamso.db. The OG handler
# in functions/og/_shared.ts reads these JSON files via ASSETS.fetch on
# the hot path instead of running a libsql HTTP query against Turso.
public/og-cache/

# Local dev caches
.turso/
.cache/
.parcel-cache/
.eslintcache

# Environment
.env
.env.local
.env.*.local

# Secrets (OAuth refresh token written by scripts/youtube-oauth-setup.ts)
.secrets/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
*.swo

# Test outputs
coverage/
playwright-report/
test-results/
.nyc_output/

# Dataset build artifacts (generated; do not commit)
dataset/build/
checksums.sha256.unsigned
.gstack/

# Claude Code agent harness (local worktrees, session state)
.claude/

# YouTube Shorts preview renders (regenerable via youtube:render-samples)
samples/*.mp4

# Indic pilot preview renders (regenerable)
samples-indic/

# python bytecode (merge scripts)
__pycache__/
