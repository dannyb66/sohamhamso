---
import I18nSwap from '../components/I18nSwap.solid.tsx';
import ReaderLangSwap from '../components/ReaderLangSwap.solid.tsx';
import SearchBox from '../components/SearchBox.solid.tsx';
import SettingsSheet from '../components/SettingsSheet.solid.tsx';
import AcceptLanguageBanner from '../components/seo/AcceptLanguageBanner.astro';
import HeadSeo from '../components/seo/HeadSeo.astro';
import { CORE_PRELOADED_FONT_ASSETS } from '../lib/font-assets';
import type { LangCode } from '../lib/reading-modes';
import type { HreflangEntry } from '../lib/seo';
import { buildWebPageJsonLd, type JsonLdNode } from '../lib/seo/jsonld';

interface Props {
  canonical?: string;
  title?: string;
  description?: string;
  hreflang?: HreflangEntry[];
  jsonLd?: JsonLdNode[];
  keywords?: string[];
  lang?: string;
  localeBasePath?: string;
  noindex?: boolean;
  ogImageUrl?: string;
}
const {
  canonical,
  title = 'sohamhamso — The Tantric canon, read in eleven tongues',
  description = 'Modern reader for the Tantric, Kashmir Shaivism, Trika, and Kaula Sanskrit canon. Translations in eleven Indian languages.',
  hreflang = [],
  jsonLd = [],
  keywords = [],
  lang = 'en',
  localeBasePath,
  noindex = false,
  ogImageUrl,
} = Astro.props;
const siteUrl = Astro.site ?? Astro.url;
const requestPath =
  Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const resolvedCanonical = canonical ?? new URL(requestPath, siteUrl).toString();
const resolvedOgImageUrl = ogImageUrl ?? new URL('/og-default.png', siteUrl).toString();
const currentLangCode = lang as LangCode;
const resolvedJsonLd =
  jsonLd.length > 0
    ? jsonLd
    : [
        buildWebPageJsonLd({
          title,
          description,
          url: resolvedCanonical,
          inLanguage: lang,
        }),
      ];
const preloadedFonts = CORE_PRELOADED_FONT_ASSETS;
---
<!doctype html>
<html lang={lang} data-locale-base-path={localeBasePath}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#FAF6EE" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#14110D" media="(prefers-color-scheme: dark)" />
  <HeadSeo
    canonical={resolvedCanonical}
    description={description}
    hreflang={hreflang}
    jsonLd={resolvedJsonLd}
    keywords={keywords}
    noindex={noindex}
    ogImageUrl={resolvedOgImageUrl}
    title={title}
  />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="manifest" href="/manifest.json" />
  {preloadedFonts.map((href) => (
    <link rel="preload" as="font" href={href} crossorigin="anonymous" />
  ))}
  <script is:inline>
    // Apply persisted theme before paint to avoid flash.
    // First-visit fallback: respect the OS prefers-color-scheme so users
    // on a dark-mode device land in dark instead of cream. A saved
    // preference always wins. Note: tokens.css already cascades correctly
    // for `:root:not([data-theme])` under `@media (prefers-color-scheme:
    // dark)`, so this JS exists for state observability (so the masthead
    // toggle can read the *effective* theme via data-theme), not visual
    // correctness on first paint.
    (() => {
      try {
        const root = document.documentElement;
        const saved = localStorage.getItem('sohamhamso:theme');
        const prefersDark =
          typeof matchMedia === 'function' &&
          matchMedia('(prefers-color-scheme: dark)').matches;
        const initial = saved || (prefersDark ? 'dark' : null);
        if (initial && initial !== 'light') root.setAttribute('data-theme', initial);
      } catch {}
    })();
  </script>
  <script is:inline>
    (() => {
      if (typeof document === 'undefined') return;
      document.addEventListener('sohamhamso:reader-lang-change', (event) => {
        const detail = event instanceof CustomEvent ? event.detail : null;
        const lang = detail?.lang;
        const basePath = document.documentElement.dataset.localeBasePath;
        if (!lang || !basePath) return;
        const next = lang === 'en' ? basePath : `/${lang}${basePath === '/' ? '' : basePath}`;
        if (next !== window.location.pathname) {
          window.location.assign(next);
        }
      });
    })();
  </script>
  <slot name="head" />
</head>
<body>
  <a href="#main" class="skip-link" data-i18n="skip.to_content">Skip to content</a>
  <slot />
  <!--
    Global islands: SettingsSheet listens for `sohamhamso:open-settings`
    (dispatched by [Aa] chrome buttons) and SearchBox intercepts the
    Masthead's `[data-search-trigger]` clicks + ⌘K/Ctrl-K in capture phase
    so it supersedes the V1 placeholder dialog when present. I18nSwap
    walks the SSR DOM after hydrate and rewrites every [data-i18n]
    element to the user's chosen reader-lang (no-op for English).
    ReaderLangSwap is mounted site-wide: pages that inject a
    `window.__readerData` payload (verse page + homepage hero) get the
    `.translation` text swapped to the chosen reader-lang; pages
    without a payload are a no-op.
  -->
  <SettingsSheet client:idle />
  <SearchBox client:idle />
  <I18nSwap client:idle />
  <ReaderLangSwap client:idle />
  <AcceptLanguageBanner currentLang={currentLangCode} localeBasePath={localeBasePath} />
</body>
</html>

<style is:global>
  @import "../styles/fonts.css";
  @import "../styles/global.css";
</style>
