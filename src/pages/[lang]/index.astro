---
import CuratedEntries from '../../components/CuratedEntries.astro';
import FeaturedVerseHero from '../../components/FeaturedVerseHero.astro';
import Footer from '../../components/Footer.astro';
import Masthead from '../../components/Masthead.astro';
import SubscribeBand from '../../components/SubscribeBand.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { LangCode } from '../../lib/reading-modes';
import { NON_ENGLISH_LANGS, buildHomeSeo, liveLocaleSet } from '../../lib/seo';

export async function getStaticPaths() {
  return NON_ENGLISH_LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!lang || !NON_ENGLISH_LANGS.includes(lang as (typeof NON_ENGLISH_LANGS)[number])) {
  throw new Error(`Invalid locale home route: ${lang ?? '<missing>'}`);
}

const currentLang = lang as LangCode;
const liveLangs = liveLocaleSet();
const pageSeo = buildHomeSeo({
  availableLangs: Array.from(liveLangs).sort() as LangCode[],
  indexable: liveLangs.has(currentLang),
  lang: currentLang,
});
---

<BaseLayout
  canonical={pageSeo.canonical}
  description={pageSeo.description}
  hreflang={pageSeo.hreflang}
  jsonLd={pageSeo.jsonLd}
  lang={currentLang}
  localeBasePath="/"
  noindex={pageSeo.noindex}
  title={pageSeo.title}
>
  <Masthead currentLang={currentLang.toUpperCase()} />

  <main id="main">
    <FeaturedVerseHero href={`/${lang}/trika/vijnana-bhairava-tantra/1/47`} />

    <hr class="shirorekha-rule" aria-hidden="true" />

    <CuratedEntries centered={true} />

    <hr class="shirorekha-rule" aria-hidden="true" />

    <SubscribeBand />
  </main>

  <Footer />
</BaseLayout>
