---
import CuratedEntries from '../components/CuratedEntries.astro';
import FeaturedVerseHero from '../components/FeaturedVerseHero.astro';
import Footer from '../components/Footer.astro';
import Masthead from '../components/Masthead.astro';
import SubscribeBand from '../components/SubscribeBand.astro';
/**
 * Homepage — sohamhamso.
 *
 * Per the locked design spec (Homepage IA): NO carousel, NO card grid,
 * NO 3-column "Why us" features band. Just:
 *   masthead → featured verse → curated entries → subscribe → footer.
 *
 * The verse is the only marketing the site needs.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildHomeSeo, liveLocaleSet } from '../lib/seo';

const currentLang = 'en' as const;
const pageSeo = buildHomeSeo({
  availableLangs: Array.from(liveLocaleSet()).sort(),
  lang: currentLang,
});
---

<BaseLayout
  canonical={pageSeo.canonical}
  description={pageSeo.description}
  hreflang={pageSeo.hreflang}
  jsonLd={pageSeo.jsonLd}
  lang={currentLang}
  localeBasePath="/"
  noindex={pageSeo.noindex}
  title={pageSeo.title}
>
  <Masthead currentLang="EN" />

  <main id="main">
    <FeaturedVerseHero />

    <hr class="shirorekha-rule" aria-hidden="true" />

    <CuratedEntries centered={true} />

    <hr class="shirorekha-rule" aria-hidden="true" />

    <SubscribeBand />
  </main>

  <Footer />
</BaseLayout>
