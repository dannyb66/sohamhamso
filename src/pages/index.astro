---
import CuratedEntries from '../components/CuratedEntries.astro';
import FeaturedVerseHero from '../components/FeaturedVerseHero.astro';
import Footer from '../components/Footer.astro';
import Masthead from '../components/Masthead.astro';
import SubscribeBand from '../components/SubscribeBand.astro';
/**
 * Homepage — sohamhamso.
 *
 * Per the locked design spec (Homepage IA): NO carousel, NO card grid,
 * NO 3-column "Why us" features band. Just:
 *   masthead → featured verse → curated entries → subscribe → footer.
 *
 * The verse is the only marketing the site needs.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="sohamhamso — The Tantric canon, read in eleven tongues"
  description="A modern reader for the Tantric, Kashmir Shaivism, Trika, and Kaula Sanskrit canon. Translations in eleven Indian languages."
>
  <Masthead currentLang="EN" />

  <main id="main">
    <FeaturedVerseHero />

    <hr class="shirorekha-rule" aria-hidden="true" />

    <CuratedEntries />

    <hr class="shirorekha-rule" aria-hidden="true" />

    <SubscribeBand />
  </main>

  <Footer />
</BaseLayout>

<!--
  Homepage-scoped alignment override (audit-2026-06-01, recommendation
  in "Desktop" notes): the three curated entries were left-aligned in a
  3-column `justify-content: space-between` grid which reads ragged
  against the centered hero (max-width 62ch, centered). Center the
  curated row on desktop so it clusters under the hero instead of
  spanning the full 1080px container.

  This override lives here (NOT in CuratedEntries.astro) because the
  curated grid's *default* `space-between` posture is the right one for
  pages where the curated entries are the main content; on the
  homepage the hero is the focal point and the curated entries are a
  follow-on. Only the homepage wants this alignment. If a second page
  starts adopting it, hoist into CuratedEntries with a prop.

  Mobile is untouched — the single-column stack still flows naturally.
-->
<style is:global>
  @media (min-width: 768px) {
    main .curated-list {
      justify-content: center;
      gap: var(--spacing-8);
    }
    main .curated-item {
      flex: 0 1 220px;
    }
  }
</style>
