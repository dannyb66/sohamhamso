---
import AIAssistedBadge from '../../../../components/AIAssistedBadge.astro';
import ParallelChip from '../../../../components/ParallelChip.astro';
import ScriptSwitcher from '../../../../components/ScriptSwitcher.solid';
import TranslationDrawer from '../../../../components/TranslationDrawer.solid';
import VerseAnatomy from '../../../../components/VerseAnatomy.astro';
import WordSheet from '../../../../components/WordSheet.solid';
import Breadcrumbs from '../../../../components/seo/Breadcrumbs.astro';
import LangSwitcher from '../../../../components/seo/LangSwitcher.astro';
/**
 * Verse-page route: /{tradition}/{text-slug}/{chapter}/{verse}
 *
 * Static-built: enumerates every (tradition, text, chapter, verse) tuple
 * at build time by querying SQLite via src/lib/db.ts.
 *
 * Spec: see /Users/danny/.claude/plans/check-online-websites-aim-sparkling-pearl-agent-aa24b14e8caa90241.md
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { enumerateRedirectPairs, resolveAlias } from '../../../../lib/aliases';
import { getDb, getVerseAllLanguages, getVerseTranslations } from '../../../../lib/db';
import type { LangCode } from '../../../../lib/reading-modes';
import { safeJsonForScript } from '../../../../lib/safe-json';
import {
  buildDefinedTermJsonLd,
  buildVerseSeo,
  filterIndexableTextLangs,
  getCanonicalVerseRoutes,
  getLemmaSummaryByIast,
  getVerseAvailability,
  getVersePageCached,
  inLanguageTag,
  liveLocaleSet,
  localePathFor,
} from '../../../../lib/seo';

export async function getStaticPaths() {
  const allRoutes = getCanonicalVerseRoutes();

  const canonical = allRoutes.map((route) => ({
    params: {
      tradition: route.tradition,
      text: route.text,
      chapter: String(route.chapter),
      verse: String(route.verse),
    },
    props: { redirectTo: null as string | null },
  }));

  // Wrong-tradition and slug-alias redirect pages. Each generates a static
  // HTML file that meta-refreshes (or 301s via CF adapter) to the canonical URL.
  const aliases = enumerateRedirectPairs().flatMap(
    ({ wrongTradition, wrongSlug, canonicalTradition, canonicalSlug }) =>
      allRoutes
        .filter((r) => r.tradition === canonicalTradition && r.text === canonicalSlug)
        .map((r) => ({
          params: {
            tradition: wrongTradition,
            text: wrongSlug,
            chapter: String(r.chapter),
            verse: String(r.verse),
          },
          props: {
            redirectTo: `/${canonicalTradition}/${canonicalSlug}/${r.chapter}/${r.verse}`,
          },
        })),
  );

  return [...canonical, ...aliases];
}

const { redirectTo } = Astro.props;
const { tradition, text, chapter, verse } = Astro.params;
const chapterNum = Number(chapter);
const verseNum = Number(verse);

// Alias redirect: this path was generated by enumerateRedirectPairs() in
// getStaticPaths — serve a 301 to the canonical URL without any DB queries.
if (redirectTo) {
  return Astro.redirect(redirectTo, 301);
}

const currentLang: LangCode = 'en';
const data = getVersePageCached(text!, chapterNum, verseNum, currentLang);
if (!data) {
  // Astro 5: throw to surface a build-time error if the path made it here
  // without a matching DB row (shouldn't happen — paths come from same source).
  throw new Error(`Verse not found: ${tradition}/${text}/${chapterNum}/${verseNum}`);
}

const { text: textRow, verse: verseRow, translations, wordGlosses, parallels, prev, next } = data;

// Compute "more occurrences in this text" counts for each lemma in this
// verse's glosses. Counts DISTINCT verses (excluding the current verse)
// where the same lemma_iast appears across the same text. Used by the
// WordSheet's "N more occurrences →" link. Single SQL round-trip; empty
// lemma rows are skipped.
const lemmaIasts = Array.from(
  new Set(wordGlosses.map((g) => g.lemma_iast).filter((s): s is string => !!s)),
);
const occurrenceCounts = new Map<string, number>();
if (lemmaIasts.length > 0) {
  const db = getDb();
  const placeholders = lemmaIasts.map(() => '?').join(',');
  const rows = db
    .query<{ lemma_iast: string; n: number }, (string | number)[]>(`
      SELECT g.lemma_iast AS lemma_iast, COUNT(DISTINCT g.verse_id) AS n
      FROM word_glosses g
      JOIN verses v ON v.id = g.verse_id
      WHERE v.text_id = ?
        AND g.verse_id != ?
        AND g.lemma_iast IN (${placeholders})
      GROUP BY g.lemma_iast
    `)
    .all(textRow.id, verseRow.id, ...lemmaIasts);
  for (const r of rows) {
    occurrenceCounts.set(r.lemma_iast, r.n);
  }
}

// Group glosses by verse_id for the WordSheet's window.__wordGlosses lookup.
// `occurrence_count` is the number of *other* verses in this text that
// contain the same lemma; 0/undefined hides the "more occurrences" link.
// `text_slug` is injected once so WordSheet can build search URLs without
// needing additional payload.
const glossesPayload = {
  [String(verseRow.id)]: wordGlosses.map((g) => ({
    lemma_href:
      g.lemma_iast &&
      (() => {
        const summary = getLemmaSummaryByIast(g.lemma_iast);
        return summary && summary.occurrenceCount >= 3
          ? localePathFor(`/lemma/${summary.slug}`, currentLang)
          : null;
      })(),
    word_idx: g.word_idx,
    word_sa: g.word_sa,
    lemma_sa: g.lemma_sa,
    lemma_iast: g.lemma_iast,
    gloss_text: g.gloss_text,
    morph: g.morph,
    occurrence_count: g.lemma_iast ? (occurrenceCounts.get(g.lemma_iast) ?? 0) : 0,
    text_slug: textRow.slug,
  })),
};

// All translations across every language for the TranslationDrawer.
// Drawer renders chips for the locked 11 langs and surfaces an honest
// "Not yet translated to {Lang}" empty state for missing ones.
const allTranslations = getVerseTranslations(verseRow.id);
const translationsPayload = allTranslations.map((t) => ({
  lang: t.lang,
  translator: t.translator,
  translation_text: t.translation_text,
  judge_score: t.judge_score,
  ai_assisted: t.ai_assisted,
  status: t.status,
  model: t.model,
}));

// Pre-bundle every supported reader-language's glosses + primary
// translation so ReaderLangSwap can do an instant client-side swap when
// the user picks Hindi / Tamil / etc. from the Reading Settings sheet.
// English fallback is the existing static HTML — if a lang is missing
// from this payload, ReaderLangSwap leaves the page unchanged.
const allLang = getVerseAllLanguages(text!, chapterNum, verseNum);
const readerDataPayload = {
  glosses_by_lang: allLang?.glosses_by_lang ?? {},
  translations_by_lang: allLang?.translations_by_lang ?? {},
};
const basePath = `/${tradition}/${text}/${chapterNum}/${verseNum}`;
const liveLangs = liveLocaleSet();
const availableLangs = filterIndexableTextLangs(
  textRow.slug,
  getVerseAvailability(text!, chapterNum, verseNum).filter((lang) => liveLangs.has(lang)),
);
const pageSeo = buildVerseSeo({
  availableLangs,
  basePath,
  lang: currentLang,
  text: textRow,
  translation: translations[0]?.translation_text ?? null,
  verse: verseRow,
});
const lowFrequencyTermJsonLd = Array.from(
  wordGlosses
    .reduce((terms, gloss) => {
      if (!gloss.lemma_iast || terms.has(gloss.lemma_iast)) return terms;
      const summary = getLemmaSummaryByIast(gloss.lemma_iast);
      if (!summary || summary.occurrenceCount >= 3 || !gloss.gloss_text) return terms;
      terms.set(
        gloss.lemma_iast,
        buildDefinedTermJsonLd({
          alternateName: gloss.lemma_sa,
          description: gloss.gloss_text,
          inLanguage: inLanguageTag(currentLang),
          name: gloss.lemma_iast,
          termCode: gloss.lemma_iast,
          url: `${pageSeo.canonical}#word-${gloss.word_idx}`,
        }),
      );
      return terms;
    }, new Map<string, ReturnType<typeof buildDefinedTermJsonLd>>())
    .values(),
);
const pageJsonLd = [...pageSeo.jsonLd, ...lowFrequencyTermJsonLd];

// Short-verse heuristic (audit 2026-06-01 #13): aphoristic sūtras like
// Śiva Sūtra 1.1 ("Consciousness is the Self.") leave huge empty space
// below the prev/next nav. When translation < 200 chars OR no
// word-by-word glosses, render a quiet "Continue reading" affordance
// linking back to the text overview so the reader has somewhere to go.
const primaryTranslationLength = translations[0]?.translation_text?.length ?? 0;
const isShortVerse = primaryTranslationLength < 200 || wordGlosses.length === 0;

const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: tradition!, href: `/${tradition}` },
  { name: textRow.title_en, href: `/${tradition}/${textRow.slug}` },
  { name: `${verseRow.chapter}.${verseRow.verse_num}` },
];
---

<BaseLayout
  canonical={pageSeo.canonical}
  description={pageSeo.description}
  hreflang={pageSeo.hreflang}
  jsonLd={pageJsonLd}
  lang={currentLang}
  localeBasePath={basePath}
  noindex={pageSeo.noindex}
  ogImageUrl={pageSeo.ogImageUrl}
  title={pageSeo.title}
>
  <header class="chrome">
    <a
      href={`/${tradition}/${text}`}
      class="chrome__back"
      aria-label="Back to text"
      data-i18n-attr-aria-label="verse_page.back_aria"
    >
      ←
    </a>
    <div class="chrome__title">
      <span class="chrome__text">{textRow.title_en}</span>
      <span class="chrome__verse">· {chapterNum}.{verseNum}</span>
    </div>
    <div class="chrome__tools">
      <ScriptSwitcher client:idle />
      <button
        type="button"
        class="chrome__settings"
        aria-label="Reading settings"
        data-i18n-attr-aria-label="verse_page.settings_aria"
        data-settings-trigger
        onclick="document.dispatchEvent(new CustomEvent('sohamhamso:open-settings'))"
      >
        Aa
      </button>
    </div>
  </header>

  <main id="main" class="reader">
    <Breadcrumbs items={breadcrumbItems} lang={currentLang} />
    {/*
      Visually-hidden primary heading. Screen readers need an <h1> as the
      page landmark; visually the verse-number rail (1.47) inside
      VerseAnatomy continues to serve as the visual title. See audit
      2026-06-01 recommendation #8.
    */}
    <h1 class="visually-hidden">{textRow.title_en} {chapterNum}.{verseNum}</h1>

    <VerseAnatomy
      verse={verseRow}
      wordGlosses={wordGlosses}
      translations={translations}
    >
      <Fragment slot="chips">
        <ParallelChip parallels={parallels} />
      </Fragment>

      <Fragment slot="footer">
        <LangSwitcher availableLangs={availableLangs} basePath={basePath} currentLang={currentLang} />
        {translations.map((t) => (
          <AIAssistedBadge
            aiAssisted={t.ai_assisted}
            status={t.status}
            translator={t.translator}
            model={t.model}
            modelVersion={t.model_version}
            promptVersion={t.prompt_version}
            reviewerName={t.reviewer}
            generatedAt={t.reviewed_at}
          />
        ))}
        {textRow.manuscript_url ? (
          <a
            href={textRow.manuscript_url}
            target="_blank"
            rel="noopener noreferrer"
            class="manuscript-link"
          >
            📜 <span data-i18n="verse.manuscript_prefix">View manuscript at</span> {textRow.source ?? "source"}
            {verseRow.manuscript_folio_ref ? (
              <span> · <span data-i18n="verse.manuscript_folio_prefix">folio</span> {verseRow.manuscript_folio_ref}</span>
            ) : null}
          </a>
        ) : null}
      </Fragment>
    </VerseAnatomy>

    <nav class="verse-nav" aria-label="Verse navigation" data-i18n-attr-aria-label="verse_page.nav_aria">
      {prev ? (
        <a
          href={`/${tradition}/${text}/${prev.chapter}/${prev.verse_num}`}
          class="verse-nav__prev"
        >
          ← {prev.chapter}.{prev.verse_num}
        </a>
      ) : (
        <span class="verse-nav__spacer" />
      )}
      {next ? (
        <a
          href={`/${tradition}/${text}/${next.chapter}/${next.verse_num}`}
          class="verse-nav__next"
        >
          {next.chapter}.{next.verse_num} →
        </a>
      ) : (
        <span class="verse-nav__spacer" />
      )}
    </nav>

    {isShortVerse ? (
      <aside class="verse-continue" aria-label="Continue reading">
        <a class="verse-continue__link" href={`/${tradition}/${text}`}>
          <span data-i18n="verse.continue.about_text">About this text</span> →
        </a>
        {next ? (
          <a
            class="verse-continue__link"
            href={`/${tradition}/${text}/${next.chapter}/${next.verse_num}`}
          >
            <span data-i18n="verse.continue.next_verse">Next verse</span> →
          </a>
        ) : null}
      </aside>
    ) : null}
  </main>

  <WordSheet client:idle />
  <TranslationDrawer client:idle />
  {/* ReaderLangSwap is mounted globally in BaseLayout — it consumes
      the `window.__readerData` payload injected below. */}

  <script is:inline set:html={`window.__wordGlosses = ${safeJsonForScript(glossesPayload)};`} />
  <script is:inline set:html={`window.__translations = ${safeJsonForScript(translationsPayload)};`} />
  <script is:inline set:html={`window.__readerData = ${safeJsonForScript(readerDataPayload)};`} />
</BaseLayout>

<style>
  .chrome {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    padding: var(--spacing-2) var(--spacing-4);
    min-height: 48px;
    background: var(--color-bg);
    border-block-end: 1px solid var(--color-rule);
    backdrop-filter: none; /* no glassmorphism per anti-pattern list */
  }
  .chrome__back {
    appearance: none;
    background: transparent;
    border: 0;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-lg);
    color: var(--color-ink);
    text-decoration: none;
    cursor: pointer;
  }
  .chrome__title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-chrome);
    font-size: var(--text-sm);
    color: var(--color-ink);
  }
  .chrome__text {
    font-weight: 500;
  }
  .chrome__verse {
    color: var(--color-ink-muted);
    margin-left: 4px;
  }
  .chrome__tools {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
  }
  .chrome__settings {
    appearance: none;
    background: transparent;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    padding: 8px 12px;
    min-height: 44px;
    font-family: var(--font-chrome);
    font-size: var(--text-sm);
    color: var(--color-ink);
    cursor: pointer;
  }
  .chrome__settings:hover {
    border-color: var(--color-ink-muted);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 999px;
    font-family: var(--font-chrome);
    font-size: 11px;
    background: #F1F5F9;
    border: 1px solid #CBD5E1;
    color: #1E293B;
  }

  .manuscript-link {
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .verse-nav {
    display: flex;
    justify-content: space-between;
    padding-block: var(--spacing-6);
    font-family: var(--font-chrome);
    font-size: var(--text-sm);
  }
  .verse-nav__prev,
  .verse-nav__next {
    color: var(--color-ink);
    text-decoration: none;
    padding: var(--spacing-3) var(--spacing-4);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .verse-nav__prev:hover,
  .verse-nav__next:hover {
    border-color: var(--color-ink-muted);
  }
  .verse-nav__spacer {
    width: 1px;
  }

  /*
   * Empty-state CTA for short verses (audit 2026-06-01 #13). Aphoristic
   * sūtras leave vast whitespace below the prev/next nav; this gives
   * the reader 1–2 quiet next-step links instead. Single column,
   * ink-muted, font-chrome — no card grid, no SaaS patterns.
   */
  .verse-continue {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    padding-block: var(--spacing-6);
    border-block-start: 1px solid var(--color-rule);
    font-family: var(--font-chrome);
    font-size: var(--text-sm);
  }
  .verse-continue__link {
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .verse-continue__link:hover,
  .verse-continue__link:focus-visible {
    color: var(--color-ink);
  }
</style>
