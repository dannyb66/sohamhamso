---
import AIAssistedBadge from '../../../../components/AIAssistedBadge.astro';
import Footer from '../../../../components/Footer.astro';
import Masthead from '../../../../components/Masthead.astro';
import ParallelChip from '../../../../components/ParallelChip.astro';
import ScriptSwitcher from '../../../../components/ScriptSwitcher.solid';
import TranslationDrawer from '../../../../components/TranslationDrawer.solid';
import VerseAnatomy from '../../../../components/VerseAnatomy.astro';
import WordSheet from '../../../../components/WordSheet.solid';
import Breadcrumbs from '../../../../components/seo/Breadcrumbs.astro';
import LangSwitcher from '../../../../components/seo/LangSwitcher.astro';
/**
 * Verse-page route: /{tradition}/{text-slug}/{chapter}/{verse}
 *
 * SERVER-RENDERED (A6 phase 2): `prerender = false` — this route renders at
 * request time in the Cloudflare Pages worker instead of emitting one
 * static file per verse (226 verses × 12 locales ≈ +10k files was on a
 * collision course with CF Pages' 20k-file deploy limit).
 *
 * Runtime/data routing is EXPLICIT, not sniffed per-request:
 *   - bun (astro dev, tests, build host): `readVersePage()` →
 *     corpus-db.ts bun backend → bun:sqlite on db/sohamhamso.db.
 *   - workerd (deployed CF worker): same call → libsql `batch()` over
 *     HTTPS to the Turso corpus DB (TURSO_CORPUS_URL +
 *     TURSO_CORPUS_AUTH_TOKEN, set as CF Pages secrets). ONE round-trip
 *     for the whole page payload — see src/lib/verse-read.ts.
 *
 * NEVER import value bindings from src/lib/db.ts here — that's the
 * bun:sqlite reader and this module ships into the worker bundle (see
 * masthead-edge-compat.regression-1.test.ts for the failure mode).
 *
 * Alias handling: wrong-tradition/wrong-slug URLs 301 to canonical via
 * resolveVerseAlias() (the per-verse static redirect pages that
 * getStaticPaths used to emit are gone). public/_redirects wildcards
 * cover the same surface at the CDN before the worker is invoked.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { computeIsShortVerse, isProseSection } from '../../../../lib/prose';
import type { LangCode } from '../../../../lib/reading-modes';
import { safeJsonForScript } from '../../../../lib/safe-json';
import {
  buildChromeSeo,
  buildDefinedTermJsonLd,
  buildVerseSeo,
  filterIndexableTextLangs,
  inLanguageTag,
  liveLocaleSet,
  localePathFor,
} from '../../../../lib/seo';
import { readVersePage, resolveVerseAlias } from '../../../../lib/verse-read';

export const prerender = false;

const { tradition, text, chapter, verse } = Astro.params;
const currentLang: LangCode = 'en';

// Param validation: chapter/verse must be positive integers. Anything else
// (e.g. /trika/siva-sutras/notes/1) is a genuine 404 — no DB round-trip.
const POSITIVE_INT_RE = /^\d+$/;
const paramsValid =
  POSITIVE_INT_RE.test(chapter ?? '') && POSITIVE_INT_RE.test(verse ?? '') && !!text && !!tradition;
const chapterNum = paramsValid ? Number(chapter) : Number.NaN;
const verseNum = paramsValid ? Number(verse) : Number.NaN;

// 'unavailable' = corpus DB unreachable/misconfigured (styled 503);
// 'not-found'   = the verse ref genuinely doesn't exist (styled 404).
let state: 'ok' | 'not-found' | 'unavailable' = 'not-found';
let read: Awaited<ReturnType<typeof readVersePage>> | null = null;

if (paramsValid) {
  try {
    read = await readVersePage(text!, chapterNum, verseNum, currentLang);
  } catch (e) {
    console.error('[verse-ssr] corpus read failed:', e);
    state = 'unavailable';
  }
}

if (read) {
  // Alias/tradition resolution BEFORE rendering: /shaiva/siva-sutras/1/1
  // and /trika/shiva-sutras/1/1 301 to the canonical URL, mirroring the
  // public/_redirects wildcards.
  const alias = resolveVerseAlias(tradition!, text!, read.texts);
  if (alias && !alias.canonical) {
    return Astro.redirect(
      `/${alias.canonicalTradition}/${alias.canonicalSlug}/${chapterNum}/${verseNum}`,
      301,
    );
  }
  if (alias?.canonical && read.bundle) {
    state = 'ok';
  }
}

const data = state === 'ok' ? read!.bundle! : null;

// Cache strategy: the corpus only changes on deploy, so OK responses get a
// long shared-cache TTL + stale-while-revalidate. NOTE Cloudflare does NOT
// automatically edge-cache Pages Function responses — these headers serve
// browsers and any intermediate shared caches; CF's CDN cache only applies
// if a caching layer (Cache API / cache rules) is added later. Deploys
// must therefore be treated as the cache-invalidation boundary: if edge
// caching is ever enabled for these routes, purge the zone cache on deploy
// (the content hash changes only then).
if (state === 'ok') {
  Astro.response.headers.set(
    'Cache-Control',
    'public, max-age=300, s-maxage=86400, stale-while-revalidate=604800',
  );
} else if (state === 'not-found') {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'public, max-age=300');
} else {
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
  Astro.response.headers.set('Retry-After', '30');
}

// ── Verse view (only when state === 'ok') ──────────────────────────────────
type VerseView = {
  textRow: NonNullable<typeof data>['text'];
  verseRow: NonNullable<typeof data>['verse'];
  translations: NonNullable<typeof data>['translations'];
  wordGlosses: NonNullable<typeof data>['wordGlosses'];
  parallels: NonNullable<typeof data>['parallels'];
  prev: NonNullable<typeof data>['prev'];
  next: NonNullable<typeof data>['next'];
  glossesPayload: Record<string, unknown>;
  translationsPayload: unknown[];
  readerDataPayload: Record<string, unknown>;
  basePath: string;
  availableLangs: LangCode[];
  pageSeo: ReturnType<typeof buildVerseSeo>;
  pageJsonLd: ReturnType<typeof buildVerseSeo>['jsonLd'];
  isShortVerse: boolean;
  isProse: boolean;
  chapterVerseCount: number | null;
  breadcrumbItems: Array<{ name: string; href?: string }>;
};

let view: VerseView | null = null;

if (data) {
  const { text: textRow, verse: verseRow, translations, wordGlosses, parallels, prev, next } = data;

  // Group glosses by verse_id for the WordSheet's window.__wordGlosses
  // lookup. `occurrence_count` is the number of *other* verses in this text
  // that contain the same lemma; 0/undefined hides the "more occurrences"
  // link. `text_slug` is injected once so WordSheet can build search URLs
  // without needing additional payload. Lemma hrefs + occurrence counts come
  // from the SAME batched read (no extra round-trips).
  const glossesPayload = {
    [String(verseRow.id)]: wordGlosses.map((g) => {
      const summary = g.lemma_iast ? data.lemmaSummaries.get(g.lemma_iast) : undefined;
      return {
        lemma_href:
          summary && summary.occurrenceCount >= 3
            ? localePathFor(`/lemma/${summary.slug}`, currentLang)
            : null,
        word_idx: g.word_idx,
        word_sa: g.word_sa,
        lemma_sa: g.lemma_sa,
        lemma_iast: g.lemma_iast,
        gloss_text: g.gloss_text,
        morph: g.morph,
        occurrence_count: g.lemma_iast ? (data.occurrenceCounts.get(g.lemma_iast) ?? 0) : 0,
        text_slug: textRow.slug,
      };
    }),
  };

  // All translations across every language for the TranslationDrawer.
  // Drawer renders chips for the locked 11 langs and surfaces an honest
  // "Not yet translated to {Lang}" empty state for missing ones.
  const translationsPayload = data.allTranslations.map((t) => ({
    lang: t.lang,
    translator: t.translator,
    translation_text: t.translation_text,
    judge_score: t.judge_score,
    ai_assisted: t.ai_assisted,
    status: t.status,
    model: t.model,
  }));

  // Pre-bundle every supported reader-language's glosses + primary
  // translation so ReaderLangSwap can do an instant client-side swap when
  // the user picks Hindi / Tamil / etc. from the Reading Settings sheet.
  const readerDataPayload = {
    glosses_by_lang: data.glossesByLang,
    translations_by_lang: data.translationsByLang,
  };

  const basePath = `/${tradition}/${text}/${chapterNum}/${verseNum}`;
  const liveLangs = liveLocaleSet();
  const availableLangs = filterIndexableTextLangs(
    textRow.slug,
    (data.availability as LangCode[]).filter((lang) => liveLangs.has(lang)),
  );
  const pageSeo = buildVerseSeo({
    availableLangs,
    basePath,
    lang: currentLang,
    text: textRow,
    translation: translations[0]?.translation_text ?? null,
    verse: verseRow,
  });
  const lowFrequencyTermJsonLd = Array.from(
    wordGlosses
      .reduce((terms, gloss) => {
        if (!gloss.lemma_iast || terms.has(gloss.lemma_iast)) return terms;
        const summary = data.lemmaSummaries.get(gloss.lemma_iast);
        if (!summary || summary.occurrenceCount >= 3 || !gloss.gloss_text) return terms;
        terms.set(
          gloss.lemma_iast,
          buildDefinedTermJsonLd({
            alternateName: gloss.lemma_sa,
            description: gloss.gloss_text,
            inLanguage: inLanguageTag(currentLang),
            name: gloss.lemma_iast,
            termCode: gloss.lemma_iast,
            url: `${pageSeo.canonical}#word-${gloss.word_idx}`,
          }),
        );
        return terms;
      }, new Map<string, ReturnType<typeof buildDefinedTermJsonLd>>())
      .values(),
  );
  const pageJsonLd = [...pageSeo.jsonLd, ...lowFrequencyTermJsonLd];

  // Short-verse heuristic (audit 2026-06-01 #13): aphoristic sūtras like
  // Śiva Sūtra 1.1 ("Consciousness is the Self.") leave huge empty space
  // below the prev/next nav. When translation < 200 chars OR no
  // word-by-word glosses, render a quiet "Continue reading" affordance
  // linking back to the text overview so the reader has somewhere to go.
  const primaryTranslationLength = translations[0]?.translation_text?.length ?? 0;
  // computeIsShortVerse (src/lib/prose.ts) carries the short-verse heuristic
  // AND the prose guard: prose blocks ship no word glosses in V1, so the
  // `wordGlosses.length === 0` arm must never fire for section_type='prose'.
  const isShortVerse = computeIsShortVerse({
    sectionType: verseRow.section_type,
    translationLength: primaryTranslationLength,
    glossCount: wordGlosses.length,
  });
  // Wayfinding labels switch verse->passage for prose blocks; the numeric
  // chrome locator ({chapter}.{verse}) is unchanged either way.
  const isProse = isProseSection(verseRow.section_type);

  const breadcrumbItems = [
    { name: 'Home', href: '/' },
    { name: tradition!, href: `/${tradition}` },
    { name: textRow.title_en, href: `/${tradition}/${textRow.slug}` },
    { name: `${verseRow.chapter}.${verseRow.verse_num}` },
  ];

  view = {
    textRow,
    verseRow,
    translations,
    wordGlosses,
    parallels,
    prev,
    next,
    glossesPayload,
    translationsPayload,
    readerDataPayload,
    basePath,
    availableLangs,
    pageSeo,
    pageJsonLd,
    isShortVerse,
    isProse,
    // Verse-position indicator (plan wayfinding): the chrome locator becomes
    // "5.22 / 142" so the reader can sense chapter length. The denominator
    // comes from the same batched read as prev/next, so it always matches
    // navigation. Null-guard keeps the chrome rendering "5.22" if missing.
    chapterVerseCount: data.chapterVerseCount,
    breadcrumbItems,
  };
}

// ── Error view (styled 404/503 reusing the 404.astro posture) ──────────────
const errorSeo =
  state === 'ok'
    ? null
    : buildChromeSeo({
        basePath: Astro.url.pathname,
        description:
          state === 'not-found'
            ? "This verse isn't in the corpus. Yet. Try searching, browsing the texts, or telling us what's missing."
            : 'The reader is briefly unavailable. The verse is still in the corpus — try again in a moment.',
        lang: currentLang,
        noindex: true,
        title:
          state === 'not-found' ? 'Not Found — sohamhamso' : 'Temporarily unavailable — sohamhamso',
      });
---

{view ? (
  <BaseLayout
    canonical={view.pageSeo.canonical}
    description={view.pageSeo.description}
    hreflang={view.pageSeo.hreflang}
    jsonLd={view.pageJsonLd}
    lang={currentLang}
    localeBasePath={view.basePath}
    noindex={view.pageSeo.noindex}
    ogImageUrl={view.pageSeo.ogImageUrl}
    title={view.pageSeo.title}
  >
  <header class="chrome">
    <a
      href={`/${tradition}/${text}`}
      class="chrome__back"
      aria-label="Back to text"
      data-i18n-attr-aria-label="verse_page.back_aria"
    >
      ←
    </a>
    <div class="chrome__title">
      <span class="chrome__text">{view.textRow.title_en}</span>
      <span class="chrome__verse">· {chapterNum}.{verseNum}{view.chapterVerseCount ? <span class="chrome__count"> / {view.chapterVerseCount}</span> : null}</span>
    </div>
    <div class="chrome__tools">
      <ScriptSwitcher client:idle />
      <button
        type="button"
        class="chrome__settings"
        aria-label="Reading settings"
        data-i18n-attr-aria-label="verse_page.settings_aria"
        data-settings-trigger
        onclick="document.dispatchEvent(new CustomEvent('sohamhamso:open-settings'))"
      >
        Aa
      </button>
    </div>
  </header>

  <main id="main" class="reader">
    <Breadcrumbs items={view.breadcrumbItems} lang={currentLang} />
    {/*
      Visually-hidden primary heading. Screen readers need an <h1> as the
      page landmark; visually the verse-number rail (1.47) inside
      VerseAnatomy continues to serve as the visual title. See audit
      2026-06-01 recommendation #8.
    */}
    <h1 class="visually-hidden">{view.textRow.title_en} {chapterNum}.{verseNum}</h1>

    <VerseAnatomy
      verse={view.verseRow}
      wordGlosses={view.wordGlosses}
      translations={view.translations}
    >
      <Fragment slot="chips">
        <ParallelChip parallels={view.parallels} />
      </Fragment>

      <Fragment slot="footer">
        <LangSwitcher availableLangs={view.availableLangs} basePath={view.basePath} currentLang={currentLang} />
        {view.translations.map((t) => (
          <AIAssistedBadge
            aiAssisted={t.ai_assisted}
            status={t.status}
            translator={t.translator}
            model={t.model}
            modelVersion={t.model_version}
            promptVersion={t.prompt_version}
            reviewerName={t.reviewer}
            generatedAt={t.reviewed_at}
          />
        ))}
        {view.textRow.manuscript_url ? (
          <a
            href={view.textRow.manuscript_url}
            target="_blank"
            rel="noopener noreferrer"
            class="manuscript-link"
          >
            📜 <span data-i18n="verse.manuscript_prefix">View manuscript at</span> {view.textRow.source ?? "source"}
            {view.verseRow.manuscript_folio_ref ? (
              <span> · <span data-i18n="verse.manuscript_folio_prefix">folio</span> {view.verseRow.manuscript_folio_ref}</span>
            ) : null}
          </a>
        ) : null}
      </Fragment>
    </VerseAnatomy>

    <nav
      class="verse-nav"
      aria-label={view.isProse ? 'Passage navigation' : 'Verse navigation'}
      data-i18n-attr-aria-label={view.isProse ? 'verse_page.nav_aria_passage' : 'verse_page.nav_aria'}
    >
      {view.prev ? (
        <a
          href={`/${tradition}/${text}/${view.prev.chapter}/${view.prev.verse_num}`}
          class="verse-nav__prev"
          aria-label={`${view.isProse ? 'Previous passage' : 'Previous verse'} ${view.prev.chapter}.${view.prev.verse_num}`}
        >
          ← {view.prev.chapter}.{view.prev.verse_num}
        </a>
      ) : (
        <span class="verse-nav__spacer" />
      )}
      {view.next ? (
        <a
          href={`/${tradition}/${text}/${view.next.chapter}/${view.next.verse_num}`}
          class="verse-nav__next"
          aria-label={`${view.isProse ? 'Next passage' : 'Next verse'} ${view.next.chapter}.${view.next.verse_num}`}
        >
          {view.next.chapter}.{view.next.verse_num} →
        </a>
      ) : (
        <span class="verse-nav__spacer" />
      )}
    </nav>

    {view.isShortVerse ? (
      <aside class="verse-continue" aria-label="Continue reading">
        <a class="verse-continue__link" href={`/${tradition}/${text}`}>
          <span data-i18n="verse.continue.about_text">About this text</span> →
        </a>
        {view.next ? (
          <a
            class="verse-continue__link"
            href={`/${tradition}/${text}/${view.next.chapter}/${view.next.verse_num}`}
          >
            <span data-i18n="verse.continue.next_verse">Next verse</span> →
          </a>
        ) : null}
      </aside>
    ) : null}
  </main>

  <WordSheet client:idle />
  <TranslationDrawer client:idle />
  {/* ReaderLangSwap is mounted globally in BaseLayout — it consumes
      the `window.__readerData` payload injected below. */}

  <script is:inline set:html={`window.__wordGlosses = ${safeJsonForScript(view.glossesPayload)};`} />
  <script is:inline set:html={`window.__translations = ${safeJsonForScript(view.translationsPayload)};`} />
  <script is:inline set:html={`window.__readerData = ${safeJsonForScript(view.readerDataPayload)};`} />
  </BaseLayout>
) : (
  <BaseLayout
    canonical={errorSeo!.canonical}
    description={errorSeo!.description}
    hreflang={errorSeo!.hreflang}
    jsonLd={errorSeo!.jsonLd}
    lang={currentLang}
    noindex={errorSeo!.noindex}
    title={errorSeo!.title}
  >
    <Masthead currentLang="EN" />

    {/* Mirrors src/pages/404.astro — same posture, verse-route copy. */}
    <main id="main" class="not-found">
      <p class="not-found__eyebrow">{state === 'not-found' ? '404' : '503'}</p>
      {state === 'not-found' ? (
        <>
          <h1 class="not-found__title">This verse isn&apos;t in the corpus. Yet.</h1>
          <p class="not-found__lede">
            Try searching, browsing the texts, or telling us what&apos;s missing.
          </p>
        </>
      ) : (
        <>
          <h1 class="not-found__title">The reader is briefly unavailable.</h1>
          <p class="not-found__lede">
            The verse is still in the corpus — our database didn&apos;t answer in time.
            Try again in a moment.
          </p>
        </>
      )}
      <nav class="not-found__actions" aria-label="Next steps">
        <a href="/search">Search the corpus</a>
        <a href="/texts">Browse all texts</a>
        <a href="/about/methodology">Read the methodology</a>
      </nav>
    </main>

    <Footer />
  </BaseLayout>
)}

<style>
  .chrome {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    padding: var(--spacing-2) var(--spacing-4);
    min-height: 48px;
    background: var(--color-bg);
    border-block-end: 1px solid var(--color-rule);
    backdrop-filter: none; /* no glassmorphism per anti-pattern list */
  }
  .chrome__back {
    appearance: none;
    background: transparent;
    border: 0;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-lg);
    color: var(--color-ink);
    text-decoration: none;
    cursor: pointer;
  }
  .chrome__title {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: baseline;
    white-space: nowrap;
    font-family: var(--font-chrome);
    font-size: var(--text-sm);
    color: var(--color-ink);
  }
  .chrome__text {
    font-weight: 500;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /*
   * The locator never shrinks: on tight mobile widths the text title
   * ellipsizes while "5.22 / 142" stays fully visible (wayfinding).
   */
  .chrome__verse {
    color: var(--color-ink-muted);
    margin-left: 4px;
    flex-shrink: 0;
  }
  /* Chapter-length denominator — typographically quieter than the locator. */
  .chrome__count {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
  .chrome__tools {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
  }
  .chrome__settings {
    appearance: none;
    background: transparent;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    padding: 8px 12px;
    min-height: 44px;
    font-family: var(--font-chrome);
    font-size: var(--text-sm);
    color: var(--color-ink);
    cursor: pointer;
  }
  .chrome__settings:hover {
    border-color: var(--color-ink-muted);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 999px;
    font-family: var(--font-chrome);
    font-size: 11px;
    background: #F1F5F9;
    border: 1px solid #CBD5E1;
    color: #1E293B;
  }

  .manuscript-link {
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .verse-nav {
    display: flex;
    justify-content: space-between;
    padding-block: var(--spacing-6);
    font-family: var(--font-chrome);
    font-size: var(--text-sm);
  }
  .verse-nav__prev,
  .verse-nav__next {
    color: var(--color-ink);
    text-decoration: none;
    padding: var(--spacing-3) var(--spacing-4);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .verse-nav__prev:hover,
  .verse-nav__next:hover {
    border-color: var(--color-ink-muted);
  }
  .verse-nav__spacer {
    width: 1px;
  }

  /*
   * Empty-state CTA for short verses (audit 2026-06-01 #13). Aphoristic
   * sūtras leave vast whitespace below the prev/next nav; this gives
   * the reader 1–2 quiet next-step links instead. Single column,
   * ink-muted, font-chrome — no card grid, no SaaS patterns.
   */
  .verse-continue {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    padding-block: var(--spacing-6);
    border-block-start: 1px solid var(--color-rule);
    font-family: var(--font-chrome);
    font-size: var(--text-sm);
  }
  .verse-continue__link {
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .verse-continue__link:hover,
  .verse-continue__link:focus-visible {
    color: var(--color-ink);
  }

  /* Error posture — mirrors src/pages/404.astro styles. */
  .not-found {
    max-width: 60ch;
    margin: 0 auto;
    padding: var(--spacing-10) var(--spacing-4) var(--spacing-12);
  }
  .not-found__eyebrow {
    margin: 0 0 var(--spacing-3);
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .not-found__title {
    margin: 0 0 var(--spacing-4);
    font-family: var(--font-iast);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    color: var(--color-ink);
  }
  .not-found__lede {
    margin: 0 0 var(--spacing-6);
    font-family: var(--font-iast);
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-ink-muted);
  }
  .not-found__actions {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    font-family: var(--font-chrome);
  }
  .not-found__actions a {
    color: var(--color-ink);
    text-decoration: none;
  }
</style>
