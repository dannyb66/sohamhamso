---
import KaulaContentAdvisory from '../../../components/KaulaContentAdvisory.astro';
import LangSwitcher from '../../../components/seo/LangSwitcher.astro';
/**
 * Text overview page: /{tradition}/{text-slug}
 * Lists chapters + verse counts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { enumerateRedirectPairs, resolveAlias } from '../../../lib/aliases';
import { getDb, getText, listChapters } from '../../../lib/db';
import type { LangCode } from '../../../lib/reading-modes';
import { buildTextSeo, filterIndexableTextLangs, liveLocaleSet } from '../../../lib/seo';
import { getTexts } from '../../../lib/seo/corpus-bundle';

export async function getStaticPaths() {
  const canonical = getTexts().map((text) => ({
    params: { tradition: text.tradition, text: text.slug },
    props: { redirectTo: null as string | null },
  }));

  const aliases = enumerateRedirectPairs().map(
    ({ wrongTradition, wrongSlug, canonicalTradition, canonicalSlug }) => ({
      params: { tradition: wrongTradition, text: wrongSlug },
      props: { redirectTo: `/${canonicalTradition}/${canonicalSlug}` },
    }),
  );

  return [...canonical, ...aliases];
}

const { redirectTo } = Astro.props;
const { tradition, text } = Astro.params;

if (redirectTo) {
  return Astro.redirect(redirectTo, 301);
}

if (!text) throw new Error('Missing text route param');
const textRow = getText(text);
if (!textRow) throw new Error(`Text not found: ${text}`);
const chapters = listChapters(text);
const totalVerses = chapters.reduce((sum, c) => sum + c.verse_count, 0);
// Prose texts (plan A4): when the text carries section_type='prose' blocks,
// the chapter-table column header reads "Passages" instead of "Verses".
const proseBlockCount =
  getDb()
    .query<{ n: number }, [string]>(`
      SELECT COUNT(*) AS n
      FROM verses v
      JOIN texts t ON t.id = v.text_id
      WHERE t.slug = ? AND v.section_type = 'prose'
    `)
    .get(text)?.n ?? 0;
const isProseText = proseBlockCount > 0;
const currentLang: LangCode = 'en';
const availableLangs = filterIndexableTextLangs(
  textRow.slug,
  Array.from(liveLocaleSet()).sort() as LangCode[],
);
const basePath = `/${tradition}/${text}`;
const pageSeo = buildTextSeo({
  availableLangs,
  basePath,
  lang: currentLang,
  text: textRow,
  totalVerses,
});
---

<BaseLayout
  canonical={pageSeo.canonical}
  description={pageSeo.description}
  hreflang={pageSeo.hreflang}
  jsonLd={pageSeo.jsonLd}
  keywords={pageSeo.keywords}
  lang={currentLang}
  localeBasePath={basePath}
  title={pageSeo.title}
>
  <header class="chrome">
    <a href="/" class="chrome__back" aria-label="Home" data-i18n-attr-aria-label="text_overview.home_aria">←</a>
    <div class="chrome__title">
      <span>{textRow.title_en}</span>
    </div>
  </header>

  <main id="main" class="reader">
    <article class="text-overview">
      <KaulaContentAdvisory school={textRow.school} />
      <h1 class="text-title-en">{textRow.title_en}</h1>
      <p class="text-title-sa" lang="sa">{textRow.title_sa}</p>
      {textRow.title_iast ? (
        <p class="text-title-iast">{textRow.title_iast}</p>
      ) : null}
      {textRow.author ? (
        <p class="text-author"><span data-i18n="text_overview.by_prefix">by</span> {textRow.author}</p>
      ) : null}

      <hr class="shirorekha-rule" />

      {textRow.description ? (
        <p class="text-description">{textRow.description}</p>
      ) : null}

      <div class="text-meta">
        <span>{totalVerses} <span data-i18n="text_overview.verses_suffix">verses</span></span>
        <span>·</span>
        <span>{chapters.length} <span data-i18n={chapters.length === 1 ? "text_overview.chapter_suffix" : "text_overview.chapters_suffix"}>{chapters.length === 1 ? "chapter" : "chapters"}</span></span>
        <span>·</span>
        <span>{textRow.tradition}</span>
        {textRow.school ? (
          <>
            <span>·</span>
            <span>{textRow.school}</span>
          </>
        ) : null}
      </div>

      <hr class="shirorekha-rule" />

      <LangSwitcher availableLangs={availableLangs} basePath={basePath} currentLang={currentLang} />

      <hr class="shirorekha-rule" />

      {/*
        Chapter index (audit 2026-06-01 #11). The original <table>
        layout limited the tap target to the "Read chapter N →" anchor
        text on the right. We switched to a semantic <ul> of anchors
        so each row is one <a> — the entire row, including the
        chapter number and verse-count columns, navigates with one tap.
        The grid layout preserves the original "Chapter | Verses |
        Read →" visual rhythm; the header row mirrors the same grid
        for column alignment.
      */}
      <div class="chapter-table">
        <div class="chapter-row chapter-row--head" role="presentation">
          <span class="chapter-row__col-num" data-i18n="text_overview.table.chapter">Chapter</span>
          <span class="chapter-row__col-count" data-i18n={isProseText ? "text_overview.table.passages" : "text_overview.table.verses"}>{isProseText ? "Passages" : "Verses"}</span>
          <span class="chapter-row__col-cta" data-i18n="text_overview.table.read">Read</span>
        </div>
        <ul class="chapter-list">
          {chapters.map((c) => {
            // Wayfinding title ("5 — Creation of the world"); IAST fallback
            // for chapters whose YAML carries no English title.
            const chapterTitle = c.title_en ?? c.title_iast;
            return (
            <li>
              <a
                href={`/${tradition}/${text}/${c.chapter}`}
                class="chapter-row chapter-row__link"
                aria-label={`Read chapter ${c.chapter}${chapterTitle ? ` — ${chapterTitle}` : ""} — ${c.verse_count} verses`}
              >
                <span class="chapter-row__col-num">
                  {c.chapter}{chapterTitle ? (
                    <span class="chapter-row__title"> — {chapterTitle}</span>
                  ) : null}
                </span>
                <span class="chapter-row__col-count">{c.verse_count}</span>
                <span class="chapter-row__col-cta">
                  <span data-i18n="text_overview.read_chapter_prefix">Read chapter</span> {c.chapter} →
                </span>
              </a>
            </li>
            );
          })}
        </ul>
      </div>

      {textRow.source || textRow.manuscript_url ? (
        <footer class="text-attribution">
          <p>
            {textRow.source ? <span><span data-i18n="text_overview.source_prefix">Source:</span> {textRow.source}</span> : null}
            {textRow.source && textRow.license ? " · " : null}
            {textRow.license ? <span><span data-i18n="text_overview.license_prefix">License:</span> {textRow.license}</span> : null}
          </p>
          {textRow.manuscript_url ? (
            <p>
              <a
                href={textRow.manuscript_url}
                target="_blank"
                rel="noopener noreferrer"
              >
                📜 <span data-i18n="text_overview.view_manuscript">View manuscript ↗</span>
              </a>
            </p>
          ) : null}
        </footer>
      ) : null}
    </article>
  </main>
</BaseLayout>

<style>
  .chrome {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    padding: var(--spacing-2) var(--spacing-4);
    min-height: 48px;
    background: var(--color-bg);
    border-block-end: 1px solid var(--color-rule);
  }
  .chrome__back {
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-lg);
    color: var(--color-ink);
    text-decoration: none;
  }
  .chrome__title {
    flex: 1;
    font-family: var(--font-chrome);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .text-overview {
    padding-block: var(--spacing-6);
  }
  .text-title-en {
    font-family: var(--font-iast);
    font-size: var(--text-xl);
    margin: 0;
    color: var(--color-ink);
  }
  .text-title-sa {
    font-family: var(--font-sa-display);
    font-size: var(--text-lg);
    margin: var(--spacing-2) 0 0 0;
    color: var(--color-ink);
  }
  .text-title-iast {
    font-family: var(--font-iast);
    font-style: italic;
    font-size: var(--text-base);
    color: var(--color-ink-muted);
    margin: 0;
  }
  .text-author {
    font-family: var(--font-iast);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    margin: var(--spacing-2) 0 0 0;
  }

  .text-description {
    font-family: var(--font-iast);
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-ink);
    max-width: var(--width-reader);
  }

  .text-meta {
    display: flex;
    gap: var(--spacing-2);
    font-family: var(--font-chrome);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    flex-wrap: wrap;
  }

  .chapter-table {
    width: 100%;
    font-family: var(--font-chrome);
    font-size: var(--text-sm);
  }
  .chapter-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chapter-list li {
    margin: 0;
  }

  /*
   * Whole-row tap target (audit 2026-06-01 #11). Each row is one
   * <a> with a 3-column grid that preserves the original
   * "Chapter | Verses | Read chapter N →" rhythm. min-height pulls
   * the row above WCAG 2.5.5 (44px). Hover/focus state cascades to
   * the entire row, not just the link text.
   */
  .chapter-row {
    display: grid;
    /* First column flexes so optional chapter titles ("5 — Creation of the
       world") fit; fixed/fr tracks keep columns aligned across rows. */
    grid-template-columns: minmax(96px, 1fr) 96px 1fr;
    align-items: center;
    padding: var(--spacing-3) var(--spacing-2);
    border-block-end: 1px solid var(--color-rule);
    min-height: 44px;
  }
  .chapter-row--head {
    font-weight: 500;
    color: var(--color-ink-muted);
    text-transform: uppercase;
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
  }
  .chapter-row__link {
    color: inherit;
    text-decoration: none;
  }
  .chapter-row__link:hover,
  .chapter-row__link:focus-visible {
    background: var(--color-rule);
    text-decoration: none;
  }
  .chapter-row__col-num {
    font-variant-numeric: tabular-nums;
  }
  .chapter-row__title {
    color: var(--color-ink-muted);
    font-variant-numeric: normal;
  }
  .chapter-row__col-count {
    color: var(--color-ink-muted);
  }

  .text-attribution {
    margin-top: var(--spacing-6);
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
  .text-attribution p {
    margin: var(--spacing-2) 0;
  }
</style>
