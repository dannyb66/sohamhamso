---
import Masthead from '../components/Masthead.astro';
/**
 * /search?q=... — full search results page.
 *
 * Server-side runs `blendedSearch` (B2) if available. If B2 hasn't
 * landed, renders a friendly placeholder so the route still works.
 *
 * SSR note: Astro is `output: 'static'`. This page renders at request
 * time only when an adapter is wired up; under pure static export it
 * will be prerendered with an empty query and the client should rely on
 * the SearchBox overlay instead. We opt-out of prerender so once an
 * adapter lands the page just works.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import type { VerseHit } from '../lib/search';
import { buildChromeSeo } from '../lib/seo';
import { matchUpcoming } from '../lib/upcoming-texts';

export const prerender = false;

const qRaw = (Astro.url.searchParams.get('q') ?? '').trim();
const q = qRaw.slice(0, 500);
const lang = (Astro.url.searchParams.get('lang') ?? 'en').toLowerCase();
const limit = 50;

// Try the B2 helper. If absent, fall back to a placeholder render so
// B9/B10 is shippable independently.
let results: VerseHit[] = [];
let stub = false;
let took_ms = 0;
let searchError: string | null = null;

if (q) {
  const t0 = performance.now();
  try {
    const lib = await import('../lib/search.ts').catch(() => null);
    if (lib && typeof lib.blendedSearch === 'function') {
      const out = await lib.blendedSearch(q, lang, limit);
      results = Array.isArray(out) ? out : [];
    } else {
      stub = true;
    }
  } catch (e) {
    searchError = (e as Error)?.message ?? 'Search failed.';
  }
  took_ms = Math.round(performance.now() - t0);
}

// D7 remainder: when a zero-result query names a Phase 2 staged text, add a
// quiet "{Title} is in preparation — get notified" line to the empty state.
// (The demand-logging half lives in src/lib/search-miss.ts via /api/search.)
const upcoming =
  q && !stub && !searchError && results.length === 0 ? matchUpcoming(q) : null;

const verseHref = (h: VerseHit) => `/${h.tradition}/${h.text_slug}/${h.chapter}/${h.verse_num}`;
const verseLabel = (h: VerseHit) => `${h.text_title} ${h.chapter}.${h.verse_num}`;

const currentLang = 'en' as const;
const title = q ? `Search: ${q} — sohamhamso` : 'Search — sohamhamso';
const pageSeo = buildChromeSeo({
  basePath: '/search',
  description: q
    ? `Search results for "${q}" across the sohamhamso corpus.`
    : 'Search verses, lemmas, and translations across the sohamhamso corpus.',
  lang: currentLang,
  noindex: true,
  title,
});
---

<BaseLayout
  canonical={pageSeo.canonical}
  description={pageSeo.description}
  hreflang={pageSeo.hreflang}
  jsonLd={pageSeo.jsonLd}
  lang={currentLang}
  noindex={pageSeo.noindex}
  title={pageSeo.title}
>
  <Masthead />

  <main class="search-page" id="main">
    <header class="search-page__head">
      <h1 class="search-page__title">
        {q ? (
          <>
            Search results for <span class="search-page__q">“{q}”</span>
          </>
        ) : (
          "Search"
        )}
      </h1>
      {q && !stub && !searchError ? (
        <p class="search-page__meta">
          {results.length} {results.length === 1 ? "result" : "results"}
          {took_ms ? ` · ${took_ms}ms` : ""}
        </p>
      ) : null}
    </header>

    {!q ? (
      <section class="search-page__empty">
        <p>
          Use the magnifier in the top-right (or press <kbd>⌘</kbd>+<kbd>K</kbd>)
          to search verses, lemmas, and translations across the entire
          corpus. Try queries like <em>pratyabhijñā</em>,
          <em> wherever the mind goes</em>, or <em>कृष्ण</em>.
        </p>
      </section>
    ) : stub ? (
      <section class="search-page__stub">
        <p>
          Semantic search arrives in V1.1. For now, try a verse permalink
          directly — e.g.{" "}
          <a href="/trika/siva-sutras/1/1">/trika/siva-sutras/1/1</a> — or
          <a href="/texts"> browse all texts</a>.
        </p>
      </section>
    ) : searchError ? (
      <section class="search-page__err" role="alert">
        <p>Search failed: {searchError}</p>
        <p>
          Try a simpler query or <a href="/texts">browse all texts</a>.
        </p>
      </section>
    ) : results.length === 0 ? (
      <section class="search-page__none">
        <p>
          No verses matched <em>“{q}”</em>. Try <code>kṛṣṇa</code> instead
          of <code>krishna</code> — or
          <a href="/texts"> browse all texts →</a>
        </p>
        {upcoming ? (
          <p class="search-page__upcoming">
            <em>{upcoming.title}</em>{" "}
            <span data-i18n="upcoming.in_preparation">is in preparation</span>
            {" — "}
            <a href="/daily" data-i18n="upcoming.get_notified">get notified</a>
          </p>
        ) : null}
      </section>
    ) : (
      <ol class="search-page__list">
        {(() => {
          // Group consecutive results by text_slug so each text title appears
          // once as a section header, with its matching verses listed beneath
          // (audit-2026-06-01 recommendation #7). Server already returns
          // results in a stable order; we only collapse the header — the
          // underlying data shape from blendedSearch() is unchanged.
          const groups: { slug: string; title: string; hits: VerseHit[] }[] = [];
          for (const h of results) {
            const last = groups[groups.length - 1];
            if (last && last.slug === h.text_slug) {
              last.hits.push(h);
            } else {
              groups.push({ slug: h.text_slug, title: h.text_title, hits: [h] });
            }
          }
          return groups.map((g) => (
            <li class="search-page__group">
              <h2 class="search-page__group-title">{g.title}</h2>
              <ol class="search-page__group-list">
                {g.hits.map((h) => (
                  <li class="search-page__item">
                    <a class="search-page__link" href={verseHref(h)}>
                      <div class="search-page__crumb">{`${h.chapter}.${h.verse_num}`}</div>
                      <div class="search-page__sa" lang="sa" data-sa data-sa-source={h.devanagari}>
                        {h.devanagari}
                      </div>
                      {h.iast ? (
                        <div class="search-page__iast" lang="sa-Latn">{h.iast}</div>
                      ) : null}
                      {h.translation_excerpt ? (
                        <p class="search-page__en">{h.translation_excerpt}</p>
                      ) : null}
                    </a>
                  </li>
                ))}
              </ol>
            </li>
          ));
        })()}
      </ol>
    )}

    {q && !stub && results.length >= limit ? (
      <footer class="search-page__pagination">
        <a
          class="search-page__more"
          href={`/search?q=${encodeURIComponent(q)}&limit=${limit + 50}`}
        >
          More results →
        </a>
      </footer>
    ) : null}
  </main>
</BaseLayout>

<style>
  .search-page {
    /*
     * Cap reader column at 64ch (audit-2026-06-01 recommendation #7) —
     * the shared --width-content (760px) reads ~75ch which is too long
     * for prose excerpts on desktop.
     */
    max-width: 64ch;
    margin-inline: auto;
    padding: var(--spacing-6) var(--spacing-4) var(--spacing-9);
  }
  .search-page__head {
    display: grid;
    gap: var(--spacing-2);
    padding-block-end: var(--spacing-5);
    border-block-end: 1px solid var(--color-rule);
    margin-block-end: var(--spacing-5);
  }
  .search-page__title {
    margin: 0;
    font-family: var(--font-iast);
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.3;
  }
  .search-page__q {
    font-style: italic;
    color: var(--color-accent);
  }
  .search-page__meta {
    margin: 0;
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted);
  }
  .search-page__empty,
  .search-page__stub,
  .search-page__none,
  .search-page__err {
    padding: var(--spacing-5);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 6px;
    font-family: var(--font-iast);
    font-size: var(--text-base);
    color: var(--color-ink);
    line-height: 1.6;
  }
  .search-page__err { border-color: var(--color-error); }
  .search-page__upcoming {
    margin: var(--spacing-3) 0 0;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  .search-page__upcoming a {
    color: var(--color-accent);
  }
  .search-page__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--spacing-6);
  }
  .search-page__group {
    display: grid;
    gap: var(--spacing-2);
  }
  .search-page__group-title {
    margin: 0;
    font-family: var(--font-iast);
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: 0;
    text-transform: none;
    padding-block-end: var(--spacing-2);
    border-block-end: 1px solid var(--color-rule);
  }
  .search-page__group-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .search-page__item {
    border-block-end: 1px solid var(--color-rule);
  }
  .search-page__group-list .search-page__item:last-child {
    border-block-end: 0;
  }
  .search-page__link {
    display: grid;
    gap: var(--spacing-2);
    padding-block: var(--spacing-4);
    color: inherit;
    text-decoration: none;
  }
  .search-page__link:hover {
    background: var(--color-surface);
  }
  .search-page__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }
  .search-page__crumb {
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted);
  }
  .search-page__sa {
    font-family: var(--font-sa-body);
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-ink);
    max-width: var(--width-reader);
  }
  .search-page__iast {
    font-family: var(--font-iast);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    max-width: var(--width-reader);
  }
  .search-page__en {
    margin: 0;
    font-family: var(--font-iast);
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--color-ink);
    max-width: var(--width-reader);
  }
  .search-page__pagination {
    padding-block-start: var(--spacing-5);
    display: flex;
    justify-content: center;
  }
  .search-page__more {
    font-family: var(--font-chrome);
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-decoration: none;
    padding: var(--spacing-2) var(--spacing-4);
    border: 1px solid var(--color-rule);
    border-radius: 4px;
  }
  .search-page__more:hover {
    border-color: var(--color-accent);
  }
</style>
