---
import Footer from '../../components/Footer.astro';
import Masthead from '../../components/Masthead.astro';
/**
 * /texts — the DB-driven text index, sectioned by tradition.
 *
 * Quiet table (NOT a card grid) per the homepage spec §3:
 *   "title, tradition tag, verse count, license, in a quiet table.
 *    Five rows at V1 launch is fine — sparseness reads as curation."
 *
 * Rows come from `listTexts()` (build-time SQLite read): commentaries
 * (non-null parent_text_id) are excluded and rows arrive tradition-grouped
 * (Trika first, then Śākta), alphabetical by English title within a group.
 * Links target the text OVERVIEW page (/{tradition}/{slug}), not verse 1.1.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type TextSummary, listTexts } from '../../lib/db';
import { buildChromeSeo, getChromeAvailableLangs } from '../../lib/seo';

/** Display labels for tradition section headings + the Tradition column. */
const TRADITION_LABELS: Record<string, string> = {
  trika: 'Trika',
  shakta: 'Śākta',
};

const texts = listTexts();

// Fold the pre-ordered rows into contiguous tradition sections; unknown
// traditions (already sorted last by listTexts) still get a section.
const sections: Array<{ tradition: string; label: string; texts: TextSummary[] }> = [];
for (const t of texts) {
  const last = sections[sections.length - 1];
  if (last && last.tradition === t.tradition) {
    last.texts.push(t);
  } else {
    sections.push({
      tradition: t.tradition,
      label: TRADITION_LABELS[t.tradition] ?? t.tradition,
      texts: [t],
    });
  }
}

const currentLang = 'en' as const;
const pageSeo = buildChromeSeo({
  availableLangs: getChromeAvailableLangs(),
  basePath: '/texts',
  description:
    'The full corpus of Tantric, Kashmir Shaiva, Trika, and Kaula texts available on sohamhamso.',
  lang: currentLang,
  title: 'All texts — sohamhamso',
});
---

<BaseLayout
  canonical={pageSeo.canonical}
  description={pageSeo.description}
  hreflang={pageSeo.hreflang}
  jsonLd={pageSeo.jsonLd}
  lang={currentLang}
  noindex={pageSeo.noindex}
  title={pageSeo.title}
>
  <Masthead currentLang="EN" />

  <main id="main" class="texts-page">
    <header class="texts-header">
      <p class="texts-eyebrow" data-i18n="texts.eyebrow">Corpus</p>
      <h1 class="texts-title" data-i18n="texts.title">All texts</h1>
      <p class="texts-lede">
        {texts.length} <span data-i18n={texts.length === 1 ? "texts.lede.prefix_text" : "texts.lede.prefix_texts"}>{texts.length === 1
          ? "text, grouped by tradition. Indic-language translations are AI-assisted and not yet human-verified — see"
          : "texts, grouped by tradition. Indic-language translations are AI-assisted and not yet human-verified — see"}</span> <a href="/about/methodology" data-i18n="texts.lede.methodology">methodology</a><span data-i18n="texts.lede.suffix">.</span>
      </p>
    </header>

    <hr class="shirorekha-rule" aria-hidden="true" />

    <div class="texts-table-wrap" role="region" aria-labelledby="texts-title">
      <table class="texts-table">
        <thead>
          <tr>
            <th scope="col" class="col-title" data-i18n="texts.table.text">Text</th>
            <th scope="col" class="col-tradition" data-i18n="texts.table.tradition">Tradition</th>
            <th scope="col" class="col-count" data-i18n="texts.table.verses">Verses</th>
            <th scope="col" class="col-license" data-i18n="texts.table.license">License</th>
          </tr>
        </thead>
        {sections.map((s) => (
          <tbody class="tradition-group">
            <tr class="tradition-heading-row">
              <th scope="rowgroup" colspan="4">{s.label}</th>
            </tr>
            {s.texts.map((t) => (
              <tr>
                <td class="col-title">
                  <a href={`/${t.tradition}/${t.slug}`} class="text-link">
                    <span class="text-title-en">{t.title_en}</span>
                    <span class="text-title-sa" lang="sa" data-sa>{t.title_sa}</span>
                    {t.author && <span class="text-author">{t.author}</span>}
                  </a>
                </td>
                <td class="col-tradition" data-label="Tradition">{s.label}</td>
                <td class="col-count" data-label="Verses">{t.verse_count.toLocaleString()}</td>
                <td class="col-license" data-label="License">{t.license}</td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .texts-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--spacing-7) var(--spacing-4) var(--spacing-9);
  }

  @media (min-width: 768px) {
    .texts-page {
      padding: var(--spacing-9) var(--spacing-6) var(--spacing-10);
    }
  }

  .texts-header {
    max-width: 62ch;
  }
  .texts-eyebrow {
    font-family: var(--font-chrome);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
    margin: 0 0 var(--spacing-3);
  }
  .texts-title {
    font-family: var(--font-iast);
    font-weight: 600;
    font-size: 36px;
    line-height: 1.15;
    color: var(--color-ink);
    margin: 0 0 var(--spacing-4);
  }
  @media (min-width: 768px) {
    .texts-title { font-size: 44px; }
  }
  .texts-lede {
    font-family: var(--font-iast);
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-ink-muted);
    margin: 0;
  }

  .texts-table-wrap {
    margin-top: var(--spacing-5);
  }

  .texts-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-iast);
    font-size: 15px;
  }

  .texts-table thead th {
    text-align: left;
    font-family: var(--font-chrome);
    font-weight: 500;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted);
    padding: var(--spacing-3) var(--spacing-3);
    border-bottom: 1px solid var(--color-rule);
    white-space: nowrap;
  }

  .texts-table tbody td {
    padding: var(--spacing-4) var(--spacing-3);
    border-bottom: 1px solid var(--color-rule);
    vertical-align: top;
    color: var(--color-ink);
    min-width: 0;
  }

  .texts-table tbody:last-child tr:last-child td {
    border-bottom: 0;
  }

  /* Tradition section heading row — same chrome voice as the thead. */
  .tradition-heading-row th {
    text-align: left;
    font-family: var(--font-chrome);
    font-weight: 500;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
    padding: var(--spacing-5) var(--spacing-3) var(--spacing-2);
    border-bottom: 1px solid var(--color-rule);
  }

  .col-title { width: 50%; }
  .col-tradition { width: 20%; color: var(--color-ink-muted); }
  .col-count {
    width: 12%;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-muted);
  }
  .col-license {
    width: 18%;
    color: var(--color-ink-muted);
    font-size: 13px;
    overflow-wrap: anywhere;
  }

  /*
   * Mobile (<640px): table overflows viewport on /texts (LICENSE column
   * cut mid-word — see audit-2026-06-01 recommendation #1). Reflow each
   * row into a stacked card, surfacing the column header inline via a
   * data-label attribute set in the markup. Desktop keeps the 4-column
   * table untouched.
   */
  @media (max-width: 639px) {
    .texts-table,
    .texts-table thead,
    .texts-table tbody,
    .texts-table tr,
    .texts-table td,
    .texts-table tbody th {
      display: block;
      width: auto;
    }
    .tradition-heading-row th {
      padding: var(--spacing-5) 0 var(--spacing-2);
    }
    .texts-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    .texts-table tbody tr {
      padding: var(--spacing-4) 0;
      border-bottom: 1px solid var(--color-rule);
    }
    .texts-table tbody tr.tradition-heading-row {
      padding: 0;
      border-bottom: 0; /* the th carries the rule */
    }
    .texts-table tbody:last-child tr:last-child {
      border-bottom: 0;
    }
    .texts-table tbody td {
      padding: 0;
      border: 0;
    }
    .texts-table tbody td.col-title {
      margin-bottom: var(--spacing-3);
    }
    .texts-table tbody td:not(.col-title) {
      display: grid;
      grid-template-columns: 5.5rem 1fr;
      gap: var(--spacing-2);
      padding-block: 2px;
      font-size: 13px;
    }
    .texts-table tbody td:not(.col-title)::before {
      content: attr(data-label);
      font-family: var(--font-chrome);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-ink-muted);
    }
  }

  .text-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--color-ink);
    text-decoration: none;
  }
  .text-link:hover .text-title-en {
    text-decoration-color: var(--color-ink-muted);
  }
  .text-title-en {
    font-weight: 600;
    font-size: 17px;
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 4px;
  }
  .text-title-sa {
    font-family: var(--font-sa-body);
    font-size: 15px;
    color: var(--color-ink-muted);
    line-height: 1.4;
  }
  .text-author {
    font-size: 13px;
    color: var(--color-ink-muted);
    font-style: italic;
  }
</style>
