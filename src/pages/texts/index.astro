---
import Footer from '../../components/Footer.astro';
import Masthead from '../../components/Masthead.astro';
/**
 * /texts — the flat alphabetical text index.
 *
 * Quiet table (NOT a card grid) per the homepage spec §3:
 *   "title, tradition tag, verse count, license, in a quiet table.
 *    Five rows at V1 launch is fine — sparseness reads as curation."
 *
 * V1: hardcoded against the Phase 1 corpus list from the plan.
 * TODO: replace with `getAllTexts()` from src/lib/db.ts once the
 * SQLite reader helper exists. The shape below matches the `texts`
 * table in db/schema.sql, so swapping is mechanical.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

type TextRow = {
  slug: string;
  title_sa: string;
  title_en: string;
  tradition: string;
  author: string | null;
  verse_count: number;
  license: string;
};

// TODO: const texts = getAllTexts(); from src/lib/db.ts
const texts: TextRow[] = [
  {
    slug: 'siva-sutras',
    title_sa: 'शिवसूत्राणि',
    title_en: 'Śiva Sūtras',
    tradition: 'Trika',
    author: 'Vasugupta',
    verse_count: 77,
    license: 'CC-BY-SA 4.0',
  },
  {
    slug: 'spanda-karikas',
    title_sa: 'स्पन्दकारिकाः',
    title_en: 'Spanda Kārikās',
    tradition: 'Trika',
    author: 'Vasugupta',
    verse_count: 52,
    license: 'CC-BY-SA 4.0',
  },
  {
    slug: 'pratyabhijna-hridayam',
    title_sa: 'प्रत्यभिज्ञाहृदयम्',
    title_en: 'Pratyabhijñā Hṛdayam',
    tradition: 'Pratyabhijñā',
    author: 'Kṣemarāja',
    verse_count: 20,
    license: 'CC-BY-SA 4.0',
  },
  {
    slug: 'vijnana-bhairava',
    title_sa: 'विज्ञानभैरवतन्त्रम्',
    title_en: 'Vijñāna Bhairava Tantra',
    tradition: 'Trika / Kaula',
    author: null,
    verse_count: 163,
    license: 'CC-BY-SA 4.0',
  },
  {
    slug: 'karpuradi-stotra',
    title_sa: 'कर्पूरादिस्तोत्रम्',
    title_en: 'Karpūrādi Stotra',
    tradition: 'Kaula',
    author: null,
    verse_count: 22,
    license: 'Public Domain (Woodroffe 1922)',
  },
];

// Sort alphabetical by English title — flat list, no faceting.
const sorted = [...texts].sort((a, b) => a.title_en.localeCompare(b.title_en));
---

<BaseLayout
  title="All texts — sohamhamso"
  description="The full corpus of Tantric, Kashmir Shaiva, Trika, and Kaula texts available on sohamhamso."
>
  <Masthead currentLang="EN" />

  <main id="main" class="texts-page">
    <header class="texts-header">
      <p class="texts-eyebrow">Corpus</p>
      <h1 class="texts-title">All texts</h1>
      <p class="texts-lede">
        {sorted.length} {sorted.length === 1 ? "text" : "texts"}, flat
        alphabetical. Translations in eleven Indic languages are AI-assisted
        and not yet human-verified — see <a href="/about/methodology">methodology</a>.
      </p>
    </header>

    <hr class="shirorekha-rule" aria-hidden="true" />

    <div class="texts-table-wrap" role="region" aria-labelledby="texts-title">
      <table class="texts-table">
        <thead>
          <tr>
            <th scope="col" class="col-title">Text</th>
            <th scope="col" class="col-tradition">Tradition</th>
            <th scope="col" class="col-count">Verses</th>
            <th scope="col" class="col-license">License</th>
          </tr>
        </thead>
        <tbody>
          {sorted.map((t) => (
            <tr>
              <td class="col-title">
                <a href={`/trika/${t.slug}/1/1`} class="text-link">
                  <span class="text-title-en">{t.title_en}</span>
                  <span class="text-title-sa" lang="sa" data-sa>{t.title_sa}</span>
                  {t.author && <span class="text-author">{t.author}</span>}
                </a>
              </td>
              <td class="col-tradition">{t.tradition}</td>
              <td class="col-count">{t.verse_count.toLocaleString()}</td>
              <td class="col-license">{t.license}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .texts-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--spacing-7) var(--spacing-4) var(--spacing-9);
  }

  @media (min-width: 768px) {
    .texts-page {
      padding: var(--spacing-9) var(--spacing-6) var(--spacing-10);
    }
  }

  .texts-header {
    max-width: 62ch;
  }
  .texts-eyebrow {
    font-family: var(--font-chrome);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
    margin: 0 0 var(--spacing-3);
  }
  .texts-title {
    font-family: var(--font-iast);
    font-weight: 600;
    font-size: 36px;
    line-height: 1.15;
    color: var(--color-ink);
    margin: 0 0 var(--spacing-4);
  }
  @media (min-width: 768px) {
    .texts-title { font-size: 44px; }
  }
  .texts-lede {
    font-family: var(--font-iast);
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-ink-muted);
    margin: 0;
  }

  .texts-table-wrap {
    overflow-x: auto;
    margin-top: var(--spacing-5);
  }

  .texts-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-iast);
    font-size: 15px;
  }

  .texts-table thead th {
    text-align: left;
    font-family: var(--font-chrome);
    font-weight: 500;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted);
    padding: var(--spacing-3) var(--spacing-3);
    border-bottom: 1px solid var(--color-rule);
    white-space: nowrap;
  }

  .texts-table tbody td {
    padding: var(--spacing-4) var(--spacing-3);
    border-bottom: 1px solid var(--color-rule);
    vertical-align: top;
    color: var(--color-ink);
  }

  .texts-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .col-title { width: 50%; }
  .col-tradition { width: 20%; color: var(--color-ink-muted); }
  .col-count {
    width: 12%;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-muted);
  }
  .col-license { width: 18%; color: var(--color-ink-muted); font-size: 13px; }

  .text-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--color-ink);
    text-decoration: none;
  }
  .text-link:hover .text-title-en {
    text-decoration-color: var(--color-ink-muted);
  }
  .text-title-en {
    font-weight: 600;
    font-size: 17px;
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 4px;
  }
  .text-title-sa {
    font-family: var(--font-sa-body);
    font-size: 15px;
    color: var(--color-ink-muted);
    line-height: 1.4;
  }
  .text-author {
    font-size: 13px;
    color: var(--color-ink-muted);
    font-style: italic;
  }
</style>
