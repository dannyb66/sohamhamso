---
import Footer from '../../components/Footer.astro';
import Masthead from '../../components/Masthead.astro';
import PrivacyArticle from '../../components/PrivacyArticle.astro';
/**
 * /about/privacy — minimum-collection privacy statement.
 *
 * The site is a static reader. The only personal data the project handles
 * is opt-in: email addresses for the daily-verse subscription, and Google
 * Analytics for visitors who allow it. The prose lives in
 * `components/PrivacyArticle.astro`, shared with the localized route. It is
 * plain prose, not a legal document, meant to be readable in two minutes.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildChromeSeo, getChromeAvailableLangs } from '../../lib/seo';

const currentLang = 'en' as const;
const pageSeo = buildChromeSeo({
  availableLangs: getChromeAvailableLangs(),
  basePath: '/about/privacy',
  description: 'What sohamhamso collects (almost nothing) and why.',
  lang: currentLang,
  title: 'Privacy — sohamhamso',
});
---

<BaseLayout
  canonical={pageSeo.canonical}
  description={pageSeo.description}
  hreflang={pageSeo.hreflang}
  jsonLd={pageSeo.jsonLd}
  lang={currentLang}
  noindex={pageSeo.noindex}
  title={pageSeo.title}
>
  <Masthead currentLang="EN" />

  <PrivacyArticle lang={currentLang} />

  <Footer />
</BaseLayout>
