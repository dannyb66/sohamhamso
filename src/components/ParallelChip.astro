---
/**
 * ParallelChip — discloses the set of parallel verses linked to this verse.
 *
 * Spec: when `parallels.length > 0`, show a pill "📜 parallels (N)". Tap
 * opens a small inline disclosure listing each target (text title,
 * chapter.verse, IAST preview clipped to ~80 chars, link to that verse).
 *
 * V1 simplification: inline `<details>` disclosure (matches the
 * AIAssistedBadge pattern). Card stack on mobile / popover on desktop
 * is the V1.1 polish — kept inline here so the component works without
 * JS and stays consistent with other chip disclosures on the verse page.
 *
 * Hidden when count = 0. Currently the parallels table is empty in the
 * V1 corpus, so the chip won't render on any page yet. An e2e test
 * asserts the count=0 hide rule.
 */
import type { Parallel } from "../lib/db";

interface Props {
  parallels: Parallel[];
}

const { parallels } = Astro.props;

// Hide entirely when there are no parallels — chip is meaningless at 0.
const visible = parallels.length > 0;

// Stable id pairs the <details> with its label so multiple chips on a
// page (unlikely but possible) don't collide.
const id = `parallels-${Math.random().toString(36).slice(2, 9)}`;

// Trim IAST previews so each list item stays single-line.
function preview(iast: string | null | undefined): string {
  if (!iast) return "";
  return iast.length > 80 ? `${iast.slice(0, 80)}…` : iast;
}

// Build the target href: parallels join in the tradition? No — the
// `parallels` rows expose only target_text_slug. The verse-page route
// is `/{tradition}/{text}/{chapter}/{verse}` so we'd need the target
// text's tradition. For V1 (empty parallels table) the chip is unused;
// we link via the search route as a graceful fallback that always works.
function targetHref(p: Parallel): string {
  if (!p.target_text_slug || p.target_chapter == null || p.target_verse_num == null) {
    return "/search";
  }
  // The reader resolves /<text-slug>/<chapter>/<verse>? No — routes are
  // tradition-namespaced. Use the search route which knows how to resolve
  // text-slug + chapter + verse to the canonical URL.
  return `/search?q=${encodeURIComponent(`${p.target_text_slug} ${p.target_chapter}.${p.target_verse_num}`)}`;
}
---

{visible ? (
  <details class="parallels-chip" aria-label={`${parallels.length} parallels`}>
    <summary id={id} class="parallels-chip__summary">
      <span class="parallels-chip__icon" aria-hidden="true">📜</span>
      <span class="parallels-chip__label">parallels ({parallels.length})</span>
    </summary>
    <div class="parallels-chip__body" role="region" aria-labelledby={id}>
      <ul class="parallels-chip__list">
        {parallels.map((p) => (
          <li class="parallels-chip__item">
            <a class="parallels-chip__link" href={targetHref(p)}>
              <span class="parallels-chip__title">
                {p.target_text_title ?? p.target_text_slug ?? "Parallel verse"}
              </span>
              {p.target_chapter != null && p.target_verse_num != null ? (
                <span class="parallels-chip__locator">
                  · {p.target_chapter}.{p.target_verse_num}
                </span>
              ) : null}
            </a>
            {p.target_iast ? (
              <div class="parallels-chip__iast" lang="sa-Latn">
                {preview(p.target_iast)}
              </div>
            ) : null}
            {p.confidence != null ? (
              <div class="parallels-chip__meta">
                confidence {Math.round((p.confidence ?? 0) * 100)}%
                {p.citation_type ? ` · ${p.citation_type}` : ""}
              </div>
            ) : null}
          </li>
        ))}
      </ul>
    </div>
  </details>
) : null}

<style>
  .parallels-chip {
    display: inline-block;
    font-family: var(--font-chrome);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
  }

  .parallels-chip__summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid #CBD5E1;
    background: #F1F5F9;
    color: #1E293B;
    cursor: pointer;
    list-style: none;
    user-select: none;
    min-height: 24px;
    position: relative;
  }
  .parallels-chip__summary::-webkit-details-marker { display: none; }
  /* 44px invisible tap target */
  .parallels-chip__summary::before {
    content: "";
    position: absolute;
    inset: -10px -8px;
    min-height: 44px;
    min-width: 44px;
  }

  .parallels-chip__icon {
    font-size: 11px;
  }

  .parallels-chip[open] > .parallels-chip__body {
    display: block;
  }
  .parallels-chip__body {
    display: none;
    margin-top: var(--spacing-2);
    padding: var(--spacing-3);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    max-width: 420px;
    color: var(--color-ink);
  }

  .parallels-chip__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--spacing-3);
  }
  .parallels-chip__item {
    padding-block-end: var(--spacing-2);
    border-block-end: 1px solid var(--color-rule);
  }
  .parallels-chip__item:last-child {
    border-block-end: 0;
    padding-block-end: 0;
  }

  .parallels-chip__link {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    text-decoration: none;
    color: var(--color-ink);
    font-family: var(--font-chrome);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .parallels-chip__link:hover {
    text-decoration: underline;
  }
  .parallels-chip__locator {
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .parallels-chip__iast {
    margin-top: 4px;
    font-family: var(--font-iast);
    font-style: italic;
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--color-ink);
  }
  .parallels-chip__meta {
    margin-top: 2px;
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  :root[data-theme="dark"] .parallels-chip__summary,
  :root[data-theme="oled"] .parallels-chip__summary {
    background: #1F2937;
    border-color: #475569;
    color: #CBD5E1;
  }
</style>
