---
/**
 * VerseAnatomy — Vedabase-pattern verse anatomy block.
 *
 * Top-to-bottom anatomy (mobile + desktop, single column):
 *   1. Verse-number rail (sticky left on desktop, inline above on mobile)
 *   2. Devanāgarī verse (large, Noto Serif Devanagari, line-height 1.75, lang="sa")
 *   3. IAST transliteration (muted serif italic)
 *   4. Synonyms — dash-joined Vedabase pattern: `tasya — of that; eva — only; ...`
 *      Each Sanskrit lemma is a <button data-word-idx data-verse-id> for the
 *      WordSheet Solid island to attach handlers via event delegation.
 *   5. Translation (single paragraph, max 65ch)
 *   6. Footer chips slot (AI badges, parallels chip, manuscript link)
 *
 * No purport / commentary layer — locked by design spec.
 *
 * Sanskrit-bearing elements carry `data-sa` so the ScriptSwitcher island
 * can re-render them via Sanscript.t() without a page reload.
 */
import type { Translation, Verse, WordGloss } from '../lib/db';
import { formatDanda, isProseSection, splitProseParagraphs } from '../lib/prose';

interface Props {
  verse: Verse;
  wordGlosses?: WordGloss[];
  translations?: Translation[];
}

const { verse, wordGlosses = [], translations = [] } = Astro.props;

const verseLabel =
  verse.chapter && verse.verse_num
    ? `${verse.chapter}.${verse.verse_num}`
    : String(verse.verse_num);

// Pick the primary translation (first one in the list — db.ts orders
// `ai_assisted ASC, created_at ASC` so PD/human translations land first).
const primaryTranslation = translations[0] ?? null;

// Render mode (plan A4): section_type='prose' BYPASSES formatDanda — a
// running commentary sentence must NOT be shredded into per-danda lines.
// Prose flows as body-scale paragraphs; the verse path below is unchanged.
// formatDanda itself lives in src/lib/prose.ts (moved verbatim) so the
// danda-split vs prose-bypass contract is unit-testable.
const isProse = isProseSection(verse.section_type);
const mode = isProse ? 'prose' : 'verse';

// Verse mode: break on the half-verse danda (Devanāgarī ।, ॥; IAST |, ||).
// Paired with `white-space: pre-line` in CSS below.
const devanagariFormatted = isProse ? '' : formatDanda(verse.devanagari);
const iastFormatted = isProse ? '' : formatDanda(verse.iast);

// Prose mode: flowing paragraphs — blank-line breaks only, never dandas.
const devanagariParas = isProse ? splitProseParagraphs(verse.devanagari) : [];
const iastParas = isProse ? splitProseParagraphs(verse.iast) : [];
// ScriptSwitcher re-renders [data-sa] nodes from data-sa-source; pair each
// IAST paragraph with its Devanāgarī source only when the counts line up.
const iastParasPairable = iastParas.length === devanagariParas.length;
---

<article class="verse-anatomy" data-verse-id={verse.id} data-section-type={mode}>
  <header class="verse-header">
    <!--
      aria-label interpolates the verse locator (`Verse 1.1` — `Block 1.1`
      for prose, see `verse.block_aria_prefix`). We swap
      only the static word "Verse" via the prefix key + a hidden i18n
      bearer attribute on the span; the label-with-locator stays in the
      aria-label so screen readers always hear a locator. (Phase B can
      teach I18nSwap to template the verse number into the aria-label.)
    -->
    <span class="verse-number" aria-label={`${isProse ? 'Block' : 'Verse'} ${verseLabel}`}>
      {verseLabel}
    </span>
  </header>
  <div class="verse-chips">
    <slot name="chips" />
  </div>

  {isProse ? (
    <div class="prose-devanagari" lang="sa">
      {devanagariParas.map((p) => (
        <p>{p}</p>
      ))}
    </div>
  ) : (
    <div class="verse-devanagari" lang="sa">
      {devanagariFormatted}
    </div>
  )}

  {verse.iast ? (
    isProse ? (
      <details class="prose-iast">
        <summary data-i18n="verse.prose_iast_summary">Transliteration (IAST)</summary>
        <div class="prose-iast__body" lang="sa-Latn">
          {iastParas.map((p, i) => (
            <p
              data-sa={iastParasPairable ? '' : undefined}
              data-sa-source={iastParasPairable ? devanagariParas[i] : undefined}
            >{p}</p>
          ))}
        </div>
      </details>
    ) : (
      <div
        class="verse-iast"
        lang="sa-Latn"
        data-sa
        data-sa-source={devanagariFormatted}
      >{iastFormatted}</div>
    )
  ) : null}

  {verse.meter ? (
    <div class="verse-meter" aria-label="meter" data-i18n-attr-aria-label="verse.meter_aria">{verse.meter}</div>
  ) : null}

  {wordGlosses.length > 0 ? (
    <section class="synonyms" aria-label="word-by-word synonyms" data-i18n-attr-aria-label="verse.synonyms_aria">
      {wordGlosses.map((g, i) => (
        <>
          <button
            id={`word-${g.word_idx}`}
            type="button"
            class="sa-word"
            data-word-idx={g.word_idx}
            data-verse-id={verse.id}
            data-sa
            data-sa-source={g.word_sa}
            lang="sa"
            aria-label={`Look up: ${g.lemma_iast || g.word_sa}`}
          >
            <em>{g.lemma_iast || g.word_sa}</em>
          </button>
          <span class="sa-gloss"> — {g.gloss_text}</span>
          {i < wordGlosses.length - 1 ? (
            <span class="sa-sep">; </span>
          ) : null}
        </>
      ))}
    </section>
  ) : null}

  {primaryTranslation ? (
    isProse ? (
      <div class="translation translation-prose" lang={primaryTranslation.lang}>
        {splitProseParagraphs(primaryTranslation.translation_text).map((p) => (
          <p>{p}</p>
        ))}
      </div>
    ) : (
      <p class="translation" lang={primaryTranslation.lang}>
        {primaryTranslation.translation_text}
      </p>
    )
  ) : null}

  {translations.length > 1 ? (
    <section class="alt-translations" aria-label="additional translations" data-i18n-attr-aria-label="verse.alt_translations_aria">
      {translations.slice(1).map((t) =>
        isProse ? (
          <div class="translation translation-alt translation-prose" lang={t.lang}>
            {splitProseParagraphs(t.translation_text).map((p) => (
              <p>{p}</p>
            ))}
          </div>
        ) : (
          <p class="translation translation-alt" lang={t.lang}>
            {t.translation_text}
          </p>
        ),
      )}
    </section>
  ) : null}

  <footer class="verse-footer">
    <slot name="footer" />
  </footer>
</article>

<style>
  .verse-anatomy {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-4);
    padding-block: var(--spacing-6);
    border-block-end: 1px solid var(--color-rule);
  }

  /* Desktop: sticky-left verse-number rail */
  @media (min-width: 1024px) {
    .verse-anatomy {
      grid-template-columns: 48px 1fr;
      column-gap: var(--spacing-4);
    }
    .verse-header {
      grid-column: 1 / 2;
      flex-direction: column;
      align-items: flex-start;
      position: sticky;
      top: 64px;
      align-self: flex-start;
    }
    .verse-devanagari,
    .prose-devanagari,
    .verse-iast,
    .prose-iast,
    .verse-meter,
    .verse-chips,
    .synonyms,
    .translation,
    .alt-translations,
    .verse-footer {
      grid-column: 2 / 3;
    }
  }

  .verse-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    flex-wrap: wrap;
  }

  .verse-number {
    font-family: var(--font-chrome);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
    font-feature-settings: "smcp" 1, "c2sc" 1;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .verse-chips {
    display: flex;
    gap: var(--spacing-2);
    flex-wrap: wrap;
  }

  .verse-devanagari {
    font-family: var(--font-sa-body);
    font-size: var(--text-lg); /* 22px mobile */
    font-weight: 500;
    line-height: 1.75;
    color: var(--color-ink);
    max-width: var(--width-reader);
    /* Preserve danda line breaks injected by formatDanda(). Each pāda-pair on its own line. */
    white-space: pre-line;
  }
  @media (min-width: 1024px) {
    .verse-devanagari {
      font-size: 1.625rem; /* 26px desktop */
    }
  }

  .verse-iast {
    font-family: var(--font-iast);
    font-style: italic;
    font-size: var(--text-base);
    color: var(--color-ink-muted);
    line-height: 1.5;
    max-width: var(--width-reader);
    /* Match the Devanāgarī line-break behaviour. */
    white-space: pre-line;
  }
  @media (min-width: 1024px) {
    .verse-iast {
      font-size: 1.0625rem; /* 17px */
    }
  }

  .verse-meter {
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .synonyms {
    font-family: var(--font-iast);
    font-size: 0.9375rem; /* 15px */
    /* Density matches the Vedabase reference. The line-height drives row
       height — buttons are not inline-block-with-padding, so they don't
       inflate the line-box. Tap targets are handled by a .sa-word::before
       overlay (see below) which is position:absolute and OUT OF FLOW.

       The overlay must NOT be taller than the line-box, or a wrapped word
       on the next visual line would have its hit-area extend up over the
       previous line's word and intercept its clicks (Playwright refuses to
       click through an intercepting element; real fingers near the line
       boundary would also mis-target). So row height and overlay extent are
       coupled: ~26px rows (15px × 1.75) leave ~11px of leading, split into
       a ~5px overlay extension on each side of the ~15px glyph box. */
    line-height: 1.75;
    color: var(--color-ink-muted);
    max-width: var(--width-reader);
  }

  .sa-word {
    /* Override the global 44px touch-target floor — these are inline.
       Tap surface is created by the ::before pseudo-element below. */
    min-height: 0;
    min-width: 0;
    appearance: none;
    background: transparent;
    border: 0;
    /* No padding-block — the button's visible box is just its text height
       (~15px). The hit area is created by ::before below (absolute,
       out-of-flow). This preserves the dense Vedabase-style line rhythm
       while still passing WCAG 2.5.5 AAA tap-target floor. */
    padding: 0 2px;
    margin: 0;
    position: relative;
    cursor: pointer;
    font-family: var(--font-iast);
    font-size: 0.9375rem;
    color: var(--color-ink);
    text-decoration: underline dotted var(--color-rule);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--motion-fast) var(--easing-out);
  }
  .sa-word em {
    font-style: italic;
  }
  /* Invisible hit-area overlay extends the tappable region above and below
     the visible glyph box. CRITICAL: the extension is capped at ~5px each
     side so the overlay stays INSIDE the line-box leading (line-height 1.75
     ⇒ ~26px row, ~15px glyph ⇒ ~5.5px leading per side). This guarantees a
     wrapped word's overlay never reaches over an adjacent line's word, so
     clicks are never intercepted. On the dense desktop layout this yields a
     ~25px tap target (mouse pointer — WCAG 2.5.8 AA 24px is met).
     Coarse-pointer (touch) devices get a true 44px target below. */
  .sa-word::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -5px;
    bottom: -5px;
  }
  /* Touch devices: open the rows up to a full 44px rhythm and size the
     overlay to fill the line-box exactly (≈ -14px each side). This restores
     the WCAG 2.5.5 AAA 44px tap floor for fingers while STILL keeping each
     word's hit-area within its own line — no adjacent-line interception. The
     density cost (taller rows) lands only where it buys real ergonomic value;
     desktop/mouse keeps the tight Vedabase rhythm. */
  @media (pointer: coarse) {
    .synonyms {
      line-height: 2.95; /* ~44px rows at 15px */
    }
    .sa-word::before {
      top: -14px;
      bottom: -14px;
    }
  }
  .sa-word:hover,
  .sa-word:focus-visible {
    text-decoration-color: var(--color-accent);
  }

  .sa-gloss {
    color: var(--color-ink-muted);
  }

  .sa-sep {
    color: var(--color-ink-muted);
  }

  .translation {
    font-family: var(--font-iast);
    font-size: var(--text-md); /* 18px */
    line-height: 1.6;
    color: var(--color-ink);
    max-width: var(--width-reader);
    margin: 0;
  }
  @media (min-width: 1024px) {
    .translation {
      font-size: 1.1875rem; /* 19px */
    }
  }

  .translation-alt {
    color: var(--color-ink-muted);
    border-inline-start: 2px solid var(--color-rule);
    padding-inline-start: var(--spacing-3);
  }

  .alt-translations {
    display: grid;
    gap: var(--spacing-3);
  }

  .verse-footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-3);
    align-items: center;
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
  .verse-footer:empty {
    display: none;
  }

  /* ── Prose blocks (section_type='prose') ────────────────────────────
     Flowing paragraphs at BODY scale (~18-19px Devanāgarī) — never the
     26px verse display, never `white-space: pre-line`. Paragraph breaks
     come from splitProseParagraphs (blank lines), not dandas. */
  .prose-devanagari {
    font-family: var(--font-sa-body);
    font-size: var(--text-md); /* 18px */
    line-height: 1.9;
    color: var(--color-ink);
    max-width: var(--width-reader);
  }
  @media (min-width: 1024px) {
    .prose-devanagari {
      font-size: 1.1875rem; /* 19px — body scale, not the 26px verse display */
    }
  }
  .prose-devanagari p {
    margin: 0;
    white-space: normal;
  }
  .prose-devanagari p + p {
    margin-block-start: var(--spacing-3);
  }

  /* Collapsible IAST for prose — collapsed by default (no `open`). */
  .prose-iast {
    max-width: var(--width-reader);
  }
  .prose-iast summary {
    cursor: pointer;
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-block: var(--spacing-2);
  }
  .prose-iast summary:hover,
  .prose-iast summary:focus-visible {
    color: var(--color-ink);
  }
  .prose-iast__body {
    font-family: var(--font-iast);
    font-style: italic;
    font-size: var(--text-base);
    color: var(--color-ink-muted);
    line-height: 1.6;
  }
  .prose-iast__body p {
    margin: 0;
    white-space: normal;
  }
  .prose-iast__body p + p {
    margin-block-start: var(--spacing-3);
  }

  /* Multi-paragraph prose translations (\n\n in the source). */
  .translation-prose p {
    margin: 0;
  }
  .translation-prose p + p {
    margin-block-start: var(--spacing-3);
  }
</style>
