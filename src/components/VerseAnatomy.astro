---
/**
 * VerseAnatomy — Vedabase-pattern verse anatomy block.
 *
 * Top-to-bottom anatomy (mobile + desktop, single column):
 *   1. Verse-number rail (sticky left on desktop, inline above on mobile)
 *   2. Devanāgarī verse (large, Noto Serif Devanagari, line-height 1.75, lang="sa")
 *   3. IAST transliteration (muted serif italic)
 *   4. Synonyms — dash-joined Vedabase pattern: `tasya — of that; eva — only; ...`
 *      Each Sanskrit lemma is a <button data-word-idx data-verse-id> for the
 *      WordSheet Solid island to attach handlers via event delegation.
 *   5. Translation (single paragraph, max 65ch)
 *   6. Footer chips slot (AI badges, parallels chip, manuscript link)
 *
 * No purport / commentary layer — locked by design spec.
 *
 * Sanskrit-bearing elements carry `data-sa` so the ScriptSwitcher island
 * can re-render them via Sanscript.t() without a page reload.
 */
import type { Translation, Verse, WordGloss } from '../lib/db';

interface Props {
  verse: Verse;
  wordGlosses?: WordGloss[];
  translations?: Translation[];
}

const { verse, wordGlosses = [], translations = [] } = Astro.props;

const verseLabel =
  verse.chapter && verse.verse_num
    ? `${verse.chapter}.${verse.verse_num}`
    : String(verse.verse_num);

// Pick the primary translation (first one in the list — db.ts orders
// `ai_assisted ASC, created_at ASC` so PD/human translations land first).
const primaryTranslation = translations[0] ?? null;

// Break Sanskrit verses on the half-verse danda (Devanāgarī ।, ॥; IAST | , || ).
// Vedabase / SuttaCentral convention: each pāda-pair on its own line.
// The verse-number bracket ॥N॥ / ||N|| stays attached to its preceding pāda
// (it marks the end of the verse). Paired with `white-space: pre-line` in
// CSS below.
function formatDanda(s: string | null | undefined): string {
  if (!s) return '';
  // Protect verse-number brackets so the internal dandas don't get split.
  // Devanāgarī forms: ॥४९॥, ॥ ४९ ॥. IAST forms: ||49||, || 49 ||.
  const protected_: string[] = [];
  let work = s
    .replace(/॥\s*([\d०-९]+)\s*॥/g, (_m, n) => {
      protected_.push(`॥${n}॥`);
      return `${protected_.length - 1}`;
    })
    .replace(/\|\|\s*(\d+)\s*\|\|/g, (_m, n) => {
      protected_.push(`||${n}||`);
      return `${protected_.length - 1}`;
    });

  work = work
    // Newline after Devanāgarī dandas
    .replace(/॥/g, '॥\n')
    .replace(/।/g, '।\n')
    // Newline after IAST dandas — || before single |
    .replace(/\|\|/g, '||\n')
    .replace(/(^|[^|])\|(?!\|)/g, '$1|\n');

  // Restore the protected verse-number brackets
  work = work.replace(/(\d+)/g, (_m, i) => protected_[Number(i)]);

  // Collapse multiple newlines + trim
  return work
    .replace(/[ \t]*\n[ \t]*/g, '\n')
    .replace(/\n+/g, '\n')
    .trim();
}

const devanagariFormatted = formatDanda(verse.devanagari);
const iastFormatted = formatDanda(verse.iast);
---

<article class="verse-anatomy" data-verse-id={verse.id}>
  <header class="verse-header">
    <!--
      aria-label interpolates the verse locator (`Verse 1.1`). We swap
      only the static word "Verse" via the prefix key + a hidden i18n
      bearer attribute on the span; the label-with-locator stays in the
      aria-label so screen readers always hear a locator. (Phase B can
      teach I18nSwap to template the verse number into the aria-label.)
    -->
    <span class="verse-number" aria-label={`Verse ${verseLabel}`}>
      {verseLabel}
    </span>
  </header>
  <div class="verse-chips">
    <slot name="chips" />
  </div>

  <div class="verse-devanagari" lang="sa">
    {devanagariFormatted}
  </div>

  {verse.iast ? (
    <div
      class="verse-iast"
      lang="sa-Latn"
      data-sa
      data-sa-source={devanagariFormatted}
    >{iastFormatted}</div>
  ) : null}

  {verse.meter ? (
    <div class="verse-meter" aria-label="meter" data-i18n-attr-aria-label="verse.meter_aria">{verse.meter}</div>
  ) : null}

  {wordGlosses.length > 0 ? (
    <section class="synonyms" aria-label="word-by-word synonyms" data-i18n-attr-aria-label="verse.synonyms_aria">
      {wordGlosses.map((g, i) => (
        <>
          <button
            type="button"
            class="sa-word"
            data-word-idx={g.word_idx}
            data-verse-id={verse.id}
            data-sa
            data-sa-source={g.word_sa}
            lang="sa"
            aria-label={`Look up: ${g.lemma_iast || g.word_sa}`}
          >
            <em>{g.lemma_iast || g.word_sa}</em>
          </button>
          <span class="sa-gloss"> — {g.gloss_text}</span>
          {i < wordGlosses.length - 1 ? (
            <span class="sa-sep">; </span>
          ) : null}
        </>
      ))}
    </section>
  ) : null}

  {primaryTranslation ? (
    <p class="translation" lang={primaryTranslation.lang}>
      {primaryTranslation.translation_text}
    </p>
  ) : null}

  {translations.length > 1 ? (
    <section class="alt-translations" aria-label="additional translations" data-i18n-attr-aria-label="verse.alt_translations_aria">
      {translations.slice(1).map((t) => (
        <p class="translation translation-alt" lang={t.lang}>
          {t.translation_text}
        </p>
      ))}
    </section>
  ) : null}

  <footer class="verse-footer">
    <slot name="footer" />
  </footer>
</article>

<style>
  .verse-anatomy {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-4);
    padding-block: var(--spacing-6);
    border-block-end: 1px solid var(--color-rule);
  }

  /* Desktop: sticky-left verse-number rail */
  @media (min-width: 1024px) {
    .verse-anatomy {
      grid-template-columns: 48px 1fr;
      column-gap: var(--spacing-4);
    }
    .verse-header {
      grid-column: 1 / 2;
      flex-direction: column;
      align-items: flex-start;
      position: sticky;
      top: 64px;
      align-self: flex-start;
    }
    .verse-devanagari,
    .verse-iast,
    .verse-meter,
    .verse-chips,
    .synonyms,
    .translation,
    .alt-translations,
    .verse-footer {
      grid-column: 2 / 3;
    }
  }

  .verse-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    flex-wrap: wrap;
  }

  .verse-number {
    font-family: var(--font-chrome);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
    font-feature-settings: "smcp" 1, "c2sc" 1;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .verse-chips {
    display: flex;
    gap: var(--spacing-2);
    flex-wrap: wrap;
  }

  .verse-devanagari {
    font-family: var(--font-sa-body);
    font-size: var(--text-lg); /* 22px mobile */
    font-weight: 500;
    line-height: 1.75;
    color: var(--color-ink);
    max-width: var(--width-reader);
    /* Preserve danda line breaks injected by formatDanda(). Each pāda-pair on its own line. */
    white-space: pre-line;
  }
  @media (min-width: 1024px) {
    .verse-devanagari {
      font-size: 1.625rem; /* 26px desktop */
    }
  }

  .verse-iast {
    font-family: var(--font-iast);
    font-style: italic;
    font-size: var(--text-base);
    color: var(--color-ink-muted);
    line-height: 1.5;
    max-width: var(--width-reader);
    /* Match the Devanāgarī line-break behaviour. */
    white-space: pre-line;
  }
  @media (min-width: 1024px) {
    .verse-iast {
      font-size: 1.0625rem; /* 17px */
    }
  }

  .verse-meter {
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .synonyms {
    font-family: var(--font-iast);
    font-size: 0.9375rem; /* 15px */
    /* Bleed-style tap-target expansion: combined with .sa-word's vertical
       padding (14px top + 14px bottom + ~15px glyph) the effective tap
       surface on each inline lemma reaches the 44px WCAG 2.5.5 (AAA) floor
       without breaking inline flow. Line-height absorbs the padding so the
       visual rhythm is preserved (rows don't double-space). */
    line-height: 2.0;
    color: var(--color-ink-muted);
    max-width: var(--width-reader);
  }

  .sa-word {
    /* Override the global 44px touch-target floor — these are inline.
       Tap surface reaches 44px via padding-block bleed (see .synonyms). */
    min-height: 0;
    min-width: 0;
    appearance: none;
    background: transparent;
    border: 0;
    /* padding-block bleeds the tap surface to ~44px tall; horizontal padding
       keeps the dotted underline tight to the glyph. */
    padding: 14px 2px;
    margin: 0;
    cursor: pointer;
    font-family: var(--font-iast);
    font-size: 0.9375rem;
    color: var(--color-ink);
    text-decoration: underline dotted var(--color-rule);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--motion-fast) var(--easing-out);
  }
  .sa-word em {
    font-style: italic;
  }
  .sa-word:hover,
  .sa-word:focus-visible {
    text-decoration-color: var(--color-accent);
  }

  .sa-gloss {
    color: var(--color-ink-muted);
  }

  .sa-sep {
    color: var(--color-ink-muted);
  }

  .translation {
    font-family: var(--font-iast);
    font-size: var(--text-md); /* 18px */
    line-height: 1.6;
    color: var(--color-ink);
    max-width: var(--width-reader);
    margin: 0;
  }
  @media (min-width: 1024px) {
    .translation {
      font-size: 1.1875rem; /* 19px */
    }
  }

  .translation-alt {
    color: var(--color-ink-muted);
    border-inline-start: 2px solid var(--color-rule);
    padding-inline-start: var(--spacing-3);
  }

  .alt-translations {
    display: grid;
    gap: var(--spacing-3);
  }

  .verse-footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-3);
    align-items: center;
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
  .verse-footer:empty {
    display: none;
  }
</style>
