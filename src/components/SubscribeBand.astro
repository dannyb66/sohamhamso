---
/**
 * SubscribeBand — inline daily-verse subscribe.
 * Never a modal. Full-width band above the footer.
 * Single line on desktop, stacked on mobile.
 *
 * Posts to /api/subscribe. V1 endpoint acknowledges only; the daily-
 * verse curator workstream wires the actual Resend send + double-opt-in
 * + subscribers-DB write for V1.x.
 *
 * Language availability tracks the SUBSCRIBE API's allowlist, not the
 * READER corpus — they're different dimensions. The reader has all 12
 * languages live, but the daily-verse send pipeline (Resend + region
 * pinning + double opt-in) ships English-only at V1.0. Source of truth
 * for the active set is src/lib/subscribe-langs.ts; both this picker
 * and the API import from there so they cannot drift.
 */
import { ACTIVE_LANGUAGES } from '../lib/subscribe-langs';

const LANG_CATALOGUE: Array<{ code: string; label: string }> = [
  { code: 'en', label: 'English' },
  { code: 'hi', label: 'Hindi' },
  { code: 'ta', label: 'Tamil' },
  { code: 'te', label: 'Telugu' },
  { code: 'bn', label: 'Bengali' },
  { code: 'mr', label: 'Marathi' },
  { code: 'gu', label: 'Gujarati' },
  { code: 'kn', label: 'Kannada' },
  { code: 'ml', label: 'Malayalam' },
  { code: 'pa', label: 'Punjabi' },
  { code: 'or', label: 'Odia' },
  { code: 'as', label: 'Assamese' },
];

const languages = LANG_CATALOGUE.map((l) => ({
  ...l,
  available: ACTIVE_LANGUAGES.has(l.code),
}));
---

<section class="subscribe" aria-labelledby="subscribe-heading">
  <div class="subscribe-inner">
    <div class="subscribe-copy">
      <h2 class="subscribe-heading" id="subscribe-heading">Receive a verse at dawn.</h2>
      <p class="subscribe-sub">One verse, one translation. No commentary. Unsubscribe anytime.</p>
    </div>

    <form
      class="subscribe-form"
      action="/api/subscribe"
      method="POST"
      data-subscribe-form
      novalidate
    >
      <label class="visually-hidden" for="subscribe-email">Email address</label>
      <input
        type="email"
        id="subscribe-email"
        name="email"
        placeholder="your email"
        required
        autocomplete="email"
      />

      <div class="subscribe-lang">
        <label class="subscribe-lang-label" for="subscribe-lang">language:</label>
        <select id="subscribe-lang" name="language">
          {languages.map((l) => (
            <option
              value={l.code}
              disabled={!l.available}
              title={l.available ? "" : "Coming soon — see methodology"}
            >
              {l.label}{!l.available ? " (soon)" : ""}
            </option>
          ))}
        </select>
      </div>

      <button type="submit" class="subscribe-button">subscribe</button>
    </form>

    <p class="subscribe-status" data-subscribe-status hidden aria-live="polite"></p>
  </div>
</section>

<script>
  // Progressive enhancement: submit via fetch and show inline status.
  // Falls back to a full-page POST if JS is off (the endpoint returns
  // a JSON ack either way — the no-JS case will render plain JSON,
  // which is honest about the V1 stub state).
  (() => {
    const form = document.querySelector<HTMLFormElement>("[data-subscribe-form]");
    const status = document.querySelector<HTMLParagraphElement>("[data-subscribe-status]");
    if (!form || !status) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
      const language = (form.elements.namedItem("language") as HTMLSelectElement).value;

      status.hidden = false;
      status.textContent = "Subscribing…";
      status.dataset.state = "pending";

      try {
        const res = await fetch("/api/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Accept": "application/json" },
          body: JSON.stringify({ email, language }),
        });
        const data = await res.json();
        if (res.ok && data.ok) {
          status.textContent = data.message || "Check your inbox to confirm — link expires in 24h.";
          status.dataset.state = "success";
          form.reset();
        } else {
          status.textContent = data.message || "Couldn't subscribe. Try again or email us.";
          status.dataset.state = "error";
        }
      } catch {
        status.textContent = "Couldn't subscribe. Try again or email us.";
        status.dataset.state = "error";
      }
    });
  })();
</script>

<style>
  .subscribe {
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-surface);
  }

  .subscribe-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--spacing-7) var(--spacing-4);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    align-items: stretch;
  }

  @media (min-width: 900px) {
    .subscribe-inner {
      flex-direction: row;
      align-items: center;
      gap: var(--spacing-6);
      padding: var(--spacing-6) var(--spacing-6);
    }
    .subscribe-copy {
      flex: 1;
    }
  }

  .subscribe-heading {
    font-family: var(--font-iast);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.3;
    color: var(--color-ink);
    margin: 0 0 var(--spacing-1);
  }

  .subscribe-sub {
    font-family: var(--font-iast);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-ink-muted);
    margin: 0;
  }

  .subscribe-form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-3);
  }

  .subscribe-form input[type="email"] {
    flex: 1 1 240px;
    min-width: 0;
    font-family: var(--font-iast);
    font-size: 16px;
    padding: 10px 12px;
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    background: var(--color-bg);
    color: var(--color-ink);
  }
  .subscribe-form input[type="email"]:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .subscribe-lang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-chrome);
    font-size: 13px;
    color: var(--color-ink-muted);
  }

  .subscribe-lang select {
    font-family: var(--font-chrome);
    font-size: 14px;
    color: var(--color-ink);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-rule);
    padding: 4px 2px;
    cursor: pointer;
  }
  .subscribe-lang select:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Text button, NOT solid pill — per anti-pattern list */
  .subscribe-button {
    font-family: var(--font-iast);
    font-size: 16px;
    color: var(--color-ink);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-ink);
    padding: 6px 4px;
    cursor: pointer;
    letter-spacing: 0.01em;
    transition: color var(--motion-fast) var(--easing-out);
  }
  .subscribe-button:hover {
    color: var(--color-ink-muted);
    border-bottom-color: var(--color-ink-muted);
  }

  .subscribe-status {
    font-family: var(--font-iast);
    font-size: 14px;
    margin: 0;
    color: var(--color-ink-muted);
  }
  .subscribe-status[data-state="success"] { color: var(--color-success); }
  .subscribe-status[data-state="error"]   { color: var(--color-error); }

  .visually-hidden {
    position: absolute !important;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
