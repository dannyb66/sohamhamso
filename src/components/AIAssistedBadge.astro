---
/**
 * AIAssistedBadge — translation provenance footnote.
 *
 * Always inline-visible per design anti-pattern: never hide AI-disclosure
 * behind a tooltip. Three states from the locked state matrix:
 *
 *   - ai_assisted=true,  status='published' → "AI · not verified"
 *   - ai_assisted=true,  status='reviewed'  → "AI · reviewed by {reviewer}"
 *   - ai_assisted=false                     → "{translator} · {year} · PD"
 *
 * Visual: T&C-style muted footnote — tiny, low-contrast italic text, no
 * pill background or coloured chrome. The three variants share one
 * unobtrusive style; the provenance distinction surfaces in the
 * disclosure body on tap. Variant classes (.ai-badge--slate|amber|emerald)
 * stay on the root so future targeted tweaks remain possible.
 *
 * Tap target ≥44px (per a11y baseline) via an invisible ::before overlay.
 * Tap opens an inline disclosure with full provenance.
 */
import { type BadgeStatus, computeBadgeState } from '../lib/ai-badge-state';

interface Props {
  aiAssisted: boolean;
  status: BadgeStatus;
  translator?: string | null;
  year?: number | string | null;
  model?: string | null;
  modelVersion?: string | null;
  promptVersion?: string | null;
  reviewerName?: string | null;
  generatedAt?: string | null;
}

const {
  aiAssisted,
  status,
  translator,
  year,
  model,
  modelVersion,
  promptVersion,
  reviewerName,
  generatedAt,
} = Astro.props;

// State → variant + label resolved via the pure helper (unit-tested in
// tests/unit/ai-assisted-badge.test.ts). Keep this component a thin
// renderer so the matrix has a single source of truth.
const { variant, label, icon } = computeBadgeState({
  aiAssisted,
  status,
  translator,
  year,
  reviewerName,
});

// Only the pure-static labels carry a data-i18n key — the composed
// forms ("AI · reviewed by {name}" and "{translator} · {year} · PD")
// stitch dynamic substrings and stay un-swapped for V1. Phase B can
// extend computeBadgeState() to return key + interpolation slots.
const labelI18nKey =
  label === 'AI · not verified' ? 'badge.ai.not_verified'
  : label === 'AI · reviewed' ? 'badge.ai.reviewed'
  : label === 'Public domain' ? 'badge.public_domain'
  : null;

// Stable id pairs the <details> with its label so multiple badges on a
// page don't collide.
const id = `aibadge-${Math.random().toString(36).slice(2, 9)}`;
---

<details class={`ai-badge ai-badge--${variant}`} aria-label={label}>
  <summary id={id} class="ai-badge-summary">
    <span class="ai-badge-icon" aria-hidden="true">{icon}</span>
    {labelI18nKey ? (
      <span class="ai-badge-label" data-i18n={labelI18nKey}>{label}</span>
    ) : (
      <span class="ai-badge-label">{label}</span>
    )}
  </summary>
  <div class="ai-badge-body" role="region" aria-labelledby={id}>
    <dl class="ai-badge-dl">
      {translator ? (
        <>
          <dt data-i18n="badge.dl.translator">Translator</dt>
          <dd>{translator}</dd>
        </>
      ) : null}
      {model ? (
        <>
          <dt data-i18n="badge.dl.model">Model</dt>
          <dd>{model}{modelVersion ? ` (${modelVersion})` : ""}</dd>
        </>
      ) : null}
      {promptVersion ? (
        <>
          <dt data-i18n="badge.dl.prompt">Prompt</dt>
          <dd>{promptVersion}</dd>
        </>
      ) : null}
      {reviewerName ? (
        <>
          <dt data-i18n="badge.dl.reviewer">Reviewer</dt>
          <dd>{reviewerName}</dd>
        </>
      ) : null}
      {generatedAt ? (
        <>
          <dt data-i18n="badge.dl.generated">Generated</dt>
          <dd>{generatedAt}</dd>
        </>
      ) : null}
      <dt data-i18n="badge.dl.status">Status</dt>
      <dd>{status}</dd>
    </dl>
    <p class="ai-badge-meta">
      <a href="/about/methodology" data-i18n="badge.how_we_translate">How we translate →</a>
    </p>
  </div>
</details>

<style>
  /* T&C-style muted footnote. One unobtrusive style across all three
     variants — provenance distinction surfaces via the disclosure body
     on tap, not visual chrome. */
  .ai-badge {
    display: inline-block;
    font-family: var(--font-chrome);
    font-size: 11px;
    font-weight: 400;
    line-height: 1;
    /* Drop opacity slightly so it recedes vs body text. */
    opacity: 0.75;
  }

  .ai-badge-summary {
    /* Flat footnote — no pill, no background, no border. */
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 0;
    border: 0;
    background: transparent;
    color: var(--color-ink-muted);
    cursor: pointer;
    list-style: none;
    user-select: none;
    font-style: italic;
    letter-spacing: 0.04em;
    /* Single line — never wrap into a vertical blob. */
    white-space: nowrap;
    max-width: 100%;
    /* Expand hit area via ::before overlay */
    position: relative;
  }
  .ai-badge-summary:hover,
  .ai-badge-summary:focus-visible {
    color: var(--color-ink);
    text-decoration: underline dotted var(--color-rule);
    text-underline-offset: 3px;
  }
  .ai-badge-label {
    /* If a translator string runs long, truncate with ellipsis rather than
       wrapping into multiple lines. Full label is still readable via the
       disclosure body + aria-label on the <details>. */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: min(48ch, 70vw);
  }
  .ai-badge-summary::-webkit-details-marker { display: none; }
  .ai-badge-summary::before {
    /* Invisible 44px tap target overlay — preserves a11y baseline
       without inflating the visual footnote. */
    content: "";
    position: absolute;
    inset: -10px -8px;
    min-height: 44px;
    min-width: 44px;
  }

  .ai-badge-icon {
    /* De-emphasised provenance glyph; the disclosure body carries the
       authoritative breakdown. */
    font-style: normal;
    font-weight: 500;
    font-size: 9px;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }

  /* Variants: all render identically as muted footnote. Variant classes
     remain on the <details> root so future targeted tweaks stay cheap. */

  /* Disclosure body — full provenance reveal. Keeps full contrast so
     the data the footnote hides is legible when surfaced. */
  .ai-badge[open] > .ai-badge-body {
    display: block;
  }
  .ai-badge[open] {
    opacity: 1;
  }
  .ai-badge-body {
    display: none;
    margin-top: var(--spacing-2);
    padding: var(--spacing-3);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    font-size: var(--text-sm);
    color: var(--color-ink);
    max-width: 360px;
  }

  .ai-badge-dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 4px var(--spacing-3);
    margin: 0 0 var(--spacing-2) 0;
  }
  .ai-badge-dl dt {
    font-weight: 500;
    color: var(--color-ink-muted);
    font-family: var(--font-chrome);
  }
  .ai-badge-dl dd {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-chrome);
  }

  .ai-badge-meta {
    margin: 0;
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
  }
</style>
