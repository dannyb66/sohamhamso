---
/**
 * AIAssistedBadge — translation provenance pill.
 *
 * Always inline-visible per design anti-pattern: never hide AI-disclosure
 * behind a tooltip. Three states from the locked state matrix:
 *
 *   - ai_assisted=true,  status='published' → amber  "AI · not verified"
 *   - ai_assisted=true,  status='reviewed'  → emerald "AI · reviewed by {reviewer}"
 *   - ai_assisted=false                     → slate  "{translator} · {year} · PD"
 *
 * Tap target ≥44px (per a11y baseline). Tap opens a simple inline
 * disclosure with full provenance — V1 stub; the bottom-sheet
 * implementation lands in V1.1 (WordSheet pattern can be lifted).
 */
interface Props {
  aiAssisted: boolean;
  status: "draft" | "reviewed" | "published";
  translator?: string | null;
  year?: number | string | null;
  model?: string | null;
  modelVersion?: string | null;
  promptVersion?: string | null;
  reviewerName?: string | null;
  generatedAt?: string | null;
}

const {
  aiAssisted,
  status,
  translator,
  year,
  model,
  modelVersion,
  promptVersion,
  reviewerName,
  generatedAt,
} = Astro.props;

// Resolve state → variant + label
type Variant = "amber" | "emerald" | "slate";
let variant: Variant;
let label: string;
let icon: string;

if (aiAssisted && status === "reviewed") {
  variant = "emerald";
  label = reviewerName ? `AI · reviewed by ${reviewerName}` : "AI · reviewed";
  icon = "✓";
} else if (aiAssisted) {
  // covers status='published' (and falls back for 'draft' if ever surfaced)
  variant = "amber";
  label = "AI · not verified";
  icon = "AI";
} else {
  variant = "slate";
  const parts = [translator || "Public domain"];
  if (year) parts.push(String(year));
  parts.push("PD");
  label = parts.join(" · ");
  icon = "PD";
}

// Stable id pairs the <details> with its label so multiple badges on a
// page don't collide.
const id = `aibadge-${Math.random().toString(36).slice(2, 9)}`;
---

<details class={`ai-badge ai-badge--${variant}`} aria-label={label}>
  <summary id={id} class="ai-badge-summary">
    <span class="ai-badge-icon" aria-hidden="true">{icon}</span>
    <span class="ai-badge-label">{label}</span>
  </summary>
  <div class="ai-badge-body" role="region" aria-labelledby={id}>
    <dl class="ai-badge-dl">
      {translator ? (
        <>
          <dt>Translator</dt>
          <dd>{translator}</dd>
        </>
      ) : null}
      {model ? (
        <>
          <dt>Model</dt>
          <dd>{model}{modelVersion ? ` (${modelVersion})` : ""}</dd>
        </>
      ) : null}
      {promptVersion ? (
        <>
          <dt>Prompt</dt>
          <dd>{promptVersion}</dd>
        </>
      ) : null}
      {reviewerName ? (
        <>
          <dt>Reviewer</dt>
          <dd>{reviewerName}</dd>
        </>
      ) : null}
      {generatedAt ? (
        <>
          <dt>Generated</dt>
          <dd>{generatedAt}</dd>
        </>
      ) : null}
      <dt>Status</dt>
      <dd>{status}</dd>
    </dl>
    <p class="ai-badge-meta">
      <a href="/methodology">How we translate →</a>
    </p>
  </div>
</details>

<style>
  .ai-badge {
    display: inline-block;
    font-family: var(--font-chrome);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
  }

  .ai-badge-summary {
    /* Pill shape. 44px touch target via padding + display-block fallback. */
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid transparent;
    cursor: pointer;
    list-style: none;
    user-select: none;
    min-height: 24px;
    /* Expand hit area without visually inflating the pill */
    position: relative;
  }
  .ai-badge-summary::-webkit-details-marker { display: none; }
  .ai-badge-summary::before {
    /* Invisible 44px tap target overlay */
    content: "";
    position: absolute;
    inset: -10px -8px;
    min-height: 44px;
    min-width: 44px;
  }

  .ai-badge-icon {
    font-weight: 600;
    font-size: 9px;
    letter-spacing: 0.06em;
  }

  /* Variants */
  .ai-badge--amber > .ai-badge-summary {
    background: #FEF3C7; /* amber-50/100 */
    border-color: #FCD34D; /* amber-300 */
    color: #78350F;
  }
  .ai-badge--emerald > .ai-badge-summary {
    background: #ECFDF5;
    border-color: #6EE7B7;
    color: #064E3B;
  }
  .ai-badge--slate > .ai-badge-summary {
    background: #F1F5F9;
    border-color: #CBD5E1;
    color: #1E293B;
  }

  /* Disclosure body */
  .ai-badge[open] > .ai-badge-body {
    display: block;
  }
  .ai-badge-body {
    display: none;
    margin-top: var(--spacing-2);
    padding: var(--spacing-3);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    font-size: var(--text-sm);
    color: var(--color-ink);
    max-width: 360px;
  }

  .ai-badge-dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 4px var(--spacing-3);
    margin: 0 0 var(--spacing-2) 0;
  }
  .ai-badge-dl dt {
    font-weight: 500;
    color: var(--color-ink-muted);
    font-family: var(--font-chrome);
  }
  .ai-badge-dl dd {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-chrome);
  }

  .ai-badge-meta {
    margin: 0;
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
  }

  /* Dark theme */
  :root[data-theme="dark"] .ai-badge--amber > .ai-badge-summary,
  :root[data-theme="oled"] .ai-badge--amber > .ai-badge-summary {
    background: #3F2A0A;
    border-color: #B45309;
    color: #FCD34D;
  }
  :root[data-theme="dark"] .ai-badge--emerald > .ai-badge-summary,
  :root[data-theme="oled"] .ai-badge--emerald > .ai-badge-summary {
    background: #0F3B2A;
    border-color: #047857;
    color: #6EE7B7;
  }
  :root[data-theme="dark"] .ai-badge--slate > .ai-badge-summary,
  :root[data-theme="oled"] .ai-badge--slate > .ai-badge-summary {
    background: #1F2937;
    border-color: #475569;
    color: #CBD5E1;
  }
</style>
