---
import { getAvailableLanguages } from '../lib/db';
import { READING_MODES } from '../lib/reading-modes';
/**
 * Masthead — top chrome. Wordmark left · search icon middle/right ·
 * language picker right. Hairline border-bottom (var(--color-rule)).
 * Persistent across pages.
 *
 * The search trigger is intercepted by the global SearchBox Solid island
 * (mounted in BaseLayout); this component just renders the button. The
 * language picker uses the unified READING_MODES catalogue (see
 * src/lib/reading-modes.ts) so the entries + behavior match the
 * verse-page ScriptSwitcher and the SettingsSheet. Picking a row writes
 * BOTH sohamhamso:script + sohamhamso:reader-lang and dispatches
 * sohamhamso:reader-lang-change — the same contract every other picker
 * obeys. Availability is sourced from the corpus DB at build time:
 * langs with at least one published/reviewed translation render
 * available; the rest get the greyed `soon` tag.
 */
import Wordmark from './Wordmark.astro';

interface Props {
  currentLang?: string;
}
const { currentLang = 'EN' } = Astro.props;

// Build-time intersection: catalogue rows × DB-reported coverage.
// DB codes are lowercase ISO; catalogue display codes match.
const availableSet = getAvailableLanguages();

const languages = READING_MODES.map((m) => ({
  code: m.langCode.toUpperCase(),
  langCode: m.langCode,
  label: m.englishName === m.nativeLabel ? m.englishName : `${m.nativeLabel} (${m.englishName})`,
  available: availableSet.has(m.langCode),
}));
---

<header class="masthead" role="banner">
  <div class="masthead-inner">
    <Wordmark size="sm" showDevanagari={true} />

    <nav class="masthead-actions" aria-label="Site">
      <button
        type="button"
        class="icon-button"
        aria-label="Search verses, words, or concepts"
        data-i18n-attr-aria-label="masthead.search.aria"
        data-search-trigger
      >
        <!-- minimal magnifier glyph — no Lucide / icon set, per anti-pattern list -->
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5" />
          <line x1="13.5" y1="13.5" x2="17" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>

      <div class="lang-picker">
        <button
          type="button"
          class="lang-trigger"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-label="Reading language"
          data-i18n-attr-aria-label="masthead.lang.aria"
          data-lang-trigger
        >
          <span lang="sa" data-sa class="lang-glyph">अ</span>
          <span class="lang-current" data-lang-current>{currentLang}</span>
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
            <path d="M2 4 L5 7 L8 4" stroke="currentColor" stroke-width="1.25" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <ul class="lang-menu" role="listbox" hidden data-lang-menu>
          {languages.map((l) => (
            <li
              role="option"
              aria-selected={l.code === currentLang}
              aria-disabled={!l.available}
              data-available={l.available}
              data-lang-code={l.langCode}
              data-lang-display={l.code}
              title={l.available ? "" : "Translation coming soon — see methodology"}
              data-i18n-attr-title={l.available ? undefined : "masthead.lang.soon_title"}
            >
              <span class="lang-code">{l.code}</span>
              <span class="lang-label">{l.label}</span>
              {!l.available && <span class="lang-soon" data-i18n="masthead.lang.soon">soon</span>}
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>
</header>

<script>
  // Wire the language menu to the unified reading-mode contract:
  //   - Pick = write BOTH localStorage keys + dispatch reader-lang-change.
  //   - The [data-search-trigger] button is intercepted by the SearchBox
  //     Solid island (mounted globally in BaseLayout) and ⌘K is handled
  //     by the same island in capture phase, so we don't bind either here.
  import { applyReadingMode } from '../lib/reading-modes';

  (() => {
    const langTrigger = document.querySelector<HTMLButtonElement>("[data-lang-trigger]");
    const langMenu = document.querySelector<HTMLUListElement>("[data-lang-menu]");
    const langCurrent = document.querySelector<HTMLSpanElement>("[data-lang-current]");
    if (!langTrigger || !langMenu) return;

    const closeMenu = () => {
      langMenu.setAttribute("hidden", "");
      langTrigger.setAttribute("aria-expanded", "false");
    };
    const openMenu = () => {
      langMenu.removeAttribute("hidden");
      langTrigger.setAttribute("aria-expanded", "true");
    };

    langTrigger.addEventListener("click", (e) => {
      e.stopPropagation();
      if (langMenu.hasAttribute("hidden")) openMenu();
      else closeMenu();
    });

    document.addEventListener("click", (e) => {
      if (
        !langMenu.hasAttribute("hidden") &&
        !langMenu.contains(e.target as Node) &&
        e.target !== langTrigger
      ) {
        closeMenu();
      }
    });

    // Delegate row clicks. Skip disabled ("soon") rows.
    langMenu.addEventListener("click", (e) => {
      const li = (e.target as HTMLElement | null)?.closest<HTMLLIElement>("li[data-lang-code]");
      if (!li) return;
      if (li.getAttribute("aria-disabled") === "true") return;
      const lang = li.dataset.langCode;
      const display = li.dataset.langDisplay;
      if (!lang) return;
      applyReadingMode(lang);
      // Update the trigger label in-place so the user sees the pick land.
      if (langCurrent && display) langCurrent.textContent = display;
      // Mark the chosen row aria-selected; clear the others.
      for (const row of langMenu.querySelectorAll<HTMLLIElement>("li[role='option']")) {
        row.setAttribute("aria-selected", row === li ? "true" : "false");
      }
      closeMenu();
    });

    // Restore the trigger label from any prior pick so the chrome reflects
    // the persisted reading mode across pages.
    try {
      const saved = localStorage.getItem("sohamhamso:reader-lang");
      if (saved && langCurrent) {
        const row = langMenu.querySelector<HTMLLIElement>(`li[data-lang-code="${saved}"]`);
        const display = row?.dataset.langDisplay;
        if (display) {
          langCurrent.textContent = display;
          for (const r of langMenu.querySelectorAll<HTMLLIElement>("li[role='option']")) {
            r.setAttribute("aria-selected", r === row ? "true" : "false");
          }
        }
      }
    } catch {
      /* localStorage unavailable */
    }
  })();
</script>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-rule);
    backdrop-filter: none; /* no glassmorphism, per anti-pattern list */
  }

  .masthead-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-4);
    height: 56px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--spacing-4);
  }

  @media (min-width: 768px) {
    .masthead-inner {
      height: 64px;
      padding: 0 var(--spacing-6);
    }
  }

  .masthead-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
  }

  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 4px;
    color: var(--color-ink);
    cursor: pointer;
    transition: background var(--motion-fast) var(--easing-out);
  }
  .icon-button:hover { background: var(--color-rule); }

  .lang-picker { position: relative; }

  .lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 10px;
    background: transparent;
    border: 0;
    border-radius: 4px;
    color: var(--color-ink);
    font-family: var(--font-chrome);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.005em;
    cursor: pointer;
    transition: background var(--motion-fast) var(--easing-out);
  }
  .lang-trigger:hover { background: var(--color-rule); }

  .lang-glyph {
    font-family: var(--font-sa-body);
    font-size: 16px;
    line-height: 1;
    color: var(--color-ink-muted);
  }

  .lang-current {
    font-variant-numeric: tabular-nums;
  }

  .lang-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 4px);
    margin: 0;
    padding: var(--spacing-2) 0;
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    min-width: 240px;
    max-height: 360px;
    overflow-y: auto;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    font-family: var(--font-chrome);
    font-size: 14px;
  }

  .lang-menu li {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    padding: 8px var(--spacing-4);
    cursor: pointer;
  }
  .lang-menu li[aria-disabled="true"] {
    color: var(--color-ink-muted);
    cursor: not-allowed;
  }
  .lang-menu li[aria-selected="true"] {
    background: var(--color-rule);
  }
  .lang-menu li[data-available="true"]:hover {
    background: var(--color-rule);
  }

  .lang-code {
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    min-width: 28px;
  }
  .lang-label { flex: 1; }
  .lang-soon {
    font-size: 11px;
    color: var(--color-ink-muted);
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }

</style>
