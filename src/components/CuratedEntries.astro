---
/**
 * CuratedEntries — three quiet entry points modeled on SuttaCentral's
 * "Discourses · Monastic law · Abhidhamma" pattern, NOT a SaaS card grid.
 *
 * Vertical on mobile, three columns on desktop. Generous whitespace.
 * Each entry is a text block: title (Source Serif SemiBold) + 1-line
 * description in muted ink.
 *
 * V1: text-count is hardcoded. Once getTextCount() exists in src/lib/db.ts
 * (planned for the content-loading workstream), wire it via:
 *   import { getTextCount } from "../lib/db";
 *   const textCount = getTextCount();
 *
 * Props:
 *   centered — opt-in desktop layout that clusters the three entries
 *     under a centered focal element (e.g. the homepage hero) instead of
 *     the default `space-between` posture. Mobile is unaffected.
 */

interface Props {
  centered?: boolean;
}

const { centered = false } = Astro.props;

// Per design audit recommendation #19: dropping the live "(N)" count
// from the "All texts" link. Pluralizing the count in the label leaked
// the smallness of the V1 corpus ("All texts (5)" reads as "we have 5
// things" before the visitor has even clicked through). "All texts →"
// is cleaner and stays honest as the corpus grows.
const entries = [
  {
    titleKey: 'curated.if_new.title',
    title: 'If you are new',
    href: '/trika/siva-sutras/1/1',
    descriptionKey: 'curated.if_new.description',
    description: 'Begin with the Śiva Sūtras — 77 aphorisms.',
  },
  {
    titleKey: 'curated.daily.title',
    title: 'Daily readings',
    href: '/daily',
    descriptionKey: 'curated.daily.description',
    description: 'A verse at dawn in your inbox.',
  },
  {
    titleKey: 'curated.all_texts.title',
    title: 'All texts',
    href: '/texts',
    descriptionKey: 'curated.all_texts.description',
    description: 'Browse the full corpus.',
  },
] as const;
---

<section class="curated" aria-label="Where to begin" data-i18n-attr-aria-label="curated.aria">
  <ul class="curated-list" data-centered={centered ? '' : undefined}>
    {entries.map((entry) => (
      <li class="curated-item">
        <a href={entry.href} class="curated-link">
          <span class="curated-title">
            <span data-i18n={entry.titleKey}>{entry.title}</span>
          </span>
          <span class="curated-description" data-i18n={entry.descriptionKey}>{entry.description}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .curated {
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--spacing-7) var(--spacing-4);
  }

  @media (min-width: 768px) {
    .curated {
      padding: var(--spacing-8) var(--spacing-6);
    }
  }

  .curated-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
  }

  @media (min-width: 768px) {
    .curated-list {
      flex-direction: row;
      gap: var(--spacing-7);
      justify-content: space-between;
    }
    .curated-item {
      flex: 1;
    }

    /*
     * centered={true} — opt-in alignment for pages where the curated row
     * is a follow-on to a centered focal element (e.g. the homepage hero
     * at max-width 62ch). Clusters the three entries under the hero
     * instead of spanning the full 1080px container. Mobile (single-
     * column stack) is unaffected.
     */
    .curated-list[data-centered] {
      justify-content: center;
      gap: var(--spacing-8);
    }
    .curated-list[data-centered] .curated-item {
      flex: 0 1 220px;
    }
  }

  .curated-link {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    text-decoration: none;
    color: var(--color-ink);
    padding: var(--spacing-2) 0;
    transition: opacity var(--motion-fast) var(--easing-out);
  }
  .curated-link:hover {
    opacity: 0.7;
    text-decoration: none;
  }
  .curated-link:hover .curated-title {
    text-decoration-color: var(--color-ink-muted);
  }

  .curated-title {
    font-family: var(--font-iast);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.3;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 6px;
  }

  @media (min-width: 768px) {
    .curated-title {
      font-size: 24px;
    }
  }

  .curated-description {
    font-family: var(--font-iast);
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }
</style>
