{
  "name": "sohamhamso",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "The Tantric canon, read in eleven tongues. Modern mobile-first reader for Kashmir Shaivism / Trika / Kaula scriptures.",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
    "start": "bun --bun astro dev",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "ingest": "bun pipeline/ingest/ingest.ts",
    "db:init": "bun pipeline/ingest/init-db.ts"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "@astrojs/solid-js": "^5.0.0",
    "solid-js": "^1.9.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@indic-transliteration/sanscript": "^1.3.0",
    "js-yaml": "^4.1.0",
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/better-sqlite3": "^7.6.11",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "@playwright/test": "^1.48.0",
    "@biomejs/biome": "^1.9.0"
  }
}
