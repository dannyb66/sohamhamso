# sohamhamso — environment variables
# Copy to `.env` for local dev; in production these are set as Cloudflare
# Pages secrets (NEVER commit real values).

# ────────────────────────────────────────────────────────────────────────
# Subscriber email pepper — HMAC-SHA256 key.
#
# Local dev: leave unset (or set to anything you want) — the API falls
# back to a baked-in dev pepper and logs a one-time warning.
#
# Production: MUST be a 32+ char random string. The API HARD ERRORS at
# the edge if this is missing or equal to the dev fallback, so the
# operator sees the misconfiguration immediately rather than silently
# shipping with a publicly-known pepper (which would let an attacker
# enumerate subscriber emails from a post-breach hash dump).
#
# Generate with: `openssl rand -base64 48`
# Set with:
#   wrangler pages secret put SUBSCRIBER_HASH_PEPPER --project sohamhamso
# ────────────────────────────────────────────────────────────────────────
SUBSCRIBER_HASH_PEPPER=

# ────────────────────────────────────────────────────────────────────────
# Turso PII DB — subscribers table at the edge.
#
# Local dev: leave unset — the subscribe endpoint detects bun runtime
# and uses local `db/sohamhamso.db` (bun:sqlite) instead.
#
# Production: BOTH must be set as Cloudflare Pages secrets. The
# subscribe handler dynamically routes to `@libsql/client/web` when
# running in workerd, talking to the Turso PII DB over HTTPS.
#
# Schema bootstrap: the first request on a cold-start worker instance
# runs an idempotent `CREATE TABLE IF NOT EXISTS subscribers (...)`
# against the Turso DB, so a freshly-provisioned DB self-heals on
# first traffic. If you'd rather seed it ahead of time (cleaner first
# request, one fewer round trip), run the subscribers DDL from
# `db/schema.sql` manually via `turso db shell` once.
#
# Provision the DB:
#   turso db create sohamhamso-pii
#   turso db show --url sohamhamso-pii        # → TURSO_PII_URL
#   turso db tokens create sohamhamso-pii     # → TURSO_PII_AUTH_TOKEN
#
# Set the Cloudflare Pages secrets:
#   wrangler pages secret put TURSO_PII_URL --project sohamhamso
#   wrangler pages secret put TURSO_PII_AUTH_TOKEN --project sohamhamso
# ────────────────────────────────────────────────────────────────────────
TURSO_PII_URL=libsql://your-pii-db.turso.io
TURSO_PII_AUTH_TOKEN=

# ────────────────────────────────────────────────────────────────────────
# Turso CORPUS DB — read-only verse/translation/embedding store at the edge.
#
# Local dev: leave unset — `GET /api/search` and all corpus reads detect
# bun runtime and use the local `db/sohamhamso.db` file (bun:sqlite).
#
# Production: BOTH must be set as Cloudflare Pages secrets. The search
# endpoint (and any future edge-runtime read path that reaches into
# `src/lib/corpus-db.ts`) dynamically routes to `@libsql/client/web`
# when running in workerd, talking to the Turso CORPUS DB over HTTPS.
#
# WHY A SEPARATE DB FROM TURSO_PII_URL:
#   The PII DB stores subscribers (writes from /api/subscribe). The
#   CORPUS DB is read-only — verses, translations, word_glosses,
#   verse_embeddings. Splitting keeps PII rows out of the read-only
#   corpus surface area and lets us scale / back up each independently.
#   At launch you MAY point both env-var pairs at the same Turso DB
#   if you'd rather start with one — the schemas don't conflict.
#
# Provision the DB and seed it from the local SQLite file:
#   turso db create sohamhamso-corpus
#   turso db show --url sohamhamso-corpus      # → TURSO_CORPUS_URL
#   turso db tokens create sohamhamso-corpus   # → TURSO_CORPUS_AUTH_TOKEN
#   # then dump the local corpus into Turso (one-time seed):
#   #   sqlite3 db/sohamhamso.db .dump | turso db shell sohamhamso-corpus
#
# Set the Cloudflare Pages secrets:
#   wrangler pages secret put TURSO_CORPUS_URL --project sohamhamso
#   wrangler pages secret put TURSO_CORPUS_AUTH_TOKEN --project sohamhamso
# ────────────────────────────────────────────────────────────────────────
TURSO_CORPUS_URL=libsql://your-corpus-db.turso.io
TURSO_CORPUS_AUTH_TOKEN=

# ────────────────────────────────────────────────────────────────────────
# Optional — corpus DB path override (local dev / tests only).
# Defaults to `<repo>/db/sohamhamso.db`.
# ────────────────────────────────────────────────────────────────────────
# SOHAMHAMSO_DB_PATH=
